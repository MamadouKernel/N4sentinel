@using N4Sentinel.Web.Securite
@inject IHttpContextAccessor Accesseur
<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="N4Sentinel.Web.styles.css" />
    <HeadOutlet />
</head>

@* Le thème est appliqué côté serveur, au rendu : la page arrive déjà dans la bonne
   couleur, sans le clignotement d'un basculement fait après coup en JavaScript. *@
<body class="@ClasseDeTheme">
    <Routes />

    @* Bandeau de reconnexion du circuit Blazor : le script du cadriciel l'affiche
       lui-même quand la liaison est perdue. *@
    <div id="components-reconnect-modal" class="reconnexion">
        Liaison interrompue avec le serveur. Tentative de reconnexion…
    </div>

    <script src="_framework/blazor.web.js"></script>
    <script src="js/interface.js"></script>
</body>

</html>

@code {
    /// <summary>
    /// Thème retenu, lu dans un cookie. Le sombre est le défaut — c'est celui de la maquette
    /// validée, et celui d'un écran de supervision consulté en salle technique.
    /// </summary>
    private string? ClasseDeTheme =>
        Accesseur.HttpContext?.Request.Cookies["theme"] == "clair" ? "theme-clair" : null;
}
