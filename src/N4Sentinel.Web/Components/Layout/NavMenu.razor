@implements IDisposable

@inject NavigationManager NavigationManager
@inject IOptions<BrandingOptions> BrandingOptions
@inject IOptions<FeatureOptions> FeatureOptions

<header class="sticky top-0 z-30 border-b border-slate-200 bg-white">
    <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
        <a href="" class="flex items-center gap-2 text-brand-900">
            <span class="flex h-9 w-9 items-center justify-center rounded-md bg-brand-800 text-sm font-bold text-gold-300">N4</span>
            <span class="text-base font-semibold tracking-tight">@BrandingOptions.Value.ApplicationName</span>
        </a>

        <nav class="hidden items-center gap-1 md:flex">
            <NavLink class="navbar-link" href="" Match="NavLinkMatch.All">Accueil</NavLink>
            <AuthorizeView>
                <Authorized>
                    <NavLink class="navbar-link" href="dashboard">Tableau de bord</NavLink>
                </Authorized>
            </AuthorizeView>
            @if (FeatureOptions.Value.Environments)
            {
                <AuthorizeView>
                    <Authorized>
                        <NavLink class="navbar-link" href="environments">Environnements</NavLink>
                    </Authorized>
                </AuthorizeView>
            }
            <AuthorizeView Roles="@Roles.Administrateur">
                <Authorized>
                    <NavLink class="navbar-link" href="admin/users">Comptes</NavLink>
                    <NavLink class="navbar-link" href="admin/audit">Journal d'audit</NavLink>
                </Authorized>
            </AuthorizeView>
        </nav>

        <div class="hidden items-center gap-3 md:flex">
            <AuthorizeView>
                <Authorized>
                    <NavLink class="navbar-link" href="Account/Manage">@context.User.Identity?.Name</NavLink>
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                        <button type="submit" class="btn btn-outline-secondary btn-sm">Se déconnecter</button>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <NavLink class="navbar-link" href="Account/Login">Se connecter</NavLink>
                    <NavLink class="btn btn-primary btn-sm" href="Account/Register">Créer un compte</NavLink>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <button type="button" class="inline-flex h-10 w-10 items-center justify-center rounded-md text-slate-600 hover:bg-slate-100 md:hidden"
                aria-label="Ouvrir le menu" @onclick="ToggleMobileMenu">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                @if (isMobileMenuOpen)
                {
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                }
                else
                {
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
                }
            </svg>
        </button>
    </div>

    @if (isMobileMenuOpen)
    {
        <div class="border-t border-slate-200 px-4 pb-4 md:hidden">
            <nav class="flex flex-col gap-1 pt-2">
                <NavLink class="navbar-link-mobile" href="" Match="NavLinkMatch.All" @onclick="CloseMobileMenu">Accueil</NavLink>
                <AuthorizeView>
                    <Authorized>
                        <NavLink class="navbar-link-mobile" href="dashboard" @onclick="CloseMobileMenu">Tableau de bord</NavLink>
                    </Authorized>
                </AuthorizeView>
                @if (FeatureOptions.Value.Environments)
                {
                    <AuthorizeView>
                        <Authorized>
                            <NavLink class="navbar-link-mobile" href="environments" @onclick="CloseMobileMenu">Environnements</NavLink>
                        </Authorized>
                    </AuthorizeView>
                }
                <AuthorizeView Roles="@Roles.Administrateur">
                    <Authorized>
                        <NavLink class="navbar-link-mobile" href="admin/users" @onclick="CloseMobileMenu">Comptes</NavLink>
                        <NavLink class="navbar-link-mobile" href="admin/audit" @onclick="CloseMobileMenu">Journal d'audit</NavLink>
                    </Authorized>
                </AuthorizeView>
                <AuthorizeView>
                    <Authorized>
                        <NavLink class="navbar-link-mobile" href="Account/Manage" @onclick="CloseMobileMenu">@context.User.Identity?.Name</NavLink>
                        <form action="Account/Logout" method="post" class="pt-1">
                            <AntiforgeryToken />
                            <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                            <button type="submit" class="btn btn-outline-secondary btn-sm w-full">Se déconnecter</button>
                        </form>
                    </Authorized>
                    <NotAuthorized>
                        <NavLink class="navbar-link-mobile" href="Account/Login" @onclick="CloseMobileMenu">Se connecter</NavLink>
                        <NavLink class="navbar-link-mobile" href="Account/Register" @onclick="CloseMobileMenu">Créer un compte</NavLink>
                    </NotAuthorized>
                </AuthorizeView>
            </nav>
        </div>
    }
</header>

@code {
    private string? currentUrl;
    private bool isMobileMenuOpen;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        isMobileMenuOpen = false;
        StateHasChanged();
    }

    private void ToggleMobileMenu() => isMobileMenuOpen = !isMobileMenuOpen;

    private void CloseMobileMenu() => isMobileMenuOpen = false;

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
