@implements IDisposable

@inject NavigationManager NavigationManager
@inject IOptions<BrandingOptions> BrandingOptions
@inject IOptions<FeatureOptions> FeatureOptions

<header class="sticky top-0 z-30 border-b border-slate-200/70 bg-white/80 backdrop-blur-md">
    <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
        <a href="" class="group flex shrink-0 items-center gap-2.5">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-brand-800 text-sm font-bold text-gold-300">N4</span>
            <span class="flex flex-col leading-tight">
                <span class="text-base font-bold tracking-tight text-brand-900 transition-colors group-hover:text-brand-700">@BrandingOptions.Value.ApplicationName</span>
                <span class="hidden text-[0.65rem] font-medium uppercase tracking-wider text-slate-400 xl:block">@BrandingOptions.Value.OrganizationName</span>
            </span>
        </a>

        <nav class="hidden min-w-0 items-center gap-0.5 md:flex">
            <NavLink class="navbar-link" href="" Match="NavLinkMatch.All">Accueil</NavLink>
            <AuthorizeView>
                <Authorized>
                    <NavLink class="navbar-link" href="dashboard">Tableau de bord</NavLink>
                </Authorized>
            </AuthorizeView>
            @if (FeatureOptions.Value.Environments)
            {
                <AuthorizeView>
                    <Authorized>
                        <NavLink class="navbar-link" href="environments">Environnements</NavLink>
                    </Authorized>
                </AuthorizeView>
            }
            <AuthorizeView>
                <Authorized>
                    <NavLink class="navbar-link" href="assistant">Assistant N4</NavLink>
                    <NavLink class="navbar-link" href="sops">SOP</NavLink>
                </Authorized>
            </AuthorizeView>
            <AuthorizeView Roles="@Roles.Administrateur">
                <Authorized>
                    @* Regroupé en menu déroulant : quatre liens de plus dans la barre la faisaient
                       déborder horizontalement sur un écran de 1280 px. *@
                    <details class="nav-dropdown" name="navbar-menu">
                        <summary>
                            Administration
                            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                            </svg>
                        </summary>
                        <div class="nav-dropdown-panel">
                            <NavLink href="admin/users">Comptes</NavLink>
                            <NavLink href="admin/audit">Journal d'audit</NavLink>
                            <NavLink href="admin/sequences">Séquences d'exploitation</NavLink>
                            <NavLink href="admin/diagnostic-rules">Règles de diagnostic</NavLink>
                            <NavLink href="admin/documents">Base documentaire</NavLink>
                        </div>
                    </details>
                </Authorized>
            </AuthorizeView>
        </nav>

        <div class="hidden min-w-0 shrink items-center gap-2 md:flex">
            <AuthorizeView>
                <Authorized>
                    <NavLink class="navbar-link flex items-center gap-2 font-medium" href="Account/Manage">
                        <span class="flex h-7 w-7 items-center justify-center rounded-full bg-brand-100 text-xs font-bold text-brand-800">@Initial(context.User.Identity?.Name)</span>
                        <span class="max-w-[12rem] truncate">@context.User.Identity?.Name</span>
                    </NavLink>
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                        <button type="submit" class="btn btn-outline-secondary btn-sm">Se déconnecter</button>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <NavLink class="navbar-link" href="Account/Login">Se connecter</NavLink>
                    <NavLink class="btn btn-primary btn-sm" href="Account/Register">Créer un compte</NavLink>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        @* Menu mobile en <details> natif plutôt qu'un bouton @onclick : la navigation reste
           utilisable même si le circuit Blazor interactif n'est pas établi. *@
        <details class="group md:hidden" name="navbar-menu">
            <summary class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-lg text-slate-600 hover:bg-slate-100"
                     aria-label="Ouvrir le menu">
                <svg class="h-6 w-6 group-open:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
                </svg>
                <svg class="hidden h-6 w-6 group-open:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </summary>

            <div class="absolute inset-x-0 top-16 border-y border-slate-200 bg-white px-4 pb-4 shadow-lg">
                <nav class="flex flex-col gap-1 pt-3">
                    <NavLink class="navbar-link-mobile" href="" Match="NavLinkMatch.All">Accueil</NavLink>
                    <AuthorizeView>
                        <Authorized>
                            <NavLink class="navbar-link-mobile" href="dashboard">Tableau de bord</NavLink>
                        </Authorized>
                    </AuthorizeView>
                    @if (FeatureOptions.Value.Environments)
                    {
                        <AuthorizeView>
                            <Authorized>
                                <NavLink class="navbar-link-mobile" href="environments">Environnements</NavLink>
                            </Authorized>
                        </AuthorizeView>
                    }
                    <AuthorizeView>
                        <Authorized>
                            <NavLink class="navbar-link-mobile" href="assistant">Assistant N4</NavLink>
                            <NavLink class="navbar-link-mobile" href="sops">SOP</NavLink>
                        </Authorized>
                    </AuthorizeView>
                    <AuthorizeView Roles="@Roles.Administrateur">
                        <Authorized>
                            <p class="mt-3 px-3.5 pb-1 text-[0.65rem] font-semibold uppercase tracking-wider text-slate-400">Administration</p>
                            <NavLink class="navbar-link-mobile" href="admin/users">Comptes</NavLink>
                            <NavLink class="navbar-link-mobile" href="admin/audit">Journal d'audit</NavLink>
                            <NavLink class="navbar-link-mobile" href="admin/sequences">Séquences d'exploitation</NavLink>
                            <NavLink class="navbar-link-mobile" href="admin/diagnostic-rules">Règles de diagnostic</NavLink>
                            <NavLink class="navbar-link-mobile" href="admin/documents">Base documentaire</NavLink>
                        </Authorized>
                    </AuthorizeView>
                    <AuthorizeView>
                        <Authorized>
                            <div class="mt-3 border-t border-slate-100 pt-3">
                                <NavLink class="navbar-link-mobile block truncate" href="Account/Manage">@context.User.Identity?.Name</NavLink>
                                <form action="Account/Logout" method="post" class="pt-1">
                                    <AntiforgeryToken />
                                    <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                                    <button type="submit" class="btn btn-outline-secondary btn-sm btn-block">Se déconnecter</button>
                                </form>
                            </div>
                        </Authorized>
                        <NotAuthorized>
                            <div class="mt-3 border-t border-slate-100 pt-3">
                                <NavLink class="navbar-link-mobile" href="Account/Login">Se connecter</NavLink>
                            </div>
                        </NotAuthorized>
                    </AuthorizeView>
                </nav>
            </div>
        </details>
    </div>
</header>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    /// <summary>Initiale affichée dans la pastille utilisateur, sûre si le nom est vide.</summary>
    private static string Initial(string? userName) =>
        string.IsNullOrWhiteSpace(userName) ? "?" : userName.Trim()[..1].ToUpperInvariant();

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
