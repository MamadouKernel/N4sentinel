@inherits LayoutComponentBase
@using Microsoft.EntityFrameworkCore
@using N4Sentinel.Data
@using N4Sentinel.Domain.Common
@inject IDbContextFactory<ApplicationDbContext> Fabrique
@inject IHttpContextAccessor Accesseur
@inject NavigationManager Nav

<header class="bandeau">
    <a href="/" class="bandeau-marque">
        <svg class="bandeau-logo-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            <path d="m9 12 2 2 4-4"/>
        </svg>
        <span class="bandeau-titre">N4 SENTINEL</span>
    </a>

    <nav class="bandeau-nav">
        <a href="/" class="@ActiveClass("/")">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            Accueil
        </a>
        <a href="/supervision" class="@ActiveClass("/supervision")">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>
            Supervision
        </a>
        <a href="/operations" class="@ActiveClass("/operations")">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
            Opérations
        </a>
        <a href="/pilotage/workflows" class="@ActiveClass("/pilotage/workflows")">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="m9 12 2 2 4-4"/></svg>
            Workflows
        </a>
        <a href="/referentiel/environnements" class="@ActiveClass("/referentiel/environnements")">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L8.6 3.3A2 2 0 0 0 6.93 2.5H4a2 2 0 0 0-2 2v13.5a2 2 0 0 0 2 2Z"/></svg>
            Environnements
        </a>
        <a href="/referentiel/composants" class="@ActiveClass("/referentiel/composants")">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="8" x="2" y="2" rx="2"/><rect width="20" height="8" x="2" y="14" rx="2"/><line x1="6" x2="6.01" y1="6" y2="6"/><line x1="6" x2="6.01" y1="18" y2="18"/></svg>
            Composants
        </a>
        <a href="/referentiel/dependances" class="@ActiveClass("/referentiel/dependances")">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" x2="15.42" y1="13.51" y2="17.49"/><line x1="15.41" x2="8.59" y1="6.51" y2="10.49"/></svg>
            Dépendances
        </a>
    </nav>

    <div class="bandeau-droite">
        <SelecteurDeTheme />
        @* SEC-004 — l'environnement courant est visible en permanence, jamais deviné. *@
        @if (environnements.Count > 0)
        {
            <form method="post" action="/environnement" class="form-environnement">
                <AntiforgeryToken />
                <span class="pastille-environnement @ClasseDePastille">@NomDeLEnvironnement</span>
                <select name="environnementId" class="select-environnement" aria-label="Environnement">
                    @foreach (var environnement in environnements)
                    {
                        <option value="@environnement.Id"
                                selected="@(environnement.Id == EnvironnementCourantId)">
                            @environnement.Nom
                        </option>
                    }
                </select>
                <button type="submit" class="bouton-discret">Changer</button>
            </form>
        }

        <AuthorizeView>
            <Authorized>
                <span class="identite">
                    <a class="identite-nom" href="/compte/profil">@context.User.Identity?.Name</a>
                    <span class="identite-profils">@Profils(context.User)</span>
                </span>
                <form method="post" action="/compte/deconnexion">
                    <AntiforgeryToken />
                    <button type="submit" class="bouton-discret">Se déconnecter</button>
                </form>
            </Authorized>
        </AuthorizeView>
    </div>
</header>

<main class="contenu">
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet>
    Une erreur inattendue s'est produite.
    <a href="." class="reload">Recharger</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private List<Domain.Entities.N4Environment> environnements = [];

    private Guid? EnvironnementCourantId
    {
        get
        {
            var brut = Accesseur.HttpContext?.Request.Cookies["environnement"];
            return Guid.TryParse(brut, out var id) ? id : environnements.FirstOrDefault()?.Id;
        }
    }

    private Domain.Entities.N4Environment? EnvironnementCourant =>
        environnements.Find(e => e.Id == EnvironnementCourantId);

    private string NomDeLEnvironnement => EnvironnementCourant?.Nom ?? "—";

    private string ClasseDePastille => EnvironnementCourant?.Type switch
    {
        EnvironmentType.Production => "production",
        EnvironmentType.Uat => "uat",
        _ => string.Empty
    };

    protected override async Task OnInitializedAsync()
    {
        await using var contexte = await Fabrique.CreateDbContextAsync();
        environnements = await contexte.Environnements
            .AsNoTracking()
            .OrderBy(e => e.Type)
            .ToListAsync();
    }

    private static string Profils(System.Security.Claims.ClaimsPrincipal utilisateur) =>
        string.Join(", ", utilisateur.Claims
            .Where(c => c.Type == System.Security.Claims.ClaimTypes.Role)
            .Select(c => c.Value));

    private string ActiveClass(string href)
    {
        var relative = Nav.ToBaseRelativePath(Nav.Uri);
        if (href == "/" && string.IsNullOrEmpty(relative)) return "active";
        if (href != "/" && relative.StartsWith(href.TrimStart('/'), StringComparison.OrdinalIgnoreCase)) return "active";
        return "";
    }
}
