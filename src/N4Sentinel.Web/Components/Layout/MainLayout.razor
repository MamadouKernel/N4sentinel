@inherits LayoutComponentBase

<div class="min-h-screen bg-slate-50">
    <NavMenu />

    <main class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet
     class="fixed inset-x-0 bottom-0 z-50 hidden items-center justify-between bg-amber-50 px-4 py-3 text-sm text-amber-900 shadow-[0_-1px_4px_rgba(0,0,0,0.1)]">
    <span>Une erreur inattendue s'est produite.</span>
    <span>
        <a href="." class="reload font-medium underline">Recharger</a>
        <span class="dismiss ml-3 cursor-pointer">🗙</span>
    </span>
</div>
