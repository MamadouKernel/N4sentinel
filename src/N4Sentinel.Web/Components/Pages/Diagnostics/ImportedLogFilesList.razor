@page "/environments/{EnvironmentId:guid}/logs"
@attribute [Authorize]
@inject ISender Mediator
@inject NavigationManager NavigationManager

<PageTitle>Journaux techniques - N4 Sentinel</PageTitle>

<div class="space-y-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <div class="flex items-center gap-2 text-sm text-slate-500">
                <a href="environments" class="hover:text-slate-700">Environnements</a>
                <span>/</span>
                <a href="@($"environments/{EnvironmentId}")" class="hover:text-slate-700">@environment?.Name</a>
                <span>/</span>
                <span class="font-medium text-slate-900">Journaux techniques</span>
            </div>
            <h1 class="mt-1 text-2xl font-bold text-slate-900">Journaux techniques importés</h1>
            <p class="text-sm text-slate-600">Importation, masquage automatique des secrets et analyse des logs (FR-070, E8.1).</p>
        </div>

        <div class="flex items-center gap-3">
            <a href="@($"environments/{EnvironmentId}/diagnostic-cases")" class="btn btn-outline-secondary">Cas de diagnostic</a>
            <button class="btn btn-primary" @onclick="() => showImportModal = true">Importer un log</button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(actionMessage))
    {
        <div class="rounded-md bg-emerald-50 p-4 text-sm font-medium text-emerald-800 border border-emerald-200">
            @actionMessage
        </div>
    }
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="rounded-md bg-rose-50 p-4 text-sm font-medium text-rose-800 border border-rose-200">
            @errorMessage
        </div>
    }

    <!-- Global search cross-files -->
    <div class="card p-4 space-y-3 bg-slate-50 border-slate-200">
        <h3 class="text-sm font-bold text-slate-900">Recherche globale cross-fichiers (FR-077)</h3>
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
            <input @bind="searchFreeText" type="text" class="form-input flex-1" placeholder="Rechercher dans tous les logs (ex: ORA-00060, deadlock, KahaDB)..." />
            <select @bind="searchLevel" class="form-select w-full sm:w-40">
                <option value="">Tous les niveaux</option>
                <option value="ERROR">ERROR</option>
                <option value="WARN">WARN</option>
                <option value="INFO">INFO</option>
            </select>
            <input @bind="searchCorrelation" type="text" class="form-input w-full sm:w-48" placeholder="Réf. Corrélation..." />
            <button class="btn btn-primary" @onclick="ExecuteGlobalSearch" disabled="@isSearching">
                @(isSearching ? "Recherche..." : "Rechercher")
            </button>
        </div>

        @if (searchResults != null)
        {
            <div class="mt-4 pt-4 border-t border-slate-200 space-y-3">
                <div class="flex items-center justify-between text-xs text-slate-500">
                    <span>Résultats dans <strong>@searchResults.Count</strong> fichier(s)</span>
                    <button class="text-brand-700 hover:underline" @onclick="() => searchResults = null">Effacer la recherche</button>
                </div>

                @if (searchResults.Count == 0)
                {
                    <p class="text-sm text-slate-500 italic">Aucune correspondance trouvée dans les logs.</p>
                }
                else
                {
                    <div class="space-y-3">
                        @foreach (var res in searchResults)
                        {
                            <div class="rounded-md bg-white p-3 border border-slate-200 space-y-2">
                                <div class="flex items-center justify-between">
                                    <a href="@($"environments/{EnvironmentId}/logs/{res.LogFileId}")" class="font-bold text-brand-900 hover:underline">
                                        @res.FileName
                                    </a>
                                    <span class="badge bg-brand-50 text-brand-800">@res.TotalMatches occurrence(s)</span>
                                </div>
                                <div class="space-y-1">
                                    @foreach (var m in res.Matches.Take(3))
                                    {
                                        <div class="text-xs font-mono bg-slate-900 text-slate-100 p-2 rounded overflow-x-auto">
                                            <span class="text-gold-400 font-semibold">L. @m.FirstLineNumber :</span> @m.Line
                                            @if (m.OccurrenceCount > 1)
                                            {
                                                <span class="text-slate-400"> (répété @m.OccurrenceCount fois)</span>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>

    <!-- Modal for importing log file -->
    @if (showImportModal)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/50 p-4">
            <div class="card max-w-2xl w-full p-6 space-y-4 bg-white shadow-xl">
                <h2 class="text-lg font-bold text-slate-900">Importer un journal technique (FR-070)</h2>
                <p class="text-xs text-slate-500">Les secrets (mots de passe, tokens) seront automatiquement masqués (FR-078).</p>

                <div class="space-y-3">
                    <div>
                        <label class="block text-sm font-medium text-slate-700">Nom du fichier <span class="text-rose-500">*</span></label>
                        <input @bind="importFileName" type="text" class="form-input mt-1 w-full" placeholder="Ex: navis-apex.log ou xps_20260807.log" />
                    </div>
                    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                        <div>
                            <label class="block text-sm font-medium text-slate-700">Source / Composant</label>
                            <input @bind="importSource" type="text" class="form-input mt-1 w-full" placeholder="Ex: Center Node / XPS Gate" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-slate-700">Réf. Corrélation / Incident</label>
                            <input @bind="importCorrelation" type="text" class="form-input mt-1 w-full" placeholder="Ex: INC-2026-042" />
                        </div>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-slate-700">Contenu du log <span class="text-rose-500">*</span></label>
                        <textarea @bind="importContent" rows="6" class="form-input mt-1 w-full font-mono text-xs" placeholder="Collez l'extrait ou l'intégralité du log ici..."></textarea>
                    </div>
                </div>

                <div class="flex justify-end gap-3 pt-3 border-t border-slate-200">
                    <button class="btn btn-outline-secondary" @onclick="() => showImportModal = false">Annuler</button>
                    <button class="btn btn-primary" @onclick="SubmitImport" disabled="@isImporting">
                        @(isImporting ? "Importation..." : "Importer et masquer secrets")
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- Logs list table -->
    @if (isLoading)
    {
        <div class="card p-8 text-center text-slate-500">Chargement des journaux techniques...</div>
    }
    else if (logFiles == null || logFiles.Count == 0)
    {
        <div class="card p-8 text-center">
            <h3 class="text-lg font-medium text-slate-900">Aucun journal technique importé</h3>
            <p class="mt-1 text-sm text-slate-500">Importez des logs bruts pour analyse et détection automatique des signatures.</p>
            <div class="mt-4">
                <button class="btn btn-primary" @onclick="() => showImportModal = true">Importer un log</button>
            </div>
        </div>
    }
    else
    {
        <div class="card overflow-hidden">
            <table class="min-w-full divide-y divide-slate-200 text-left text-sm">
                <thead class="bg-slate-50 font-semibold text-slate-700">
                    <tr>
                        <th class="px-4 py-3">Fichier</th>
                        <th class="px-4 py-3">Source</th>
                        <th class="px-4 py-3">Corrélation</th>
                        <th class="px-4 py-3">Statut & Verdict</th>
                        <th class="px-4 py-3">Lignes</th>
                        <th class="px-4 py-3">Signatures décelées</th>
                        <th class="px-4 py-3">Date</th>
                        <th class="px-4 py-3 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200 font-medium text-slate-800">
                    @foreach (var log in logFiles)
                    {
                        <tr class="hover:bg-slate-50">
                            <td class="px-4 py-3 font-semibold text-brand-900">
                                <a href="@($"environments/{EnvironmentId}/logs/{log.Id}")" class="hover:underline">@log.FileName</a>
                            </td>
                            <td class="px-4 py-3 text-slate-600">@(log.Source ?? "—")</td>
                            <td class="px-4 py-3 font-mono text-xs text-slate-700">@(log.CorrelationReference ?? "—")</td>
                            <td class="px-4 py-3">
                                @if (log.AnalysisStatus == LogFileAnalysisStatus.Pending)
                                {
                                    <span class="inline-flex items-center rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-700">
                                        En attente d'analyse
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold @GetVerdictBadgeClass(log.Verdict)">
                                        @GetVerdictLabel(log.Verdict)
                                    </span>
                                }
                            </td>
                            <td class="px-4 py-3 text-slate-600 text-xs">
                                @if (log.AnalysisStatus == LogFileAnalysisStatus.Analyzed)
                                {
                                    <span>@log.TotalLineCount total (<strong class="text-rose-600">@log.ErrorLineCount err</strong>, <strong class="text-amber-600">@log.WarningLineCount warn</strong>)</span>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </td>
                            <td class="px-4 py-3 text-xs max-w-xs truncate text-slate-700" title="@log.DetectedSignatures">
                                @(log.DetectedSignatures ?? "Aucune")
                            </td>
                            <td class="px-4 py-3 text-xs text-slate-500">@log.ImportedAtUtc.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="px-4 py-3 text-right space-x-2">
                                @if (log.AnalysisStatus == LogFileAnalysisStatus.Pending)
                                {
                                    <button class="btn btn-outline-primary btn-sm" @onclick="() => AnalyzeLog(log.Id)">Lancer l'analyse</button>
                                }
                                <a href="@($"environments/{EnvironmentId}/logs/{log.Id}")" class="btn btn-outline-secondary btn-sm">Détail & Recherche</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    [Parameter] public Guid EnvironmentId { get; set; }

    private EnvironmentDetailDto? environment;
    private IReadOnlyList<ImportedLogFileDto>? logFiles;
    private bool isLoading = true;

    // Import modal state
    private bool showImportModal;
    private bool isImporting;
    private string importFileName = string.Empty;
    private string importSource = string.Empty;
    private string importCorrelation = string.Empty;
    private string importContent = string.Empty;

    // Search state
    private string searchFreeText = string.Empty;
    private string searchLevel = string.Empty;
    private string searchCorrelation = string.Empty;
    private bool isSearching;
    private IReadOnlyList<GlobalLogSearchResultDto>? searchResults;

    private string? actionMessage;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadLogsAsync();
    }

    private async Task LoadLogsAsync()
    {
        isLoading = true;
        environment = await Mediator.Send(new GetEnvironmentByIdQuery(EnvironmentId));
        if (environment == null)
        {
            NavigationManager.NavigateTo("environments");
            return;
        }

        logFiles = await Mediator.Send(new ListImportedLogFilesByEnvironmentQuery(EnvironmentId));
        isLoading = false;
    }

    private async Task SubmitImport()
    {
        if (string.IsNullOrWhiteSpace(importFileName) || string.IsNullOrWhiteSpace(importContent))
        {
            errorMessage = "Le nom du fichier et le contenu sont obligatoires.";
            return;
        }

        isImporting = true;
        errorMessage = null;

        try
        {
            var id = await Mediator.Send(new ImportLogFileCommand(
                EnvironmentId,
                importFileName,
                string.IsNullOrWhiteSpace(importSource) ? null : importSource,
                importContent,
                30,
                string.IsNullOrWhiteSpace(importCorrelation) ? null : importCorrelation));

            // Auto analyze after import
            await Mediator.Send(new AnalyzeLogFileCommand(id));

            actionMessage = $"Journal '{importFileName}' importé et analysé avec succès (secrets masqués).";
            showImportModal = false;
            importFileName = string.Empty;
            importSource = string.Empty;
            importCorrelation = string.Empty;
            importContent = string.Empty;

            await LoadLogsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isImporting = false;
        }
    }

    private async Task AnalyzeLog(Guid logId)
    {
        try
        {
            await Mediator.Send(new AnalyzeLogFileCommand(logId));
            actionMessage = "Analyse effectuée avec succès.";
            await LoadLogsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task ExecuteGlobalSearch()
    {
        if (string.IsNullOrWhiteSpace(searchFreeText) && string.IsNullOrWhiteSpace(searchLevel) && string.IsNullOrWhiteSpace(searchCorrelation))
        {
            searchResults = null;
            return;
        }

        isSearching = true;
        try
        {
            searchResults = await Mediator.Send(new SearchLogFilesGlobalQuery(
                EnvironmentId, searchFreeText, searchLevel, searchCorrelation));
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSearching = false;
        }
    }

    private static string GetVerdictLabel(LogAnalysisVerdict? verdict) => verdict switch
    {
        LogAnalysisVerdict.NoAnomalyDetected => "Aucune anomalie",
        LogAnalysisVerdict.Warnings => "Avertissements",
        LogAnalysisVerdict.CriticalAnomaliesDetected => "Anomalies critiques",
        LogAnalysisVerdict.IncompleteAnalysis => "Analyse incomplète",
        _ => "Non analysé",
    };

    private static string GetVerdictBadgeClass(LogAnalysisVerdict? verdict) => verdict switch
    {
        LogAnalysisVerdict.NoAnomalyDetected => "bg-emerald-100 text-emerald-800",
        LogAnalysisVerdict.Warnings => "bg-amber-100 text-amber-800",
        LogAnalysisVerdict.CriticalAnomaliesDetected => "bg-rose-100 text-rose-800",
        _ => "bg-slate-100 text-slate-700",
    };
}
