@page "/environments/{EnvironmentId:guid}/diagnostic-cases/{CaseId:guid}/escalation-package"
@attribute [Authorize]
@inject ISender Mediator
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Paquet d'escalade - N4 Sentinel</PageTitle>

@if (package is null)
{
    <div class="card p-8 text-center text-slate-500">Chargement du paquet d'escalade...</div>
}
else
{
    <div class="space-y-6">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
                <h1 class="text-2xl font-bold text-slate-900">Paquet d'escalade (FR-067)</h1>
                <a href="@($"environments/{EnvironmentId}/diagnostic-cases/{CaseId}")" class="text-sm text-slate-500 hover:text-slate-700">← Retour au diagnostic</a>
            </div>
            <a href="@($"/reports/incidents/{CaseId}/escalation-package/export")" class="btn btn-primary">Télécharger en JSON</a>
        </div>

        <div class="rounded-md bg-slate-50 p-4 text-xs text-slate-600 border border-slate-200">
            Ce paquet ne contient que les éléments déjà présents dans N4 Sentinel : les journaux inclus sont ceux
            déjà expurgés des secrets détectés au moment de leur import (FR-076/077). Vérifiez son contenu avant
            toute transmission externe vers l'équipe Infrastructure ou le support Navis.
        </div>

        <div class="card p-6 space-y-3">
            <dl class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                <div><dt class="text-xs font-semibold uppercase text-slate-500">Symptôme</dt><dd class="text-sm text-slate-900">@package.Symptom</dd></div>
                <div><dt class="text-xs font-semibold uppercase text-slate-500">Environnement</dt><dd class="text-sm text-slate-900">@package.EnvironmentName</dd></div>
                <div><dt class="text-xs font-semibold uppercase text-slate-500">Référence de corrélation</dt><dd class="text-sm font-mono text-slate-900">@package.CorrelationReference</dd></div>
                <div><dt class="text-xs font-semibold uppercase text-slate-500">Composants concernés</dt><dd class="text-sm text-slate-900">@(package.ComponentsConcerned.Count > 0 ? string.Join(", ", package.ComponentsConcerned) : "—")</dd></div>
                <div><dt class="text-xs font-semibold uppercase text-slate-500">Période</dt><dd class="text-sm text-slate-900">@package.PeriodStartUtc.ToLocalTime().ToString("g") → @package.PeriodEndUtc.ToLocalTime().ToString("g")</dd></div>
                <div><dt class="text-xs font-semibold uppercase text-slate-500">Détecté le</dt><dd class="text-sm text-slate-900">@package.DetectedAtUtc.ToLocalTime().ToString("g")</dd></div>
            </dl>
            @if (!string.IsNullOrEmpty(package.ConclusionSummary))
            {
                <div>
                    <dt class="text-xs font-semibold uppercase text-slate-500">Synthèse de conclusion</dt>
                    <p class="mt-1 text-sm text-slate-900 whitespace-pre-line">@package.ConclusionSummary</p>
                </div>
            }
        </div>

        <h2 class="text-lg font-bold text-slate-900">Hypothèses évaluées (@package.Hypotheses.Count)</h2>
        @foreach (var h in package.Hypotheses)
        {
            <div class="card p-4 space-y-1">
                <span class="badge bg-slate-100 text-slate-800">@h.Domain.ToLabel()</span>
                <p class="text-sm font-semibold text-slate-900">@h.CauseDescription</p>
                @if (!string.IsNullOrEmpty(h.MissingInformation))
                {
                    <p class="text-xs text-amber-800"><strong>Information manquante :</strong> @h.MissingInformation</p>
                }
            </div>
        }

        <h2 class="text-lg font-bold text-slate-900">Journaux inclus (@package.Files.Count)</h2>
        @if (package.Files.Count == 0)
        {
            <div class="card p-6 text-center text-slate-500">Aucun journal importé sous cette référence de corrélation.</div>
        }
        else
        {
            <div class="space-y-3">
                @foreach (var f in package.Files)
                {
                    <div class="card p-4">
                        <p class="text-sm font-semibold text-brand-900">@f.FileName <span class="text-xs text-slate-500">(@f.Source)</span></p>
                        <p class="text-xs font-mono text-slate-500">SHA-256 : @f.ContentHash</p>
                        <pre class="mt-2 text-xs bg-slate-50 p-2 rounded border border-slate-200 whitespace-pre-wrap max-h-40 overflow-y-auto">@f.RedactedContent</pre>
                    </div>
                }
            </div>
        }

        <p class="text-xs text-slate-400">Généré le @package.GeneratedAtUtc.ToLocalTime().ToString("g") par @package.GeneratedByUserId</p>
    </div>
}

@code {
    [Parameter] public Guid EnvironmentId { get; set; }
    [Parameter] public Guid CaseId { get; set; }

    private EscalationPackageDto? package;

    protected override async Task OnParametersSetAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userName = authState.User.Identity?.Name ?? "Opérateur";

        package = await Mediator.Send(new GetEscalationPackageQuery(CaseId, userName));
    }
}
