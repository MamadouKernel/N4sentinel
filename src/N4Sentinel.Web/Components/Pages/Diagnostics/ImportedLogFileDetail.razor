@page "/environments/{EnvironmentId:guid}/logs/{LogFileId:guid}"
@attribute [Authorize]
@inject ISender Mediator
@inject NavigationManager NavigationManager

<PageTitle>Détail du journal - N4 Sentinel</PageTitle>

@if (isLoading)
{
    <div class="card p-8 text-center text-slate-500">Chargement du journal technique...</div>
}
else if (logFile == null)
{
    <div class="card p-8 text-center text-slate-500">Journal technique introuvable.</div>
}
else
{
    <div class="space-y-6">
        <div>
            <div class="flex items-center gap-2 text-sm text-slate-500">
                <a href="environments" class="hover:text-slate-700">Environnements</a>
                <span>/</span>
                <a href="@($"environments/{EnvironmentId}")" class="hover:text-slate-700">@environment?.Name</a>
                <span>/</span>
                <a href="@($"environments/{EnvironmentId}/logs")" class="hover:text-slate-700">Journaux</a>
                <span>/</span>
                <span class="font-medium text-slate-900">@logFile.FileName</span>
            </div>
            <div class="mt-2 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
                <div>
                    <h1 class="text-2xl font-bold text-slate-900">@logFile.FileName</h1>
                    <p class="mt-1 text-sm text-slate-600">
                        Importé le @logFile.ImportedAtUtc.ToString("dd/MM/yyyy HH:mm") — Source : <span class="font-medium">@(logFile.Source ?? "Inconnue")</span>
                    </p>
                </div>
                <div class="flex items-center gap-3">
                    @if (logFile.AnalysisStatus == LogFileAnalysisStatus.Pending)
                    {
                        <button class="btn btn-primary" @onclick="Analyze">Lancer l'analyse</button>
                    }
                    else
                    {
                        <span class="inline-flex items-center rounded-md px-3 py-1 text-sm font-semibold @GetVerdictBadgeClass(logFile.Verdict)">
                            Verdict : @GetVerdictLabel(logFile.Verdict)
                        </span>
                    }
                </div>
            </div>
        </div>

        <!-- Metric cards -->
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-4">
            <div class="card p-4">
                <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Hash SHA256 (FR-071)</span>
                <p class="mt-1 font-mono text-xs text-slate-800 truncate" title="@logFile.ContentHash">@logFile.ContentHash</p>
            </div>
            <div class="card p-4">
                <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Réf. Corrélation</span>
                <p class="mt-1 font-mono text-sm font-bold text-slate-900">@(logFile.CorrelationReference ?? "Non liée")</p>
            </div>
            <div class="card p-4">
                <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Total lignes</span>
                <p class="mt-1 text-base font-bold text-slate-900">@logFile.TotalLineCount</p>
            </div>
            <div class="card p-4">
                <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Anomalies & Warnings</span>
                <p class="mt-1 text-sm font-medium">
                    <span class="text-rose-600 font-bold">@logFile.ErrorLineCount erreurs</span> /
                    <span class="text-amber-600 font-bold">@logFile.WarningLineCount avert.</span>
                </p>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(logFile.DetectedSignatures))
        {
            <div class="card p-4 bg-amber-50/50 border-amber-200">
                <strong class="text-xs uppercase tracking-wider text-amber-800">Signatures d'anomalies détectées (FR-075) :</strong>
                <p class="mt-1 text-sm font-semibold text-slate-900">@logFile.DetectedSignatures</p>
            </div>
        }

        <!-- Search & Filter in File (FR-076, FR-077) -->
        <div class="card p-5 space-y-4">
            <h2 class="text-lg font-bold text-slate-900">Recherche & Filtrage dans ce journal (FR-076/FR-077)</h2>

            <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
                <input @bind="filterText" type="text" class="form-input flex-1" placeholder="Rechercher une chaîne texte dans le log..." />
                <select @bind="filterLevel" class="form-select w-full sm:w-44">
                    <option value="">Tous les niveaux</option>
                    <option value="ERROR">ERROR</option>
                    <option value="WARN">WARN</option>
                    <option value="INFO">INFO</option>
                </select>
                <button class="btn btn-primary" @onclick="ExecuteSearch" disabled="@isSearching">
                    @(isSearching ? "Filtrage..." : "Filtrer")
                </button>
            </div>

            @if (searchResults != null)
            {
                <div class="pt-2 border-t border-slate-200 space-y-3">
                    <div class="flex items-center justify-between text-xs text-slate-500">
                        <span><strong>@searchResults.Count</strong> groupe(s) de lignes trouvé(s)</span>
                        <button class="text-brand-700 hover:underline" @onclick="() => searchResults = null">Réafficher tout le log</button>
                    </div>

                    <div class="space-y-2 max-h-96 overflow-y-auto">
                        @foreach (var match in searchResults)
                        {
                            <div class="p-3 bg-slate-900 text-slate-100 rounded text-xs font-mono space-y-1">
                                <div class="flex items-center justify-between text-slate-400 text-[11px] pb-1 border-b border-slate-800">
                                    <span>Ligne @match.FirstLineNumber (répétée @match.OccurrenceCount fois)</span>
                                </div>
                                @if (match.ContextBefore.Count > 0)
                                {
                                    <div class="text-slate-500">@string.Join("\n", match.ContextBefore)</div>
                                }
                                <div class="text-gold-300 font-bold">@match.Line</div>
                                @if (match.ContextAfter.Count > 0)
                                {
                                    <div class="text-slate-500">@string.Join("\n", match.ContextAfter)</div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Full log content view with line numbers -->
        <div class="card p-4 space-y-2">
            <h2 class="text-sm font-bold text-slate-700 uppercase tracking-wider">Contenu masqué (secrets caviardés FR-078)</h2>
            <div class="bg-slate-950 text-slate-200 p-4 rounded-md font-mono text-xs overflow-x-auto max-h-[600px] leading-relaxed">
                @{
                    var lines = logFile.Content.Split('\n');
                    for (var i = 0; i < lines.Length; i++)
                    {
                        var lineNum = i + 1;
                        var isError = lines[i].Contains("ERROR", StringComparison.OrdinalIgnoreCase);
                        var isWarn = lines[i].Contains("WARN", StringComparison.OrdinalIgnoreCase);
                        var lineClass = isError ? "bg-rose-950/60 text-rose-300 font-semibold" : (isWarn ? "bg-amber-950/40 text-amber-300" : "");

                        <div class="flex hover:bg-slate-900/80 px-1 py-0.5 rounded @lineClass">
                            <span class="inline-block w-12 shrink-0 text-slate-600 select-none text-right pr-4">@lineNum</span>
                            <span class="whitespace-pre-wrap break-all">@lines[i]</span>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid EnvironmentId { get; set; }
    [Parameter] public Guid LogFileId { get; set; }

    private EnvironmentDetailDto? environment;
    private ImportedLogFileDetailDto? logFile;
    private bool isLoading = true;

    // Filter state
    private string filterText = string.Empty;
    private string filterLevel = string.Empty;
    private bool isSearching;
    private IReadOnlyList<LogLineMatchDto>? searchResults;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        environment = await Mediator.Send(new GetEnvironmentByIdQuery(EnvironmentId));
        logFile = await Mediator.Send(new GetImportedLogFileByIdQuery(LogFileId));
        isLoading = false;
    }

    private async Task Analyze()
    {
        await Mediator.Send(new AnalyzeLogFileCommand(LogFileId));
        await LoadDataAsync();
    }

    private async Task ExecuteSearch()
    {
        if (string.IsNullOrWhiteSpace(filterText) && string.IsNullOrWhiteSpace(filterLevel))
        {
            searchResults = null;
            return;
        }

        isSearching = true;
        searchResults = await Mediator.Send(new SearchLogFileLinesQuery(LogFileId, filterText, filterLevel));
        isSearching = false;
    }

    private static string GetVerdictLabel(LogAnalysisVerdict? verdict) => verdict switch
    {
        LogAnalysisVerdict.NoAnomalyDetected => "Aucune anomalie",
        LogAnalysisVerdict.Warnings => "Avertissements",
        LogAnalysisVerdict.CriticalAnomaliesDetected => "Anomalies critiques",
        LogAnalysisVerdict.IncompleteAnalysis => "Analyse incomplète",
        _ => "Non analysé",
    };

    private static string GetVerdictBadgeClass(LogAnalysisVerdict? verdict) => verdict switch
    {
        LogAnalysisVerdict.NoAnomalyDetected => "bg-emerald-100 text-emerald-800",
        LogAnalysisVerdict.Warnings => "bg-amber-100 text-amber-800",
        LogAnalysisVerdict.CriticalAnomaliesDetected => "bg-rose-100 text-rose-800",
        _ => "bg-slate-100 text-slate-700",
    };
}
