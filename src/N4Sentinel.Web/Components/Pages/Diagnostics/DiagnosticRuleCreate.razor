@page "/admin/diagnostic-rules/new"
@attribute [Authorize(Roles = Roles.Administrateur)]
@inject IMediator Mediator
@inject NavigationManager NavigationManager

<PageTitle>Nouvelle règle de diagnostic - N4 Sentinel</PageTitle>

<h1>Nouvelle règle de diagnostic</h1>

<EditForm Model="model" OnValidSubmit="SubmitAsync" FormName="CreateDiagnosticRule">
    <DataAnnotationsValidator />
    <ValidationSummary class="text-danger" />

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <div class="mb-3">
        <label class="form-label" for="ruleKey">Identifiant</label>
        <InputText id="ruleKey" class="form-control" @bind-Value="model.RuleKey" placeholder="ex. RULE-NET-001" />
    </div>

    <div class="mb-3">
        <label class="form-label" for="domain">Domaine</label>
        <InputSelect id="domain" class="form-select" @bind-Value="model.Domain">
            @foreach (var d in Enum.GetValues<DiagnosticDomain>())
            {
                <option value="@d">@d.ToLabel()</option>
            }
        </InputSelect>
    </div>

    <div class="mb-3">
        <label class="form-label" for="condition">Conditions d'application</label>
        <InputTextArea id="condition" class="form-control" @bind-Value="model.ConditionDescription" rows="2" />
    </div>

    <div class="mb-3">
        <label class="form-label" for="sources">Sources nécessaires</label>
        <InputTextArea id="sources" class="form-control" @bind-Value="model.RequiredSources" rows="2" />
    </div>

    <div class="mb-3">
        <label class="form-label" for="hypothesis">Conclusion / hypothèse produite</label>
        <InputTextArea id="hypothesis" class="form-control" @bind-Value="model.Hypothesis" rows="2" />
    </div>

    <div class="mb-3">
        <label class="form-label" for="severity">Niveau de sévérité</label>
        <InputSelect id="severity" class="form-select" @bind-Value="model.Severity">
            @foreach (var s in Enum.GetValues<DiagnosticSeverity>())
            {
                <option value="@s">@s.ToLabel()</option>
            }
        </InputSelect>
    </div>

    <div class="mb-3">
        <label class="form-label" for="confidence">Méthode de calcul du niveau de confiance</label>
        <InputTextArea id="confidence" class="form-control" @bind-Value="model.ConfidenceCalculationMethod" rows="2" />
    </div>

    <div class="mb-3">
        <label class="form-label" for="checks">Contrôles complémentaires (optionnel)</label>
        <InputTextArea id="checks" class="form-control" @bind-Value="model.AdditionalChecks" rows="2" />
    </div>

    <div class="mb-3">
        <label class="form-label" for="recommendation">Recommandations autorisées</label>
        <InputTextArea id="recommendation" class="form-control" @bind-Value="model.Recommendation" rows="2" />
    </div>

    <button type="submit" class="btn btn-primary">Créer (Brouillon)</button>
    <a class="btn btn-secondary" href="admin/diagnostic-rules">Annuler</a>
</EditForm>

@code {
    private readonly CreateDiagnosticRuleModel model = new();
    private string? errorMessage;

    private async Task SubmitAsync()
    {
        errorMessage = null;
        try
        {
            var id = await Mediator.Send(new CreateDiagnosticRuleCommand(
                model.RuleKey, model.Domain, model.ConditionDescription, model.RequiredSources, model.Hypothesis,
                model.Severity, model.ConfidenceCalculationMethod, model.AdditionalChecks, model.Recommendation));
            NavigationManager.NavigateTo($"admin/diagnostic-rules/{id}");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private sealed class CreateDiagnosticRuleModel
    {
        [Required(ErrorMessage = "L'identifiant est obligatoire.")]
        public string RuleKey { get; set; } = string.Empty;

        public DiagnosticDomain Domain { get; set; } = DiagnosticDomain.Network;

        [Required(ErrorMessage = "Les conditions d'application sont obligatoires.")]
        public string ConditionDescription { get; set; } = string.Empty;

        [Required(ErrorMessage = "Les sources nécessaires sont obligatoires.")]
        public string RequiredSources { get; set; } = string.Empty;

        [Required(ErrorMessage = "L'hypothèse est obligatoire.")]
        public string Hypothesis { get; set; } = string.Empty;

        public DiagnosticSeverity Severity { get; set; } = DiagnosticSeverity.Medium;

        [Required(ErrorMessage = "La méthode de calcul du niveau de confiance est obligatoire.")]
        public string ConfidenceCalculationMethod { get; set; } = string.Empty;

        public string? AdditionalChecks { get; set; }

        [Required(ErrorMessage = "La recommandation est obligatoire.")]
        public string Recommendation { get; set; } = string.Empty;
    }
}
