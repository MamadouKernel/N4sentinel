@page "/environments/{EnvironmentId:guid}/diagnostics"
@attribute [Authorize]
@inject IMediator Mediator

<PageTitle>Diagnostic - N4 Sentinel</PageTitle>

<h1>Collecte des signaux de diagnostic</h1>
<p><a href="environments/@EnvironmentId">← Retour à l'environnement</a></p>
<p class="text-muted">
    Journaux, événements et métriques utiles à un incident (E7.1). La collecte automatique tente d'utiliser un
    connecteur réel — tant qu'aucun n'existe, chaque tentative est enregistrée comme indisponible avec sa cause
    explicite ; l'import manuel vient en complément. L'absence d'un signal n'est jamais une absence d'anomalie.
</p>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

<AuthorizeView Roles="@($"{Roles.Operateur},{Roles.Administrateur}")">
    <Authorized>
        <div class="row mb-4">
            <div class="col-md-6 mb-3">
                <h2>Collecte automatique</h2>
                <div class="mb-2">
                    <label class="form-label" for="collectDomain">Domaine</label>
                    <InputSelect id="collectDomain" class="form-select mb-2" @bind-Value="collectModel.Domain">
                        @foreach (var d in Enum.GetValues<DiagnosticDomain>())
                        {
                            <option value="@d">@d.ToLabel()</option>
                        }
                    </InputSelect>
                    <label class="form-label" for="collectSource">Source</label>
                    <input id="collectSource" class="form-control mb-2" @bind="collectModel.Source" placeholder="ex. Cluster Node 1 - navis-apex.log" />
                    <label class="form-label" for="collectCorrelation">Référence (incident/opération)</label>
                    <input id="collectCorrelation" class="form-control mb-2" @bind="collectModel.CorrelationReference" placeholder="ex. INC-2026-042" />
                    <button class="btn btn-primary btn-sm" @onclick="CollectAsync" disabled="@isBusy">Tenter la collecte</button>
                </div>
            </div>
            <div class="col-md-6 mb-3">
                <h2>Import manuel</h2>
                <div class="mb-2">
                    <label class="form-label" for="importDomain">Domaine</label>
                    <InputSelect id="importDomain" class="form-select mb-2" @bind-Value="importModel.Domain">
                        @foreach (var d in Enum.GetValues<DiagnosticDomain>())
                        {
                            <option value="@d">@d.ToLabel()</option>
                        }
                    </InputSelect>
                    <label class="form-label" for="importSource">Source</label>
                    <input id="importSource" class="form-control mb-2" @bind="importModel.Source" placeholder="ex. extrait navis-apex.log" />
                    <label class="form-label" for="importCorrelation">Référence (incident/opération)</label>
                    <input id="importCorrelation" class="form-control mb-2" @bind="importModel.CorrelationReference" placeholder="ex. INC-2026-042" />
                    <label class="form-label" for="importContent">Contenu (extrait de journal collé)</label>
                    <textarea id="importContent" class="form-control mb-2" @bind="importModel.Content" rows="3"></textarea>
                    <button class="btn btn-primary btn-sm" @onclick="ImportAsync" disabled="@isBusy">Importer</button>
                </div>
            </div>
        </div>
    </Authorized>
</AuthorizeView>

<h2>Signaux collectés</h2>
@if (signals is null)
{
    <p><em>Chargement...</em></p>
}
else if (signals.Count == 0)
{
    <p>Aucun signal collecté pour cet environnement.</p>
}
else
{
    <div class="table-responsive">
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Domaine</th>
                <th>Source</th>
                <th>Référence</th>
                <th>Origine</th>
                <th>Statut</th>
                <th>Fiabilité</th>
                <th>Collecté le</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var signal in signals)
            {
                <tr class="@(signal.CollectionStatus == DiagnosticSignalCollectionStatus.Unavailable ? "table-warning" : "")">
                    <td>@signal.Domain.ToLabel()</td>
                    <td>@signal.Source</td>
                    <td>@signal.CorrelationReference</td>
                    <td>@(signal.IsManualImport ? "Import manuel" : "Automatique")</td>
                    <td>
                        @signal.CollectionStatus.ToLabel()
                        @if (signal.UnavailableReason is { } reason)
                        {
                            <span> — @reason.ToLabel()</span>
                        }
                    </td>
                    <td>@signal.Reliability.ToLabel()</td>
                    <td>@signal.CollectedAtUtc.ToLocalTime().ToString("g")</td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}

@code {
    [Parameter]
    public Guid EnvironmentId { get; set; }

    private IReadOnlyList<DiagnosticSignalDto>? signals;
    private readonly CollectModel collectModel = new();
    private readonly ImportModel importModel = new();
    private bool isBusy;
    private string? errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        signals = await Mediator.Send(new ListDiagnosticSignalsByEnvironmentQuery(EnvironmentId));
    }

    private async Task CollectAsync()
    {
        errorMessage = null;
        isBusy = true;
        try
        {
            await Mediator.Send(new CollectDiagnosticSignalCommand(
                EnvironmentId, collectModel.Domain, collectModel.Source, collectModel.CorrelationReference, null));
            collectModel.Source = string.Empty;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task ImportAsync()
    {
        errorMessage = null;
        isBusy = true;
        try
        {
            await Mediator.Send(new ImportManualDiagnosticSignalCommand(
                EnvironmentId, importModel.Domain, importModel.Source, importModel.CorrelationReference,
                importModel.Content, DateTime.UtcNow, null));
            importModel.Source = string.Empty;
            importModel.Content = string.Empty;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private sealed class CollectModel
    {
        public DiagnosticDomain Domain { get; set; } = DiagnosticDomain.Network;
        public string Source { get; set; } = string.Empty;
        public string CorrelationReference { get; set; } = string.Empty;
    }

    private sealed class ImportModel
    {
        public DiagnosticDomain Domain { get; set; } = DiagnosticDomain.Network;
        public string Source { get; set; } = string.Empty;
        public string CorrelationReference { get; set; } = string.Empty;
        public string Content { get; set; } = string.Empty;
    }
}
