@page "/admin/sequences/{Id:guid}"
@attribute [Authorize(Roles = Roles.Administrateur)]
@inject IMediator Mediator
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>@(template?.Name ?? "Séquence") — N4 Sentinel</PageTitle>

<div class="breadcrumb">
    <a href="admin/sequences">Séquences d'exploitation</a>
    <span class="breadcrumb-sep">/</span>
    <span>@template?.Name</span>
</div>

@if (errorMessage is not null)
{
    <div class="alert alert-danger mb-4">@errorMessage</div>
}

@if (template is null)
{
    <div class="card loading-block">
        <span class="spinner" aria-hidden="true"></span>
        <span>Chargement…</span>
    </div>
}
else
{
    <div class="page-header">
        <div>
            <h1 class="page-title">@template.Name</h1>
            <p class="page-subtitle">
                @template.TemplateKey · version @template.VersionNumber · @template.WorkflowType.ToLabel()
                @if (template.EnvironmentId is null)
                {
                    <span> · applicable à tous les environnements</span>
                }
            </p>
        </div>
        <div class="page-actions">
            <span class="badge @template.Status.ToBadgeClass()">@template.Status.ToLabel()</span>
        </div>
    </div>

    <div class="card mb-6">
        <div class="card-header">
            <h2 class="card-title">Cycle de validation</h2>
        </div>
        <div class="card-body flex flex-wrap items-center gap-2">
            @if (template.Status == SequenceTemplateStatus.Draft)
            {
                <button type="button" class="btn btn-primary btn-sm"
                        @onclick="() => TransitionAsync(SequenceTemplateTransition.SubmitForValidation)">
                    Soumettre à validation
                </button>
            }
            @if (template.Status == SequenceTemplateStatus.PendingValidation)
            {
                <button type="button" class="btn btn-primary btn-sm"
                        @onclick="() => TransitionAsync(SequenceTemplateTransition.Validate)">
                    Valider
                </button>
            }
            @if (template.Status == SequenceTemplateStatus.Validated)
            {
                <button type="button" class="btn btn-success btn-sm"
                        @onclick="() => TransitionAsync(SequenceTemplateTransition.Activate)">
                    Activer
                </button>
            }
            @if (template.Status != SequenceTemplateStatus.Disabled)
            {
                <button type="button" class="btn btn-outline-danger btn-sm"
                        @onclick="() => TransitionAsync(SequenceTemplateTransition.Disable)">
                    Désactiver
                </button>
            }
            @if (template.Status != SequenceTemplateStatus.Draft)
            {
                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="CreateNewVersionAsync">
                    Créer une nouvelle version
                </button>
                <span class="form-hint">
                    Un ordre validé n'est pas modifiable directement : créez une version pour le faire évoluer.
                </span>
            }
        </div>
    </div>

    <div class="card mb-6">
        <div class="card-header">
            <h2 class="card-title">Paliers (@template.Tiers.Count)</h2>
        </div>
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th class="w-16">Rang</th>
                        <th>Palier</th>
                        <th>Type de composant</th>
                        <th>Exécution</th>
                        <th>Contrôle de réussite</th>
                        <th>Source</th>
                        @if (template.Status == SequenceTemplateStatus.Draft)
                        {
                            <th class="text-right">Actions</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tier in template.Tiers)
                    {
                        <tr>
                            <td class="font-semibold tabular-nums">@tier.Position</td>
                            <td>
                                @tier.Label
                                @if (tier.IsOptional)
                                {
                                    <span class="badge bg-secondary ml-2">conditionnel</span>
                                }
                            </td>
                            <td>
                                @if (tier.Kind == SequenceTierKind.Checkpoint)
                                {
                                    <span class="text-slate-400">— point de contrôle</span>
                                }
                                else
                                {
                                    <span class="badge bg-info">@tier.ComponentKind.ToLabel()</span>
                                }
                            </td>
                            <td>
                                @if (tier.Kind == SequenceTierKind.Checkpoint)
                                {
                                    <span class="text-slate-400">—</span>
                                }
                                else if (tier.Execution == SequenceTierExecution.Sequential)
                                {
                                    <span class="badge bg-info">un par un</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">en parallèle</span>
                                }
                            </td>
                            <td class="text-xs text-slate-600">@tier.SuccessCriteria</td>
                            <td class="text-xs text-slate-400">@tier.SourceReference</td>
                            @if (template.Status == SequenceTemplateStatus.Draft)
                            {
                                <td class="text-right whitespace-nowrap">
                                    <button type="button" class="btn btn-outline-secondary btn-sm"
                                            @onclick="() => MoveAsync(tier.Id, true)" title="Monter">↑</button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm"
                                            @onclick="() => MoveAsync(tier.Id, false)" title="Descendre">↓</button>
                                    <button type="button" class="btn btn-outline-danger btn-sm"
                                            @onclick="() => RemoveAsync(tier.Id)" title="Retirer">✕</button>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (template.Status == SequenceTemplateStatus.Draft)
    {
        <div class="card mb-6">
            <div class="card-header">
                <h2 class="card-title">Ajouter un palier</h2>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label" for="tierKind">Nature</label>
                        <select id="tierKind" class="form-select" @bind="newTierKind">
                            <option value="@SequenceTierKind.ComponentAction">Action sur des composants</option>
                            <option value="@SequenceTierKind.Checkpoint">Point de contrôle (sans composant)</option>
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label" for="tierLabel">Libellé</label>
                        <input id="tierLabel" class="form-control" @bind="newTierLabel"
                               placeholder="ex. Cluster Nodes" />
                    </div>
                </div>

                @if (newTierKind == SequenceTierKind.ComponentAction)
                {
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="tierComponentKind">Type de composant</label>
                            <select id="tierComponentKind" class="form-select" @bind="newTierComponentKind">
                                @foreach (var k in Enum.GetValues<N4ComponentKind>().Where(k => k != N4ComponentKind.Unspecified))
                                {
                                    <option value="@k">@k.ToLabel()</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="tierExecution">Exécution</label>
                            <select id="tierExecution" class="form-select" @bind="newTierExecution">
                                <option value="@SequenceTierExecution.Sequential">Un par un (séquentiel)</option>
                                <option value="@SequenceTierExecution.Parallel">En parallèle</option>
                            </select>
                            <span class="form-hint">
                                Les Cluster Nodes doivent rester séquentiels : barrière ACTIVE au démarrage,
                                redistribution du cache Hazelcast à l'arrêt.
                            </span>
                        </div>
                    </div>
                }

                <div class="row">
                    <div class="col-md-12 mb-3">
                        <label class="form-label" for="tierCriteria">Contrôle de réussite</label>
                        <input id="tierCriteria" class="form-control" @bind="newTierCriteria"
                               placeholder="ex. Statut ACTIVE dans Cluster Services avant de passer au suivant" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label" for="tierSource">Référence documentaire</label>
                        <input id="tierSource" class="form-control" @bind="newTierSource"
                               placeholder="ex. GUIDE p.457" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label" for="tierDelay">Délai de stabilisation (s)</label>
                        <input id="tierDelay" type="number" min="0" class="form-control" @bind="newTierDelay" />
                    </div>
                </div>

                @if (newTierKind == SequenceTierKind.ComponentAction)
                {
                    <div class="form-check mb-4">
                        <input id="tierOptional" type="checkbox" class="form-check-input" @bind="newTierOptional" />
                        <label class="form-check-label" for="tierOptional">
                            Conditionnel — ignoré sans erreur si aucun composant de ce type n'est déclaré
                        </label>
                    </div>
                }

                <button type="button" class="btn btn-primary" @onclick="AddTierAsync">Ajouter le palier</button>
            </div>
        </div>
    }
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private SequenceTemplateDto? template;
    private string? errorMessage;

    private SequenceTierKind newTierKind = SequenceTierKind.ComponentAction;
    private N4ComponentKind newTierComponentKind = N4ComponentKind.ClusterNode;
    private SequenceTierExecution newTierExecution = SequenceTierExecution.Sequential;
    private string newTierLabel = string.Empty;
    private string? newTierCriteria;
    private string? newTierSource;
    private int? newTierDelay;
    private bool newTierOptional;

    protected override async Task OnParametersSetAsync() => await ReloadAsync();

    private async Task ReloadAsync() => template = await Mediator.Send(new GetSequenceTemplateByIdQuery(Id));

    private async Task<string> CurrentUserAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        return state.User.Identity?.Name ?? "Administrateur";
    }

    /// <summary>
    /// Exécute une action et recharge, en affichant proprement les refus du domaine.
    ///
    /// <paramref name="reload"/> vaut <c>false</c> pour les actions qui naviguent vers une autre séquence :
    /// recharger utiliserait l'ancien <see cref="Id"/>, pas encore réaffecté par le routeur, et réécraserait
    /// l'affichage avec la version précédente.
    /// </summary>
    private async Task RunAsync(Func<string, Task> action, bool reload = true)
    {
        errorMessage = null;

        try
        {
            await action(await CurrentUserAsync());

            if (reload)
            {
                await ReloadAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private Task TransitionAsync(SequenceTemplateTransition transition) =>
        RunAsync(user => Mediator.Send(new ChangeSequenceTemplateStatusCommand(Id, transition, user)));

    private Task MoveAsync(Guid tierId, bool up) =>
        RunAsync(user => Mediator.Send(new MoveSequenceTierCommand(Id, tierId, up, user)));

    private Task RemoveAsync(Guid tierId) =>
        RunAsync(user => Mediator.Send(new RemoveSequenceTierCommand(Id, tierId, user)));

    private Task AddTierAsync() => RunAsync(async user =>
    {
        await Mediator.Send(new AddSequenceTierCommand(
            Id,
            newTierKind == SequenceTierKind.Checkpoint ? N4ComponentKind.Unspecified : newTierComponentKind,
            newTierLabel,
            newTierExecution,
            newTierCriteria,
            newTierOptional,
            newTierDelay,
            newTierSource,
            user,
            newTierKind));

        newTierLabel = string.Empty;
        newTierCriteria = null;
        newTierSource = null;
        newTierDelay = null;
        newTierOptional = false;
    });

    private Task CreateNewVersionAsync() => RunAsync(async user =>
    {
        var newId = await Mediator.Send(new CreateSequenceTemplateVersionCommand(Id, user));
        NavigationManager.NavigateTo($"admin/sequences/{newId}");
    }, reload: false);
}
