@page "/environments/{Id:guid}/rolling-restart"
@attribute [Authorize]
@inject IMediator Mediator

<PageTitle>Redémarrage roulant — N4 Sentinel</PageTitle>

<div class="breadcrumb">
    <a href="environments/@Id">Environnement</a>
    <span class="breadcrumb-sep">/</span>
    <span>Redémarrage roulant</span>
</div>

<div class="page-header">
    <div>
        <h1 class="page-title">Redémarrage roulant des Cluster Nodes</h1>
        <p class="page-subtitle">
            Redémarre les nœuds applicatifs par lots successifs en maintenant un nombre minimal de nœuds
            disponibles (FR-042). Les autres composants — Center Node, Bridge, XPS — restent en service.
        </p>
    </div>
</div>

<div class="card mb-6">
    <div class="card-body flex flex-wrap items-end gap-3">
        <div>
            <label class="form-label" for="minimum">Nœuds à maintenir disponibles</label>
            <input id="minimum" type="number" min="1" class="form-control w-40" @bind="minimumAvailable" />
        </div>
        <button type="button" class="btn btn-primary" @onclick="LoadAsync">Calculer les lots</button>
    </div>
</div>

@if (errorMessage is not null)
{
    <div class="alert alert-warning mb-4">@errorMessage</div>
}

@if (plan is not null)
{
    <div class="alert alert-info mb-4">
        <div>
            <p class="font-semibold">
                @plan.TotalNodes nœuds · @plan.Batches.Count lots de @plan.BatchSize ·
                @plan.MinimumAvailable nœuds disponibles en permanence
            </p>
            <p class="mt-1">
                Chaque lot doit être complètement remonté — statut ACTIVE dans Cluster Services — avant
                d'enchaîner sur le suivant.
            </p>
        </div>
    </div>

    <div class="card">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th class="w-16">Lot</th>
                        <th>Nœuds redémarrés</th>
                        <th>Nœuds restant disponibles</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var batch in plan.Batches)
                    {
                        <tr>
                            <td class="font-semibold tabular-nums">@batch.Position</td>
                            <td>
                                @foreach (var name in batch.ComponentNames)
                                {
                                    <span class="badge bg-warning mr-1">@name</span>
                                }
                            </td>
                            <td>
                                @foreach (var name in batch.RemainingAvailableNames)
                                {
                                    <span class="badge bg-success mr-1">@name</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private int minimumAvailable = 1;
    private RollingRestartPlanDto? plan;
    private string? errorMessage;

    private async Task LoadAsync()
    {
        errorMessage = null;
        plan = null;

        try
        {
            plan = await Mediator.Send(new PreviewRollingRestartQuery(Id, minimumAvailable));
        }
        catch (Exception ex)
        {
            // Les refus du domaine expliquent pourquoi le plan est impossible : on les montre tels quels.
            errorMessage = ex.Message;
        }
    }
}
