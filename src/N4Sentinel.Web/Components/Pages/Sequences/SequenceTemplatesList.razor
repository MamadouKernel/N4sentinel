@page "/admin/sequences"
@attribute [Authorize(Roles = Roles.Administrateur)]
@inject IMediator Mediator

<PageTitle>Séquences d'exploitation — N4 Sentinel</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">Séquences d'arrêt et de démarrage</h1>
        <p class="page-subtitle">
            Ordre de traitement des composants N4, configurable par environnement et versionné, conformément
            aux règles générales de séquencement du cahier des charges. Les valeurs livrées reprennent les
            séquences documentées par Navis ; elles restent modifiables.
        </p>
    </div>
</div>

<div class="alert alert-info mb-6">
    <div>
        <p class="font-semibold">Le démarrage n'est pas l'inverse de l'arrêt.</p>
        <p class="mt-1">
            Les deux séquences sont indépendantes : les Cluster Nodes démarrent en premier mais s'arrêtent en
            avant-dernier. Modifier l'une ne modifie pas l'autre.
        </p>
    </div>
</div>

@if (templates is null)
{
    <div class="card loading-block">
        <span class="spinner" aria-hidden="true"></span>
        <span>Chargement des séquences…</span>
    </div>
}
else if (templates.Count == 0)
{
    <div class="empty-state">
        <h2 class="empty-state-title">Aucune séquence définie</h2>
        <p class="empty-state-text">
            Les séquences Navis par défaut sont normalement installées au premier démarrage de l'application.
        </p>
    </div>
}
else
{
    @foreach (var group in templates.GroupBy(t => t.WorkflowType))
    {
        <section class="mb-8">
            <h2 class="section-title mb-3">@group.Key.ToLabel()</h2>

            @foreach (var template in group.OrderByDescending(t => t.VersionNumber))
            {
                <article class="card mb-4">
                    <div class="card-header">
                        <div>
                            <h3 class="card-title">
                                <a href="admin/sequences/@template.Id">@template.Name</a>
                            </h3>
                            <p class="mt-0.5 text-xs text-slate-500">
                                @template.TemplateKey · version @template.VersionNumber ·
                                @(template.EnvironmentId is null ? "tous environnements" : "spécifique à un environnement")
                            </p>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="badge @template.Status.ToBadgeClass()">@template.Status.ToLabel()</span>
                            <a class="btn btn-outline-secondary btn-sm" href="admin/sequences/@template.Id">Configurer</a>
                        </div>
                    </div>

                    <div class="card-body">
                        @if (!string.IsNullOrWhiteSpace(template.Description))
                        {
                            <p class="mb-4 text-sm text-slate-600">@template.Description</p>
                        }

                        <div class="table-responsive">
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th class="w-16">Rang</th>
                                        <th>Palier</th>
                                        <th>Type de composant</th>
                                        <th>Exécution</th>
                                        <th>Contrôle de réussite</th>
                                        <th>Source</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var tier in template.Tiers)
                                    {
                                        <tr>
                                            <td class="font-semibold tabular-nums">@tier.Position</td>
                                            <td>
                                                @tier.Label
                                                @if (tier.IsOptional)
                                                {
                                                    <span class="badge bg-secondary ml-2">conditionnel</span>
                                                }
                                            </td>
                                            <td>
                                                @if (tier.Kind == SequenceTierKind.Checkpoint)
                                                {
                                                    <span class="text-slate-400">— point de contrôle</span>
                                                }
                                                else
                                                {
                                                    <span class="font-mono text-xs">@tier.ComponentKind</span>
                                                }
                                            </td>
                                            <td>
                                                @if (tier.Execution == SequenceTierExecution.Sequential)
                                                {
                                                    <span class="badge bg-info">un par un</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">en parallèle</span>
                                                }
                                            </td>
                                            <td class="text-xs text-slate-600">@tier.SuccessCriteria</td>
                                            <td class="text-xs text-slate-400">@tier.SourceReference</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </article>
            }
        </section>
    }
}

@code {
    private IReadOnlyList<SequenceTemplateDto>? templates;

    protected override async Task OnInitializedAsync()
    {
        templates = await Mediator.Send(new ListSequenceTemplatesQuery());
    }
}
