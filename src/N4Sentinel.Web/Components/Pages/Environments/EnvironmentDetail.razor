@page "/environments/{Id:guid}"
@attribute [Authorize]
@inject IMediator Mediator
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>@(detail?.Name ?? "Environnement") - N4 Sentinel</PageTitle>

@if (detail is null)
{
    <p><em>Chargement...</em></p>
}
else
{
    <h1>
        @detail.Name
        @if (detail.Kind == EnvironmentKind.Production)
        {
            <span class="badge bg-danger ms-2">PRODUCTION</span>
        }
        <span class="badge bg-secondary ms-2">@detail.Status.ToLabel()</span>
    </h1>

    <p>@detail.Description</p>
    <p><strong>Code :</strong> @detail.Code</p>
    <p><a href="environments/@Id/workflows">Workflows de cet environnement →</a></p>
    <p><a href="environments/@Id/operations/new">Nouvelle opération (sélection de scénario) →</a></p>
    <p><a href="environments/@Id/operations">Historique des opérations →</a></p>
    <p><a href="environments/@Id/dependent-systems">Systèmes dépendants →</a></p>
    <p><a href="environments/@Id/supervision">Dossiers partagés & synchronisation →</a></p>
    <p><a href="environments/@Id/edi">Suivi des intégrations EDI →</a></p>
    <p><a href="environments/@Id/diagnostics">Collecte de signaux de diagnostic →</a></p>
    <p><a href="environments/@Id/diagnostic-cases">Cas de diagnostic →</a></p>
    <p><a href="environments/@Id/logs">Journaux techniques →</a></p>
    <p><a href="environments/@Id/sequence-plan">Plan d'arrêt et de démarrage →</a></p>
    <p><a href="environments/@Id/rolling-restart">Redémarrage roulant des Cluster Nodes →</a></p>
    <p><a href="environments/@Id/center-maintenance">Intervention Center / Standby →</a></p>
    <p><a href="environments/@Id/reference-periods">Périodes de référence saines →</a></p>
    <AuthorizeView Roles="@Roles.Administrateur" Context="rolesLinkCtx">
        <Authorized><p><a href="environments/@Id/roles">Rôles par environnement (E11.1b) →</a></p></Authorized>
    </AuthorizeView>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <AuthorizeView Roles="@Roles.Administrateur">
        <Authorized>
            <div class="mb-3 d-flex gap-2">
                <a class="btn btn-outline-secondary btn-sm" href="environments/@Id/edit">Modifier</a>
                <button class="btn btn-outline-secondary btn-sm" @onclick="TestConnectivityAsync" disabled="@isTestingConnectivity">
                    @(isTestingConnectivity ? "Test en cours..." : "Tester la connectivité")
                </button>
                @if (detail.Status == EnvironmentStatus.Draft)
                {
                    <button class="btn btn-outline-primary btn-sm" @onclick="() => ChangeStatusAsync(EnvironmentStatusAction.SubmitForValidation)">Soumettre pour validation</button>
                }
                @if (detail.Status == EnvironmentStatus.PendingValidation)
                {
                    <button class="btn btn-outline-primary btn-sm" @onclick="() => ChangeStatusAsync(EnvironmentStatusAction.Validate)">Valider</button>
                }
                @if (detail.Status == EnvironmentStatus.Validated)
                {
                    <button class="btn btn-outline-success btn-sm" @onclick="() => ChangeStatusAsync(EnvironmentStatusAction.Activate)">Activer</button>
                }
                @if (detail.Status is EnvironmentStatus.Active or EnvironmentStatus.Validated)
                {
                    <button class="btn btn-outline-danger btn-sm" @onclick="() => ChangeStatusAsync(EnvironmentStatusAction.Disable)">Désactiver</button>
                }
            </div>
        </Authorized>
    </AuthorizeView>

    @if (connectivityResults is not null)
    {
        <h2>Résultat du test de connectivité</h2>
        <p class="text-muted">Aucune action mutative n'a été exécutée — contrôle de santé en lecture seule uniquement (FR-007).</p>
        @if (connectivityResults.Count == 0)
        {
            <p>Aucun composant à tester dans cet environnement.</p>
        }
        else
        {
            <div class="table-responsive">
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Composant</th>
                        <th>Rôle</th>
                        <th>Gouvernance</th>
                        <th>État observé</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var result in connectivityResults)
                    {
                        <tr>
                            <td>@result.Name</td>
                            <td>@result.Role</td>
                            <td>@result.Governance.ToLabel()</td>
                            <td>@result.Health.ToLabel()</td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }
    }

    <h2>Composants</h2>

    <AuthorizeView Roles="@Roles.Administrateur">
        <Authorized>
            <a class="btn btn-primary btn-sm mb-3" href="environments/@Id/components/new">Nouveau composant</a>
        </Authorized>
    </AuthorizeView>

    @if (detail.Components.Count == 0)
    {
        <p>Aucun composant enregistré pour cet environnement.</p>
    }
    else
    {
        <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Rôle</th>
                    <th>Type&nbsp;N4</th>
                    <th>Serveur / VM</th>
                    <th>Criticité</th>
                    <th>Gouvernance</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var component in detail.Components)
                {
                    <tr>
                        <td>@component.Name</td>
                        <td>@component.Role</td>
                        <td>
                            @if (component.Kind == N4ComponentKind.Unspecified)
                            {
                                @* Un composant non typé est invisible des séquences d'arrêt/démarrage. *@
                                <span class="badge bg-warning">À typer</span>
                            }
                            else
                            {
                                <span class="badge bg-info">@component.Kind.ToLabel()</span>
                            }
                        </td>
                        <td>@component.HostName</td>
                        <td>@component.Criticality.ToLabel()</td>
                        <td>@component.Governance.ToLabel()</td>
                        <td class="d-flex gap-2">
                            <a class="btn btn-sm btn-outline-secondary" href="environments/@Id/components/@component.Id/supervision">Détail</a>
                            <AuthorizeView Roles="@Roles.Administrateur">
                                <Authorized>
                                    <a class="btn btn-sm btn-outline-secondary" href="environments/@Id/components/@component.Id/edit">Modifier</a>
                                </Authorized>
                            </AuthorizeView>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private EnvironmentDetailDto? detail;
    private string? errorMessage;
    private IReadOnlyList<ComponentConnectivityResultDto>? connectivityResults;
    private bool isTestingConnectivity;

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        detail = await Mediator.Send(new GetEnvironmentByIdQuery(Id));
    }

    private async Task TestConnectivityAsync()
    {
        errorMessage = null;
        isTestingConnectivity = true;
        try
        {
            connectivityResults = await Mediator.Send(new TestEnvironmentConnectivityQuery(Id));
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isTestingConnectivity = false;
        }
    }

    private async Task ChangeStatusAsync(EnvironmentStatusAction action)
    {
        errorMessage = null;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userName = authState.User.Identity?.Name ?? "Administrateur";

            await Mediator.Send(new ChangeEnvironmentStatusCommand(Id, action, userName));
            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }
}
