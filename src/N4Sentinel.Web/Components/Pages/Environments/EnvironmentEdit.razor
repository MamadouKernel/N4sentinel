@page "/environments/{Id:guid}/edit"
@attribute [Authorize]
@inject IMediator Mediator
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IEnvironmentAccessChecker AccessChecker

<PageTitle>Modifier @(model?.Name) - N4 Sentinel</PageTitle>

@if (accessGranted is null)
{
    <p><em>Vérification des droits...</em></p>
}
else if (accessGranted == false)
{
    <div class="alert alert-danger">Accès refusé : le rôle Administrateur est requis sur cet environnement (E11.1b).</div>
}
else if (model is null)
{
    <p><em>Chargement...</em></p>
}
else
{
    <h1>Modifier l'environnement</h1>

    <EditForm Model="model" OnValidSubmit="SubmitAsync" FormName="EditEnvironment">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger" />

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <div class="mb-3">
            <label class="form-label" for="name">Nom</label>
            <InputText id="name" class="form-control" @bind-Value="model.Name" />
        </div>

        <div class="mb-3">
            <label class="form-label" for="description">Description</label>
            <InputTextArea id="description" class="form-control" @bind-Value="model.Description" />
        </div>

        <button type="submit" class="btn btn-primary">Enregistrer</button>
        <a class="btn btn-secondary" href="environments/@Id">Annuler</a>
    </EditForm>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private EditEnvironmentModel? model;
    private string? errorMessage;
    private bool? accessGranted;

    protected override async Task OnParametersSetAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        accessGranted = await AccessChecker.HasAnyRoleAsync(authState.User, Id, Roles.Administrateur);
        if (accessGranted == false)
        {
            return;
        }

        var detail = await Mediator.Send(new GetEnvironmentByIdQuery(Id));
        if (detail is not null)
        {
            model = new EditEnvironmentModel { Name = detail.Name, Description = detail.Description };
        }
    }

    private async Task SubmitAsync()
    {
        if (model is null)
        {
            return;
        }

        errorMessage = null;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userName = authState.User.Identity?.Name ?? "Administrateur";

            await Mediator.Send(new UpdateEnvironmentCommand(Id, model.Name, model.Description, userName));
            NavigationManager.NavigateTo($"environments/{Id}");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private sealed class EditEnvironmentModel
    {
        [Required(ErrorMessage = "Le nom est obligatoire.")]
        public string Name { get; set; } = string.Empty;

        public string? Description { get; set; }
    }
}
