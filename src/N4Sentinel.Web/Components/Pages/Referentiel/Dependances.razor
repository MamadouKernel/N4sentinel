@page "/referentiel/dependances"
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using N4Sentinel.Data
@using N4Sentinel.Domain.Entities
@using N4Sentinel.Domain.Referentiel
@attribute [Authorize(Policy = "Droit:Consulter")]
@inject IDbContextFactory<ApplicationDbContext> Fabrique
@inject IHttpContextAccessor Accesseur

<PageTitle>Graphe de Dépendances — N4 Sentinel Control Room</PageTitle>

<div class="en-tete-page">
    <div>
        <h1>
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="var(--primaire)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="18" cy="5" r="3"/>
                <circle cx="6" cy="12" r="3"/>
                <circle cx="18" cy="19" r="3"/>
                <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/>
                <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
            </svg>
            Graphe de Dépendances N4 — @NomDeLEnvironnement
        </h1>
        <p class="mention">
            §2.4 — Visualisation topologique pour calcul d'ordre de démarrage, vérification des prérequis et analyse d'impact.
        </p>
    </div>
</div>

@if (composants.Count == 0)
{
    <div class="alerte avertissement">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <line x1="12" y1="8" x2="12" y2="12"/>
            <line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
        <span>Aucun composant enregistré sur cet environnement dans le référentiel.</span>
    </div>
}
else if (cycle.Count > 0)
{
    <div class="alerte" role="alert">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="7.86 2 16.14 2 22 7.86 22 16.14 16.14 22 7.86 22 2 16.14 2 7.86 7.86 2"/>
            <line x1="12" y1="8" x2="12" y2="12"/>
            <line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
        <div>
            <strong>Cycle de dépendances circulaire détecté !</strong><br/>
            Chemin : @string.Join(" → ", cycle.Select(NomDe))<br/>
            <em>Aucun ordre de démarrage ou d'arrêt ne peut être calculé tant que ce cycle subsiste.</em>
        </div>
    </div>
}
else
{
    <!-- Visualiseur SVG Graphique de Dépendances -->
    <div class="carte carte-compacte">
        <div class="carte-en-tete carte-en-tete-serree">
            <span class="carte-titre">Diagramme de Flux & Paliers de Démarrage</span>
            <span class="mention">@noeuds.Count nœud(s) cartographié(s)</span>
        </div>

        <div class="defilement cadre-graphe">
            <svg viewBox="0 0 @Largeur @Hauteur" width="@Largeur" height="@Hauteur"
                 class="graphe-dependances" role="img" aria-label="Graphe interactif des dépendances N4">
                
                <defs>
                    <marker id="arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                        <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--primaire)" opacity="0.8"/>
                    </marker>
                    <linearGradient id="nodeGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" stop-color="var(--fond-carte)"/>
                        <stop offset="100%" stop-color="var(--fond-carte-survol)"/>
                    </linearGradient>
                </defs>

                <!-- Connexions Bézier entre les composants -->
                @foreach (var (depuis, vers) in LiensCourbes())
                {
                    <path d="M @depuis.X @depuis.Y C @((depuis.X + vers.X) / 2) @depuis.Y @((depuis.X + vers.X) / 2) @vers.Y @vers.X @vers.Y"
                          class="lien" stroke="var(--primaire)" stroke-opacity="0.45" stroke-width="2" fill="none"
                          marker-end="url(#arrow)" />
                }

                <!-- Nœuds de composants -->
                @foreach (var noeud in noeuds)
                {
                    <g class="noeud-groupe noeud-cliquable">
                        <rect x="@noeud.X" y="@noeud.Y" width="@LargeurBoite" height="@HauteurBoite"
                              class="noeud" fill="url(#nodeGradient)" stroke="var(--bordure-accentuee)" stroke-width="1.5" rx="10" />
                        
                        <text x="@(noeud.X + 14)" y="@(noeud.Y + 22)" class="noeud-titre" fill="var(--texte)" font-size="13" font-weight="700">
                            🖥️ @Tronquer(noeud.Composant.Nom, 20)
                        </text>
                        
                        <text x="@(noeud.X + 14)" y="@(noeud.Y + 40)" fill="var(--primaire)" font-size="11" font-family="var(--police-mono)">
                            @noeud.Composant.Kind
                        </text>
                    </g>
                }
            </svg>
        </div>

        <p class="mention mention-serree-haute">
            💡 <strong>Algorithme Topologique</strong> : Chaque colonne représente un palier de démarrage (les dépendances se lisent de gauche à droite).
        </p>
    </div>

    <!-- Tableau d'ordre de démarrage calculé -->
    <div class="carte">
        <div class="carte-en-tete">
            <h2 class="carte-titre">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="var(--succes)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="8" y1="6" x2="21" y2="6"/>
                    <line x1="8" y1="12" x2="21" y2="12"/>
                    <line x1="8" y1="18" x2="21" y2="18"/>
                    <line x1="3" y1="6" x2="3.01" y2="6"/>
                    <line x1="3" y1="12" x2="3.01" y2="12"/>
                    <line x1="3" y1="18" x2="3.01" y2="18"/>
                </svg>
                Séquence de Démarrage Déterministe Calculée
            </h2>
        </div>

        <div class="defilement">
            <table class="tableau">
                <thead>
                    <tr>
                        <th>Ordre / Rang</th>
                        <th>Nom du Composant</th>
                        <th>Type N4</th>
                        <th>Prérequis Directs Exigés</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var (identifiant, rang) in ordre.Select((id, index) => (id, index + 1)))
                    {
                        <tr>
                            <td>
                                <span class="etat-consolide etat-transition etat-moyen">
                                    Palier #@rang
                                </span>
                            </td>
                            <td><strong>@NomDe(identifiant)</strong></td>
                            <td><span class="mention texte-mono">@(composants.Find(c => c.Id == identifiant)?.Kind)</span></td>
                            <td>
                                <span class="texte-attenue">@Prerequis(identifiant)</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private const int LargeurBoite = 210;
    private const int HauteurBoite = 56;
    private const int EcartColonnes = 270;
    private const int EcartLignes = 82;
    private const int Marge = 24;

    private sealed record Noeud(N4Component Composant, int X, int Y);

    private N4Environment? environnement;
    private List<N4Component> composants = [];
    private List<ComponentDependency> aretes = [];
    private IReadOnlyList<Guid> ordre = [];
    private IReadOnlyList<Guid> cycle = [];
    private List<Noeud> noeuds = [];

    private int Largeur { get; set; } = 500;
    private int Hauteur { get; set; } = 240;

    private string NomDeLEnvironnement => environnement?.Nom ?? "—";

    private string NomDe(Guid id) => composants.Find(c => c.Id == id)?.Nom ?? "?";

    private string Prerequis(Guid id)
    {
        var noms = aretes.Where(d => d.ComponentId == id).Select(d => NomDe(d.ComposantRequisId)).ToList();
        return noms.Count == 0 ? "Aucun (Racine)" : string.Join(", ", noms);
    }

    private static string Tronquer(string valeur, int taille) =>
        valeur.Length <= taille ? valeur : string.Concat(valeur.AsSpan(0, taille - 1), "…");

    private IEnumerable<((int X, int Y) Depuis, (int X, int Y) Vers)> LiensCourbes()
    {
        foreach (var arete in aretes)
        {
            var prerequis = noeuds.Find(n => n.Composant.Id == arete.ComposantRequisId);
            var dependant = noeuds.Find(n => n.Composant.Id == arete.ComponentId);

            if (prerequis is null || dependant is null)
            {
                continue;
            }

            yield return (
                (prerequis.X + LargeurBoite, prerequis.Y + HauteurBoite / 2),
                (dependant.X, dependant.Y + HauteurBoite / 2));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await using var contexte = await Fabrique.CreateDbContextAsync();

        var choisi = Guid.TryParse(Accesseur.HttpContext?.Request.Cookies["environnement"], out var id)
            ? id
            : Guid.Empty;

        environnement = await contexte.Environnements.AsNoTracking().FirstOrDefaultAsync(e => e.Id == choisi)
            ?? await contexte.Environnements.AsNoTracking().OrderBy(e => e.Type).FirstOrDefaultAsync();

        if (environnement is null)
        {
            return;
        }

        composants = await contexte.Composants
            .AsNoTracking()
            .Where(c => c.EnvironmentId == environnement.Id)
            .OrderBy(c => c.Nom)
            .ToListAsync();

        var identifiants = composants.Select(c => c.Id).ToList();

        aretes = await contexte.Dependances
            .AsNoTracking()
            .Where(d => identifiants.Contains(d.ComponentId))
            .ToListAsync();

        var graphe = new GrapheDeDependances(
            identifiants,
            aretes.Select(d => new Dependance(d.ComponentId, d.ComposantRequisId)));

        cycle = graphe.DetecterUnCycle();
        if (cycle.Count > 0)
        {
            return;
        }

        ordre = graphe.OrdreDeDemarrage();
        Disposer(graphe);
    }

    private void Disposer(GrapheDeDependances graphe)
    {
        var niveaux = new Dictionary<Guid, int>();

        foreach (var identifiant in ordre)
        {
            var prerequis = graphe.PrerequisDirectsDe(identifiant);
            niveaux[identifiant] = prerequis.Count == 0
                ? 0
                : prerequis.Max(p => niveaux.TryGetValue(p, out var niveau) ? niveau : 0) + 1;
        }

        var occupation = new Dictionary<int, int>();
        noeuds = [];

        foreach (var identifiant in ordre)
        {
            var composant = composants.Find(c => c.Id == identifiant);
            if (composant is null)
            {
                continue;
            }

            var niveau = niveaux[identifiant];
            occupation.TryGetValue(niveau, out var rang);
            occupation[niveau] = rang + 1;

            noeuds.Add(new Noeud(
                composant,
                Marge + (niveau * EcartColonnes),
                Marge + (rang * EcartLignes)));
        }

        Largeur = Marge + ((niveaux.Count == 0 ? 1 : niveaux.Values.Max() + 1) * EcartColonnes);
        Hauteur = Marge + ((occupation.Count == 0 ? 1 : occupation.Values.Max()) * EcartLignes);
    }
}
