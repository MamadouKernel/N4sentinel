@page "/sops/new"
@attribute [Authorize(Roles = Roles.Operateur + "," + Roles.Administrateur)]
@inject ISender Mediator
@inject NavigationManager NavigationManager

<PageTitle>Nouvelle SOP - N4 Sentinel</PageTitle>

<div class="mx-auto max-w-3xl space-y-6">
    <h1 class="text-2xl font-bold text-slate-900">Nouvelle SOP</h1>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="rounded-md bg-rose-50 p-4 text-sm font-medium text-rose-800 border border-rose-200">@errorMessage</div>
    }

    <EditForm Model="model" OnValidSubmit="SubmitAsync" FormName="CreateSop" class="card space-y-4 p-6">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger" />

        <div>
            <label class="block text-sm font-medium text-slate-700">Identifiant</label>
            <InputText @bind-Value="model.SopKey" class="form-input mt-1 w-full" placeholder="ex. SOP-CLUSTER-RESTART" />
        </div>

        <div>
            <label class="block text-sm font-medium text-slate-700">Titre</label>
            <InputText @bind-Value="model.Title" class="form-input mt-1 w-full" placeholder="ex. Redémarrage contrôlé d'un Cluster Node" />
        </div>

        <div>
            <label class="block text-sm font-medium text-slate-700">Objectif</label>
            <textarea @bind="model.Objective" rows="2" class="form-input mt-1 w-full" placeholder="Ce que la procédure permet d'atteindre"></textarea>
        </div>

        <div>
            <label class="block text-sm font-medium text-slate-700">Prérequis</label>
            <textarea @bind="model.Prerequisites" rows="2" class="form-input mt-1 w-full" placeholder="Conditions à vérifier avant d'exécuter la procédure"></textarea>
        </div>

        <div>
            <label class="block text-sm font-medium text-slate-700">Étapes (une par ligne)</label>
            <textarea @bind="model.StepsText" rows="6" class="form-input mt-1 w-full font-mono text-xs" placeholder="Arrêter le service&#10;Vérifier les logs&#10;Redémarrer le service"></textarea>
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div>
                <label class="block text-sm font-medium text-slate-700">Contrôles</label>
                <textarea @bind="model.Controls" rows="2" class="form-input mt-1 w-full" placeholder="Critères de réussite vérifiables"></textarea>
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700">Risques</label>
                <textarea @bind="model.Risks" rows="2" class="form-input mt-1 w-full" placeholder="Effets de bord possibles"></textarea>
            </div>
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div>
                <label class="block text-sm font-medium text-slate-700">Plan de retour arrière</label>
                <textarea @bind="model.RollbackPlan" rows="2" class="form-input mt-1 w-full"></textarea>
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700">Version N4 (optionnel)</label>
                <InputText @bind-Value="model.N4Version" class="form-input mt-1 w-full" placeholder="ex. 3.8.25" />
            </div>
        </div>

        <div class="flex items-center justify-end gap-3 pt-2 border-t border-slate-200">
            <a href="/sops" class="btn btn-outline-secondary">Annuler</a>
            <button type="submit" class="btn btn-primary">Créer (Brouillon)</button>
        </div>
    </EditForm>
</div>

@code {
    private readonly CreateSopModel model = new();
    private string? errorMessage;

    private async Task SubmitAsync()
    {
        errorMessage = null;
        try
        {
            var id = await Mediator.Send(new CreateSopCommand(
                model.SopKey, model.Title, model.Objective, model.Prerequisites, model.StepsText, model.Controls,
                model.Risks, model.RollbackPlan, model.N4Version));
            NavigationManager.NavigateTo($"/sops/{id}");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private sealed class CreateSopModel
    {
        [Required(ErrorMessage = "L'identifiant est obligatoire.")]
        public string SopKey { get; set; } = string.Empty;

        [Required(ErrorMessage = "Le titre est obligatoire.")]
        public string Title { get; set; } = string.Empty;

        public string Objective { get; set; } = string.Empty;

        public string? Prerequisites { get; set; }

        public string StepsText { get; set; } = string.Empty;

        public string? Controls { get; set; }

        public string? Risks { get; set; }

        public string? RollbackPlan { get; set; }

        public string? N4Version { get; set; }
    }
}
