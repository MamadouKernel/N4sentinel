@page "/sops"
@attribute [Authorize]
@inject ISender Mediator

<PageTitle>SOP - N4 Sentinel</PageTitle>

<div class="space-y-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">Procédures opérationnelles standardisées (SOP)</h1>
            <p class="text-sm text-slate-600">
                Procédures versionnées, validées avant réutilisation, rattachables à un incident ou une opération (FR-089).
            </p>
        </div>
        <AuthorizeView Roles="@($"{Roles.Operateur},{Roles.Administrateur}")" Context="createContext">
            <a href="/sops/new" class="btn btn-primary">Nouvelle SOP</a>
        </AuthorizeView>
    </div>

    <div class="card p-6 space-y-3">
        <h2 class="text-sm font-semibold uppercase text-slate-500">Réutilisation contrôlée (FR-089D)</h2>
        <p class="text-xs text-slate-600">Recherchez une SOP validée par symptôme, composant ou message d'erreur. Le taux de réussite est calculé sur les exécutions réellement terminées.</p>
        <div class="flex gap-2">
            <input @bind="suggestionKeyword" @bind:event="oninput" type="text" class="form-input w-full" placeholder="ex. Cluster Node, ActiveMQ, Bridge..." />
            <button class="btn btn-primary btn-sm" @onclick="SearchSuggestionsAsync">Rechercher</button>
        </div>
        @if (suggestions is not null)
        {
            @if (suggestions.Count == 0)
            {
                <p class="text-sm text-slate-500">Aucune SOP validée ne correspond.</p>
            }
            else
            {
                <div class="space-y-2">
                    @foreach (var s in suggestions)
                    {
                        <div class="flex items-center justify-between rounded-md border border-slate-200 p-3">
                            <div>
                                <a href="/sops/@s.SopId" class="font-semibold text-brand-700 hover:underline">@s.Title (v@s.VersionNumber)</a>
                                <p class="text-xs text-slate-500">
                                    @s.CompletedExecutionCount exécution(s) terminée(s)
                                    @if (s.SuccessRate is not null)
                                    {
                                        <text> — @((s.SuccessRate.Value * 100).ToString("0")) % de réussite</text>
                                    }
                                </p>
                            </div>
                        </div>
                    }
                </div>
            }
        }
    </div>

    @if (sops is null)
    {
        <div class="card p-8 text-center text-slate-500">Chargement...</div>
    }
    else if (sops.Count == 0)
    {
        <div class="card p-8 text-center text-slate-500">Aucune SOP enregistrée.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th class="px-4 py-3">Identifiant</th>
                        <th class="px-4 py-3">Version</th>
                        <th class="px-4 py-3">Titre</th>
                        <th class="px-4 py-3">Version N4</th>
                        <th class="px-4 py-3">Origine</th>
                        <th class="px-4 py-3">Statut</th>
                        <th class="px-4 py-3 text-right">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200">
                    @foreach (var sop in sops)
                    {
                        <tr class="@(sop.Status == SopStatus.Active ? "bg-emerald-50/40" : "")">
                            <td class="px-4 py-3 font-mono text-xs">@sop.SopKey</td>
                            <td class="px-4 py-3">v@(sop.VersionNumber)</td>
                            <td class="px-4 py-3 font-semibold text-brand-900">@sop.Title</td>
                            <td class="px-4 py-3">@(sop.N4Version ?? "—")</td>
                            <td class="px-4 py-3">@(sop.IsGeneratedFromExecution ? "Générée (E9.1)" : "Rédigée")</td>
                            <td class="px-4 py-3">@sop.Status.ToLabel()</td>
                            <td class="px-4 py-3 text-right">
                                <a href="/sops/@sop.Id" class="btn btn-outline-secondary btn-sm">Détail</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private IReadOnlyList<SopDto>? sops;
    private string suggestionKeyword = string.Empty;
    private IReadOnlyList<SopSuggestionDto>? suggestions;

    protected override async Task OnInitializedAsync()
    {
        sops = await Mediator.Send(new ListSopsQuery());
    }

    private async Task SearchSuggestionsAsync()
    {
        suggestions = await Mediator.Send(new SuggestSopsForIncidentQuery(suggestionKeyword));
    }
}
