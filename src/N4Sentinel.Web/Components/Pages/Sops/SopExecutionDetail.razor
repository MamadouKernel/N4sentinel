@page "/sops/executions/{SopExecutionId:guid}"
@attribute [Authorize(Roles = Roles.Operateur + "," + Roles.Administrateur)]
@inject ISender Mediator
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Exécution de SOP - N4 Sentinel</PageTitle>

@if (execution is null)
{
    <div class="card p-8 text-center text-slate-500">Chargement...</div>
}
else
{
    <div class="mx-auto max-w-3xl space-y-6">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">
                Exécution guidée
                <span class="badge @StatusBadgeClass(execution.Status)">@execution.Status.ToLabel()</span>
            </h1>
            <p class="text-sm text-slate-600">
                SOP v@(execution.SopVersionNumber) — démarrée le @execution.StartedAtUtc.ToLocalTime().ToString("g") par @execution.StartedByUserId
            </p>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="rounded-md bg-rose-50 p-4 text-sm font-medium text-rose-800 border border-rose-200">@errorMessage</div>
        }

        <div class="card p-6">
            <h2 class="text-sm font-semibold uppercase text-slate-500">Progression</h2>
            <p class="mt-1 text-sm text-slate-900">@execution.StepConfirmations.Count / @execution.TotalStepCount étape(s) confirmée(s)</p>
        </div>

        @if (execution.StepConfirmations.Count > 0)
        {
            <div class="space-y-2">
                @foreach (var confirmation in execution.StepConfirmations)
                {
                    <div class="card p-4 @(confirmation.IsDeviation ? "border-amber-300" : "")">
                        <p class="text-sm font-semibold text-slate-900">@(confirmation.StepIndex + 1). @confirmation.StepText</p>
                        <p class="text-xs text-slate-500">Confirmée par @confirmation.ConfirmedByUserId le @confirmation.ConfirmedAtUtc.ToLocalTime().ToString("g")</p>
                        @if (!string.IsNullOrEmpty(confirmation.Proof))
                        {
                            <p class="mt-1 text-xs text-slate-700"><strong>Preuve :</strong> @confirmation.Proof</p>
                        }
                        @if (confirmation.IsDeviation)
                        {
                            <p class="mt-1 text-xs text-amber-800 bg-amber-50 p-2 rounded border border-amber-100"><strong>Écart :</strong> @confirmation.DeviationComment</p>
                        }
                    </div>
                }
            </div>
        }

        @if (execution.Status == SopExecutionStatus.InProgress)
        {
            @if (execution.NextStepText is not null)
            {
                <div class="card p-6 space-y-4 bg-slate-50 border-brand-200">
                    <h2 class="text-lg font-bold text-slate-900">Prochaine étape</h2>
                    <p class="text-sm font-semibold text-slate-900">@execution.NextStepText</p>

                    <div>
                        <label class="block text-sm font-medium text-slate-700">Preuve (optionnel)</label>
                        <input @bind="proof" type="text" class="form-input mt-1 w-full" placeholder="Capture, extrait de log, référence..." />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-slate-700">Écart constaté (optionnel)</label>
                        <textarea @bind="deviationComment" rows="2" class="form-input mt-1 w-full" placeholder="Décrivez tout écart par rapport à l'étape décrite"></textarea>
                    </div>

                    <div class="flex flex-wrap gap-2 pt-2 border-t border-slate-200">
                        <button class="btn btn-primary btn-sm" @onclick="ConfirmStepAsync">Confirmer cette étape</button>
                        @if (execution.StepConfirmations.Count > 0)
                        {
                            <button class="btn btn-outline-secondary btn-sm" @onclick="GoBackAsync">← Revenir à l'étape précédente</button>
                        }
                        <button class="btn btn-outline-danger btn-sm" @onclick="() => showAbortForm = !showAbortForm">Abandonner</button>
                    </div>

                    @if (showAbortForm)
                    {
                        <div class="space-y-2 pt-2 border-t border-slate-200">
                            <textarea @bind="abortReason" rows="2" class="form-input w-full" placeholder="Motif d'abandon"></textarea>
                            <button class="btn btn-danger btn-sm" @onclick="AbortAsync">Confirmer l'abandon</button>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="card p-6 space-y-4 bg-emerald-50/40 border-emerald-200">
                    <h2 class="text-lg font-bold text-emerald-900">Toutes les étapes sont confirmées</h2>
                    <p class="text-sm text-slate-700">La procédure a-t-elle résolu le problème ? (FR-089A)</p>
                    <div class="flex gap-2">
                        <button class="btn btn-success btn-sm" @onclick="() => CompleteAsync(true)">Oui, problème résolu</button>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="() => CompleteAsync(false)">Non, problème persistant</button>
                    </div>
                </div>
            }
        }
        else if (execution.Status == SopExecutionStatus.Completed && execution.ResolvedIssue == true)
        {
            <div class="card p-6 space-y-4">
                <h2 class="text-lg font-bold text-slate-900">Générer une SOP à partir de cette exécution (FR-089A/FR-097)</h2>
                <p class="text-xs text-slate-600">Crée une nouvelle SOP en Brouillon reprenant les étapes réellement confirmées.</p>
                @if (!showGenerateForm)
                {
                    <button class="btn btn-primary btn-sm" @onclick="() => showGenerateForm = true">Générer une SOP</button>
                }
                else
                {
                    <EditForm Model="generateModel" OnValidSubmit="GenerateSopAsync" FormName="GenerateSop" class="space-y-3">
                        <div>
                            <label class="block text-sm font-medium text-slate-700">Identifiant de la nouvelle SOP</label>
                            <InputText @bind-Value="generateModel.SopKey" class="form-input mt-1 w-full" placeholder="ex. SOP-EDI-RETRY-GENEREE" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-slate-700">Titre</label>
                            <InputText @bind-Value="generateModel.Title" class="form-input mt-1 w-full" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-slate-700">Objectif</label>
                            <textarea @bind="generateModel.Objective" rows="2" class="form-input mt-1 w-full"></textarea>
                        </div>
                        <button type="submit" class="btn btn-success btn-sm">Créer la SOP (Brouillon)</button>
                    </EditForm>
                }
            </div>
        }
    </div>
}

@code {
    [Parameter] public Guid SopExecutionId { get; set; }

    private SopExecutionDto? execution;
    private string proof = string.Empty;
    private string deviationComment = string.Empty;
    private bool showAbortForm;
    private string abortReason = string.Empty;
    private bool showGenerateForm;
    private readonly GenerateModel generateModel = new();
    private string? errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        execution = await Mediator.Send(new GetSopExecutionByIdQuery(SopExecutionId));
    }

    private async Task<string> GetCurrentUserNameAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        return authState.User.Identity?.Name ?? "Opérateur";
    }

    private async Task ConfirmStepAsync()
    {
        errorMessage = null;
        try
        {
            var userName = await GetCurrentUserNameAsync();
            await Mediator.Send(new ConfirmSopExecutionStepCommand(
                SopExecutionId, userName, string.IsNullOrWhiteSpace(proof) ? null : proof,
                string.IsNullOrWhiteSpace(deviationComment) ? null : deviationComment));

            proof = string.Empty;
            deviationComment = string.Empty;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task GoBackAsync()
    {
        errorMessage = null;
        try
        {
            await Mediator.Send(new GoBackSopExecutionStepCommand(SopExecutionId));
            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task AbortAsync()
    {
        if (string.IsNullOrWhiteSpace(abortReason))
        {
            errorMessage = "Le motif d'abandon est obligatoire.";
            return;
        }

        errorMessage = null;
        try
        {
            await Mediator.Send(new AbortSopExecutionCommand(SopExecutionId, abortReason));
            showAbortForm = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task CompleteAsync(bool resolvedIssue)
    {
        errorMessage = null;
        try
        {
            await Mediator.Send(new CompleteSopExecutionCommand(SopExecutionId, resolvedIssue));
            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task GenerateSopAsync()
    {
        errorMessage = null;
        try
        {
            var newSopId = await Mediator.Send(new GenerateSopFromExecutionCommand(
                SopExecutionId, generateModel.SopKey, generateModel.Title, generateModel.Objective, null, null, null, null, null));
            NavigationManager.NavigateTo($"/sops/{newSopId}");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private static string StatusBadgeClass(SopExecutionStatus status) => status switch
    {
        SopExecutionStatus.InProgress => "bg-blue-100 text-blue-800",
        SopExecutionStatus.Completed => "bg-emerald-100 text-emerald-800",
        SopExecutionStatus.Aborted => "bg-slate-800 text-white",
        _ => "bg-slate-100 text-slate-800",
    };

    private sealed class GenerateModel
    {
        [Required] public string SopKey { get; set; } = string.Empty;
        [Required] public string Title { get; set; } = string.Empty;
        public string Objective { get; set; } = string.Empty;
    }
}
