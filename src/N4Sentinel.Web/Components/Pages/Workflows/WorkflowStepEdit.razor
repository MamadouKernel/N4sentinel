@page "/environments/{EnvironmentId:guid}/workflows/{WorkflowId:guid}/versions/{VersionId:guid}/steps/{StepId:guid}/edit"
@attribute [Authorize(Roles = Roles.Administrateur)]
@inject IMediator Mediator
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Modifier l'étape - N4 Sentinel</PageTitle>

<h1>Modifier l'étape</h1>

@if (components is null || model is null)
{
    <p><em>Chargement...</em></p>
}
else
{
    <EditForm Model="model" OnValidSubmit="SubmitAsync" FormName="EditWorkflowStep">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger" />

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <div class="mb-3">
            <label class="form-label" for="name">Nom</label>
            <InputText id="name" class="form-control" @bind-Value="model.Name" />
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label" for="action">Action</label>
                <InputSelect id="action" class="form-select" @bind-Value="model.Action">
                    @foreach (var a in Enum.GetValues<WorkflowStepAction>())
                    {
                        <option value="@a">@a.ToLabel()</option>
                    }
                </InputSelect>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label" for="component">Composant ciblé (optionnel)</label>
                <InputSelect id="component" class="form-select" @bind-Value="model.ComponentId">
                    <option value="">— Aucun —</option>
                    @foreach (var c in components)
                    {
                        <option value="@c.Id">@c.Name (@c.Role)</option>
                    }
                </InputSelect>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label" for="successCriteria">Critère de réussite</label>
            <InputText id="successCriteria" class="form-control" @bind-Value="model.SuccessCriteria" />
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label" for="expectedDuration">Durée normale (s)</label>
                <InputNumber id="expectedDuration" class="form-control" @bind-Value="model.ExpectedDurationSeconds" />
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label" for="warningThreshold">Seuil d'avertissement (s)</label>
                <InputNumber id="warningThreshold" class="form-control" @bind-Value="model.WarningThresholdSeconds" />
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label" for="timeout">Timeout maximal (s)</label>
                <InputNumber id="timeout" class="form-control" @bind-Value="model.TimeoutSeconds" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label" for="maxRetry">Tentatives maximales</label>
                <InputNumber id="maxRetry" class="form-control" @bind-Value="model.MaxRetryAttempts" />
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label" for="retryDelay">Délai entre tentatives (s)</label>
                <InputNumber id="retryDelay" class="form-control" @bind-Value="model.RetryDelaySeconds" />
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label" for="failurePolicy">Politique en cas d'échec</label>
                <InputSelect id="failurePolicy" class="form-select" @bind-Value="model.OnFailurePolicy">
                    @foreach (var p in Enum.GetValues<WorkflowStepFailurePolicy>())
                    {
                        <option value="@p">@p.ToLabel()</option>
                    }
                </InputSelect>
            </div>
        </div>

        <div class="form-check mb-2">
            <InputCheckbox id="isCritical" class="form-check-input" @bind-Value="model.IsCriticalOrDestructive" />
            <label class="form-check-label" for="isCritical">Action critique ou destructrice</label>
        </div>
        <div class="form-check mb-2">
            <InputCheckbox id="retryAuto" class="form-check-input" @bind-Value="model.RetryIsAutomatic" />
            <label class="form-check-label" for="retryAuto">Nouvelle tentative automatique</label>
        </div>
        @if (model.IsCriticalOrDestructive && model.RetryIsAutomatic)
        {
            <div class="form-check mb-2 ms-3">
                <InputCheckbox id="retryAuthorized" class="form-check-input" @bind-Value="model.AutomaticRetryExplicitlyAuthorized" />
                <label class="form-check-label" for="retryAuthorized">
                    J'autorise explicitement la nouvelle tentative automatique malgré le caractère critique/destructeur (FR-004)
                </label>
            </div>
        }
        <div class="form-check mb-2">
            <InputCheckbox id="requiresConfirmation" class="form-check-input" @bind-Value="model.RequiresConfirmation" />
            <label class="form-check-label" for="requiresConfirmation">Nécessite une confirmation</label>
        </div>
        <div class="form-check mb-3">
            <InputCheckbox id="requiresApproval" class="form-check-input" @bind-Value="model.RequiresApproval" />
            <label class="form-check-label" for="requiresApproval">Nécessite une approbation</label>
        </div>

        @if (otherSteps is { Count: > 0 })
        {
            <div class="mb-3">
                <label class="form-label">Prérequis (étapes devant réussir avant celle-ci)</label>
                @foreach (var candidate in otherSteps)
                {
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="@("prereq-" + candidate.Id)"
                               checked="@selectedPrerequisiteIds.Contains(candidate.Id)"
                               @onchange="e => TogglePrerequisite(candidate.Id, (bool)e.Value!)" />
                        <label class="form-check-label" for="@("prereq-" + candidate.Id)">@candidate.Name</label>
                    </div>
                }
            </div>
        }

        <button type="submit" class="btn btn-primary">Enregistrer</button>
        <a class="btn btn-secondary" href="environments/@EnvironmentId/workflows/@WorkflowId/versions/@VersionId/steps">Annuler</a>
    </EditForm>
}

@code {
    [Parameter]
    public Guid EnvironmentId { get; set; }

    [Parameter]
    public Guid WorkflowId { get; set; }

    [Parameter]
    public Guid VersionId { get; set; }

    [Parameter]
    public Guid StepId { get; set; }

    private EditStepModel? model;
    private readonly HashSet<Guid> selectedPrerequisiteIds = [];
    private IReadOnlyList<ComponentDto>? components;
    private IReadOnlyList<WorkflowStepDto>? otherSteps;
    private string? errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        components = await Mediator.Send(new ListComponentsByEnvironmentQuery(EnvironmentId));
        var workflow = await Mediator.Send(new GetWorkflowByIdQuery(WorkflowId));
        var allSteps = workflow?.Versions.FirstOrDefault(v => v.Id == VersionId)?.Steps ?? [];
        otherSteps = allSteps.Where(s => s.Id != StepId).ToList();

        var current = allSteps.FirstOrDefault(s => s.Id == StepId);
        if (current is not null)
        {
            model = new EditStepModel
            {
                Name = current.Name,
                ComponentId = current.ComponentId?.ToString(),
                Action = current.Action,
                SuccessCriteria = current.SuccessCriteria,
                ExpectedDurationSeconds = current.ExpectedDurationSeconds,
                WarningThresholdSeconds = current.WarningThresholdSeconds,
                TimeoutSeconds = current.TimeoutSeconds,
                MaxRetryAttempts = current.MaxRetryAttempts,
                RetryIsAutomatic = current.RetryIsAutomatic,
                AutomaticRetryExplicitlyAuthorized = current.AutomaticRetryExplicitlyAuthorized,
                RetryDelaySeconds = current.RetryDelaySeconds,
                OnFailurePolicy = current.OnFailurePolicy,
                RequiresConfirmation = current.RequiresConfirmation,
                RequiresApproval = current.RequiresApproval,
                IsCriticalOrDestructive = current.IsCriticalOrDestructive,
            };

            selectedPrerequisiteIds.Clear();
            foreach (var id in current.PrerequisiteStepIds)
            {
                selectedPrerequisiteIds.Add(id);
            }
        }
    }

    private void TogglePrerequisite(Guid stepId, bool isSelected)
    {
        if (isSelected)
        {
            selectedPrerequisiteIds.Add(stepId);
        }
        else
        {
            selectedPrerequisiteIds.Remove(stepId);
        }
    }

    private async Task SubmitAsync()
    {
        if (model is null)
        {
            return;
        }

        errorMessage = null;
        try
        {
            Guid? componentId = string.IsNullOrEmpty(model.ComponentId) ? null : Guid.Parse(model.ComponentId);
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userName = authState.User.Identity?.Name ?? "Administrateur";

            await Mediator.Send(new UpdateWorkflowStepCommand(
                WorkflowId, VersionId, StepId, model.Name, componentId, model.Action, selectedPrerequisiteIds,
                model.SuccessCriteria, model.ExpectedDurationSeconds, model.WarningThresholdSeconds,
                model.TimeoutSeconds, model.MaxRetryAttempts, model.RetryIsAutomatic,
                model.AutomaticRetryExplicitlyAuthorized, model.RetryDelaySeconds, model.OnFailurePolicy,
                model.RequiresConfirmation, model.RequiresApproval, model.IsCriticalOrDestructive, userName));

            NavigationManager.NavigateTo($"environments/{EnvironmentId}/workflows/{WorkflowId}/versions/{VersionId}/steps");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private sealed class EditStepModel
    {
        [Required(ErrorMessage = "Le nom est obligatoire.")]
        public string Name { get; set; } = string.Empty;

        public string? ComponentId { get; set; }

        public WorkflowStepAction Action { get; set; }

        public string? SuccessCriteria { get; set; }

        public int? ExpectedDurationSeconds { get; set; }

        public int? WarningThresholdSeconds { get; set; }

        public int? TimeoutSeconds { get; set; }

        public int MaxRetryAttempts { get; set; }

        public bool RetryIsAutomatic { get; set; }

        public bool AutomaticRetryExplicitlyAuthorized { get; set; }

        public int? RetryDelaySeconds { get; set; }

        public WorkflowStepFailurePolicy OnFailurePolicy { get; set; }

        public bool RequiresConfirmation { get; set; }

        public bool RequiresApproval { get; set; }

        public bool IsCriticalOrDestructive { get; set; }
    }
}
