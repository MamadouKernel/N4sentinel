@page "/environments/{EnvironmentId:guid}/workflows/{WorkflowId:guid}"
@attribute [Authorize]
@inject IMediator Mediator

<PageTitle>@(detail?.Name ?? "Workflow") - N4 Sentinel</PageTitle>

@if (detail is null)
{
    <p><em>Chargement...</em></p>
}
else
{
    <h1>@detail.Name</h1>
    <p>
        <span class="badge bg-info text-dark">@detail.Type.ToLabel()</span>
        <span class="badge bg-secondary">@detail.Scope.ToLabel()</span>
    </p>
    <p><a href="environments/@EnvironmentId/workflows">← Retour aux workflows</a></p>
    <p><a href="environments/@EnvironmentId/workflows/@WorkflowId/simulations">Historique des simulations →</a></p>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <AuthorizeView Roles="@Roles.Administrateur">
        <Authorized>
            @if (detail.Versions.Count > 0 && detail.Versions[^1].Status != WorkflowVersionStatus.Draft)
            {
                <button class="btn btn-outline-primary btn-sm mb-3" @onclick="CreateNewDraftVersionAsync">
                    Créer une nouvelle version (à partir de la v@(detail.Versions[^1].VersionNumber))
                </button>
            }
        </Authorized>
    </AuthorizeView>

    <h2>Versions</h2>
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Version</th>
                <th>Statut</th>
                <th>Étapes</th>
                <th>Retour arrière</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var version in detail.Versions.OrderByDescending(v => v.VersionNumber))
            {
                <tr>
                    <td>v@(version.VersionNumber)</td>
                    <td>@version.Status.ToLabel()</td>
                    <td>@version.Steps.Count</td>
                    <td>@(version.AllowsRollback ? "Oui" : "Non")</td>
                    <td class="d-flex gap-1 flex-wrap">
                        <a class="btn btn-sm btn-outline-secondary" href="environments/@EnvironmentId/workflows/@WorkflowId/versions/@version.Id/steps">
                            @(version.Status == WorkflowVersionStatus.Draft ? "Gérer les étapes" : "Voir les étapes")
                        </a>
                        <AuthorizeView Roles="@Roles.Administrateur" Context="adminCtx">
                            <Authorized>
                                @if (version.Status == WorkflowVersionStatus.Draft)
                                {
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => ChangeStatusAsync(version.Id, WorkflowVersionStatusAction.SubmitForValidation)">Soumettre</button>
                                }
                                @if (version.Status == WorkflowVersionStatus.PendingValidation)
                                {
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => ChangeStatusAsync(version.Id, WorkflowVersionStatusAction.Validate)">Valider</button>
                                }
                                @if (version.Status == WorkflowVersionStatus.Validated)
                                {
                                    <button class="btn btn-sm btn-outline-success" @onclick="() => ChangeStatusAsync(version.Id, WorkflowVersionStatusAction.Activate)">Activer</button>
                                }
                                @if (version.Status is WorkflowVersionStatus.Active or WorkflowVersionStatus.Validated)
                                {
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => ChangeStatusAsync(version.Id, WorkflowVersionStatusAction.Disable)">Désactiver</button>
                                }
                            </Authorized>
                        </AuthorizeView>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [Parameter]
    public Guid EnvironmentId { get; set; }

    [Parameter]
    public Guid WorkflowId { get; set; }

    private WorkflowDetailDto? detail;
    private string? errorMessage;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        detail = await Mediator.Send(new GetWorkflowByIdQuery(WorkflowId));
    }

    private async Task ChangeStatusAsync(Guid versionId, WorkflowVersionStatusAction action)
    {
        errorMessage = null;
        try
        {
            await Mediator.Send(new ChangeWorkflowVersionStatusCommand(WorkflowId, versionId, action));
            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task CreateNewDraftVersionAsync()
    {
        errorMessage = null;
        try
        {
            await Mediator.Send(new CreateNewDraftVersionCommand(WorkflowId));
            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }
}
