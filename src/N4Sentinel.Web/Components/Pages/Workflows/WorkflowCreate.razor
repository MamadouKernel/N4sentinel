@page "/environments/{EnvironmentId:guid}/workflows/new"
@attribute [Authorize]
@inject IMediator Mediator
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IEnvironmentAccessChecker AccessChecker

<PageTitle>Nouveau workflow - N4 Sentinel</PageTitle>

<h1>Nouveau workflow</h1>

@if (accessGranted is null)
{
    <p><em>Vérification des droits...</em></p>
}
else if (accessGranted == false)
{
    <div class="alert alert-danger">Accès refusé : le rôle Administrateur est requis sur cet environnement (E11.1b).</div>
}
else if (components is null)
{
    <p><em>Chargement...</em></p>
}
else
{
    <EditForm Model="model" OnValidSubmit="SubmitAsync" FormName="CreateWorkflow">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger" />

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <div class="mb-3">
            <label class="form-label" for="name">Nom</label>
            <InputText id="name" class="form-control" @bind-Value="model.Name" />
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label" for="type">Type</label>
                <InputSelect id="type" class="form-select" @bind-Value="model.Type">
                    @foreach (var t in Enum.GetValues<WorkflowType>())
                    {
                        <option value="@t">@t.ToLabel()</option>
                    }
                </InputSelect>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label" for="scope">Périmètre</label>
                <InputSelect id="scope" class="form-select" @bind-Value="model.Scope">
                    @foreach (var s in Enum.GetValues<WorkflowScope>())
                    {
                        <option value="@s">@s.ToLabel()</option>
                    }
                </InputSelect>
            </div>
        </div>

        @if (model.Scope != WorkflowScope.Full)
        {
            <div class="mb-3">
                <label class="form-label">Composants cibles</label>
                @if (components.Count == 0)
                {
                    <p class="text-muted">Aucun composant enregistré dans cet environnement.</p>
                }
                @foreach (var component in components)
                {
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="@("target-" + component.Id)"
                               checked="@selectedTargetIds.Contains(component.Id)"
                               @onchange="e => ToggleTarget(component.Id, (bool)e.Value!)" />
                        <label class="form-check-label" for="@("target-" + component.Id)">@component.Name (@component.Role)</label>
                    </div>
                }
            </div>
        }

        <button type="submit" class="btn btn-primary">Créer</button>
        <a class="btn btn-secondary" href="environments/@EnvironmentId/workflows">Annuler</a>
    </EditForm>
}

@code {
    [Parameter]
    public Guid EnvironmentId { get; set; }

    private readonly CreateWorkflowModel model = new();
    private readonly HashSet<Guid> selectedTargetIds = [];
    private IReadOnlyList<ComponentDto>? components;
    private string? errorMessage;
    private bool? accessGranted;

    protected override async Task OnParametersSetAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        accessGranted = await AccessChecker.HasAnyRoleAsync(authState.User, EnvironmentId, Roles.Administrateur);
        if (accessGranted == false)
        {
            return;
        }

        components = await Mediator.Send(new ListComponentsByEnvironmentQuery(EnvironmentId));
    }

    private void ToggleTarget(Guid componentId, bool isSelected)
    {
        if (isSelected)
        {
            selectedTargetIds.Add(componentId);
        }
        else
        {
            selectedTargetIds.Remove(componentId);
        }
    }

    private async Task SubmitAsync()
    {
        errorMessage = null;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userName = authState.User.Identity?.Name ?? "Administrateur";

            var id = await Mediator.Send(new CreateWorkflowCommand(
                EnvironmentId, model.Name, model.Type, model.Scope, selectedTargetIds, userName));
            NavigationManager.NavigateTo($"environments/{EnvironmentId}/workflows/{id}");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private sealed class CreateWorkflowModel
    {
        [Required(ErrorMessage = "Le nom est obligatoire.")]
        public string Name { get; set; } = string.Empty;

        public WorkflowType Type { get; set; } = WorkflowType.Start;

        public WorkflowScope Scope { get; set; } = WorkflowScope.Full;
    }
}
