@page "/environments/{EnvironmentId:guid}/supervision/sync-endpoints/new"
@attribute [Authorize(Roles = Roles.Administrateur)]
@inject IMediator Mediator
@inject NavigationManager NavigationManager

<PageTitle>Nouveau point de synchronisation - N4 Sentinel</PageTitle>

<h1>Nouveau point de synchronisation</h1>

<EditForm Model="model" OnValidSubmit="SubmitAsync" FormName="CreateSyncEndpoint">
    <DataAnnotationsValidator />
    <ValidationSummary class="text-danger" />

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <div class="mb-3">
        <label class="form-label" for="name">Nom</label>
        <InputText id="name" class="form-control" @bind-Value="model.Name" placeholder="ex. Bridge Queue, N4-XPS Sync..." />
    </div>

    <button type="submit" class="btn btn-primary">Créer</button>
    <a class="btn btn-secondary" href="environments/@EnvironmentId/supervision">Annuler</a>
</EditForm>

@code {
    [Parameter]
    public Guid EnvironmentId { get; set; }

    private readonly CreateSyncEndpointModel model = new();
    private string? errorMessage;

    private async Task SubmitAsync()
    {
        errorMessage = null;
        try
        {
            await Mediator.Send(new CreateSyncEndpointCommand(EnvironmentId, model.Name));
            NavigationManager.NavigateTo($"environments/{EnvironmentId}/supervision");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private sealed class CreateSyncEndpointModel
    {
        [Required(ErrorMessage = "Le nom est obligatoire.")]
        public string Name { get; set; } = string.Empty;
    }
}
