@page "/environments/{EnvironmentId:guid}/supervision"
@attribute [Authorize]
@inject IMediator Mediator

<PageTitle>Supervision - N4 Sentinel</PageTitle>

<h1>Supervision — dossiers partagés & synchronisation</h1>
<p><a href="environments/@EnvironmentId">← Retour à l'environnement</a></p>
<p class="text-muted">
    Anomalies des dossiers partagés (E5.1) et synchronisation N4/Bridge/XPS/ActiveMQ/KahaDB (E5.3) — supervision
    en lecture seule, vérification déclenchée manuellement, jamais automatique.
</p>

<h2>Dossiers partagés</h2>
<AuthorizeView Roles="@Roles.Administrateur">
    <Authorized>
        <a class="btn btn-primary btn-sm mb-3" href="environments/@EnvironmentId/supervision/shared-folders/new">Nouveau dossier partagé</a>
    </Authorized>
</AuthorizeView>

@if (sharedFolders is null)
{
    <p><em>Chargement...</em></p>
}
else if (sharedFolders.Count == 0)
{
    <p>Aucun dossier partagé cartographié pour cet environnement.</p>
}
else
{
    <div class="table-responsive">
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Catégorie</th>
                <th>Chemin</th>
                <th>Capacité</th>
                <th>Structure</th>
                <th>Corruption</th>
                <th>Dernière vérification</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var folder in sharedFolders)
            {
                <tr class="@(folder.HasAnomaly ? "table-danger" : "")">
                    <td>@folder.Name</td>
                    <td>@folder.Category.ToLabel()</td>
                    <td>@folder.Path</td>
                    <td>@(folder.UsedCapacityPercent is { } cap ? $"{cap}%" : "—")</td>
                    <td>@(folder.StructureValid ? "OK" : "Invalide")</td>
                    <td>@folder.CorruptionStatus.ToLabel()</td>
                    <td>@(folder.LastCheckedUtc?.ToLocalTime().ToString("g") ?? "Jamais vérifié")</td>
                    <td>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => CheckSharedFolderAsync(folder.Id)" disabled="@isChecking">
                            Vérifier
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}

<h2>Synchronisation N4/Bridge/XPS & ActiveMQ/KahaDB</h2>
<AuthorizeView Roles="@Roles.Administrateur">
    <Authorized>
        <a class="btn btn-primary btn-sm mb-3" href="environments/@EnvironmentId/supervision/sync-endpoints/new">Nouveau point de synchronisation</a>
    </Authorized>
</AuthorizeView>

@if (syncEndpoints is null)
{
    <p><em>Chargement...</em></p>
}
else if (syncEndpoints.Count == 0)
{
    <p>Aucun point de synchronisation cartographié pour cet environnement.</p>
}
else
{
    <div class="table-responsive">
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Taille de file</th>
                <th>Consommateurs</th>
                <th>Dernier échange normal</th>
                <th>Dernière vérification</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var endpoint in syncEndpoints)
            {
                <tr class="@(endpoint.HasAnomaly ? "table-danger" : "")">
                    <td>@endpoint.Name</td>
                    <td>@(endpoint.QueueSize?.ToString() ?? "—")</td>
                    <td>@(endpoint.ConsumerCount?.ToString() ?? "—")</td>
                    <td>@(endpoint.LastNormalExchangeUtc?.ToLocalTime().ToString("g") ?? "—")</td>
                    <td>@(endpoint.LastCheckedUtc?.ToLocalTime().ToString("g") ?? "Jamais vérifié")</td>
                    <td>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => CheckSyncEndpointAsync(endpoint.Id)" disabled="@isChecking">
                            Vérifier
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

@code {
    [Parameter]
    public Guid EnvironmentId { get; set; }

    private IReadOnlyList<SharedFolderDto>? sharedFolders;
    private IReadOnlyList<SyncEndpointDto>? syncEndpoints;
    private bool isChecking;
    private string? errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        sharedFolders = await Mediator.Send(new ListSharedFoldersByEnvironmentQuery(EnvironmentId));
        syncEndpoints = await Mediator.Send(new ListSyncEndpointsByEnvironmentQuery(EnvironmentId));
    }

    private async Task CheckSharedFolderAsync(Guid folderId)
    {
        errorMessage = null;
        isChecking = true;
        try
        {
            await Mediator.Send(new CheckSharedFolderCommand(folderId));
            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isChecking = false;
        }
    }

    private async Task CheckSyncEndpointAsync(Guid endpointId)
    {
        errorMessage = null;
        isChecking = true;
        try
        {
            await Mediator.Send(new CheckSyncEndpointCommand(endpointId));
            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isChecking = false;
        }
    }
}
