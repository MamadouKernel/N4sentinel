@page "/environments/{EnvironmentId:guid}/supervision/shared-folders/{SharedFolderId:guid}/reconstitution"
@attribute [Authorize]
@inject IMediator Mediator

<PageTitle>Reconstitution - N4 Sentinel</PageTitle>

<h1>Reconstitution sécurisée du dossier partagé</h1>
<p><a href="environments/@EnvironmentId/supervision">← Retour à la supervision</a></p>
<p class="text-muted">
    Séquence fixe imposée par FR-059E : arrêt des composants, sauvegarde, vérification de l'intégrité de la
    sauvegarde, reconstitution, redémarrage contrôlé, tests finaux — chaque étape exige une confirmation
    explicite et peut porter une preuve (FR-059F). Aucune action réelle de fichier ou de service n'est
    déclenchée par N4 Sentinel : c'est un guide tracé et audité.
</p>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (folder is not null)
{
    <dl class="row">
        <dt class="col-sm-3">Dossier</dt>
        <dd class="col-sm-9">@folder.Name (@folder.Category.ToLabel())</dd>
        <dt class="col-sm-3">Anomalie actuelle</dt>
        <dd class="col-sm-9">@(folder.HasAnomaly ? folder.AnomalyDescription ?? "Anomalie détectée" : "Aucune")</dd>
    </dl>
}

@if (current is { Status: ReconstitutionStatus.InProgress } activeReconstitution)
{
    <h2>Reconstitution en cours</h2>
    <p><strong>Motif :</strong> @activeReconstitution.Reason</p>
    <p><strong>Démarrée par :</strong> @activeReconstitution.StartedByUserId — @activeReconstitution.StartedAtUtc.ToLocalTime().ToString("f")</p>

    <ol class="mb-3">
        @foreach (var step in AllSteps)
        {
            var record = activeReconstitution.Steps.FirstOrDefault(s => s.Step == step);
            <li class="@(record is not null ? "text-success" : "")">
                @step.ToLabel()
                @if (record is not null)
                {
                    <span> — confirmée par @record.ConfirmedByUserId le @record.ConfirmedAtUtc.ToLocalTime().ToString("g")@(string.IsNullOrEmpty(record.Evidence) ? "" : $" ({record.Evidence})")</span>
                }
            </li>
        }
    </ol>

    <AuthorizeView Roles="@($"{Roles.Operateur},{Roles.Administrateur}")">
        <Authorized>
            @if (activeReconstitution.NextStep is { } nextStep)
            {
                <div class="mb-3">
                    <label class="form-label" for="evidence">Preuve (optionnel) — étape « @nextStep.ToLabel() »</label>
                    <input id="evidence" class="form-control mb-2" @bind="evidence" placeholder="ex. capture, log, référence de sauvegarde..." />
                    <button class="btn btn-primary btn-sm" @onclick="ConfirmStepAsync" disabled="@isBusy">Confirmer l'étape</button>
                    <button class="btn btn-outline-danger btn-sm" @onclick="() => showAbortForm = true">Abandonner</button>
                </div>
            }
            @if (showAbortForm)
            {
                <div class="mb-3">
                    <textarea class="form-control mb-2" @bind="abortReason" placeholder="Motif d'abandon (cas incertain à escalader — FR-059G)"></textarea>
                    <button class="btn btn-danger btn-sm" @onclick="AbortAsync" disabled="@isBusy">Confirmer l'abandon</button>
                </div>
            }
        </Authorized>
    </AuthorizeView>
}
else
{
    <AuthorizeView Roles="@($"{Roles.Operateur},{Roles.Administrateur}")">
        <Authorized>
            <h2>Démarrer une reconstitution</h2>
            <div class="mb-3">
                <label class="form-label" for="reason">Motif (obligatoire — FR-059G)</label>
                <textarea id="reason" class="form-control mb-2" @bind="startReason" placeholder="ex. suspicion de corruption KahaDB confirmée par le diagnostic"></textarea>
                <button class="btn btn-primary btn-sm" @onclick="StartAsync" disabled="@isBusy">Démarrer la reconstitution</button>
            </div>
        </Authorized>
    </AuthorizeView>
}

<h2>Historique</h2>
@if (reconstitutions is null)
{
    <p><em>Chargement...</em></p>
}
else if (reconstitutions.Count == 0)
{
    <p>Aucune reconstitution enregistrée pour ce dossier.</p>
}
else
{
    <div class="table-responsive">
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Statut</th>
                <th>Motif</th>
                <th>Démarrée le</th>
                <th>Terminée le</th>
                <th>Étapes confirmées</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in reconstitutions)
            {
                <tr class="@(r.Status == ReconstitutionStatus.Aborted ? "table-warning" : "")">
                    <td>@r.Status.ToLabel()</td>
                    <td>@r.Reason</td>
                    <td>@r.StartedAtUtc.ToLocalTime().ToString("g")</td>
                    <td>@(r.CompletedAtUtc?.ToLocalTime().ToString("g") ?? "—")</td>
                    <td>@r.Steps.Count / 6</td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}

@code {
    [Parameter]
    public Guid EnvironmentId { get; set; }

    [Parameter]
    public Guid SharedFolderId { get; set; }

    [CascadingParameter]
    private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthStateTask { get; set; }

    private static readonly ReconstitutionStepKind[] AllSteps =
    [
        ReconstitutionStepKind.StopComponents, ReconstitutionStepKind.Backup,
        ReconstitutionStepKind.VerifyBackupIntegrity, ReconstitutionStepKind.Reconstruct,
        ReconstitutionStepKind.ControlledRestart, ReconstitutionStepKind.FinalTests,
    ];

    private SharedFolderDto? folder;
    private IReadOnlyList<FolderReconstitutionDto>? reconstitutions;
    private FolderReconstitutionDto? current => reconstitutions?.FirstOrDefault(r => r.Status == ReconstitutionStatus.InProgress);
    private string? currentUserId;
    private string startReason = string.Empty;
    private string evidence = string.Empty;
    private string abortReason = string.Empty;
    private bool showAbortForm;
    private bool isBusy;
    private string? errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        if (AuthStateTask is not null)
        {
            currentUserId = (await AuthStateTask).User.Identity?.Name;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var folders = await Mediator.Send(new ListSharedFoldersByEnvironmentQuery(EnvironmentId));
        folder = folders.FirstOrDefault(f => f.Id == SharedFolderId);
        reconstitutions = await Mediator.Send(new ListReconstitutionsBySharedFolderQuery(SharedFolderId));
    }

    private async Task StartAsync()
    {
        errorMessage = null;
        isBusy = true;
        try
        {
            await Mediator.Send(new StartFolderReconstitutionCommand(SharedFolderId, startReason, currentUserId ?? "inconnu"));
            startReason = string.Empty;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task ConfirmStepAsync()
    {
        if (current is null)
        {
            return;
        }

        errorMessage = null;
        isBusy = true;
        try
        {
            await Mediator.Send(new ConfirmReconstitutionStepCommand(current.Id, currentUserId ?? "inconnu", evidence));
            evidence = string.Empty;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task AbortAsync()
    {
        if (current is null)
        {
            return;
        }

        errorMessage = null;
        isBusy = true;
        try
        {
            await Mediator.Send(new AbortFolderReconstitutionCommand(current.Id, currentUserId ?? "inconnu", abortReason));
            abortReason = string.Empty;
            showAbortForm = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }
}
