@page "/supervision"
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using N4Sentinel.Application.Supervision
@using N4Sentinel.Data
@using N4Sentinel.Domain.Common
@using N4Sentinel.Domain.Supervision
@attribute [Authorize(Policy = "Droit:Consulter")]
@inject IServiceDeSupervision Supervision
@inject IDbContextFactory<ApplicationDbContext> Fabrique
@inject IHttpContextAccessor Accesseur

<PageTitle>Supervision — N4 Sentinel</PageTitle>

@if (cartographie is null)
{
    <h1>Supervision</h1>
    <p>Aucun environnement sélectionné, ou environnement introuvable.</p>
}
else
{
    <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 16px; margin-bottom: 24px;">
        <div>
            <h1>
                Supervision — @cartographie.NomDeLEnvironnement
                @if (cartographie.EstProduction)
                {
                    <span class="pastille-environnement production">Production</span>
                }
            </h1>
            @* FR-053 — la date de la dernière donnée est toujours visible. *@
            <p class="mention" style="margin-top: 4px;">
                Vue générée le @cartographie.GenereLe.UtcDateTime.ToString("dd/MM/yyyy HH:mm:ss", Culture) UTC.
                Donnée la plus récente : @LibelleDeDate(DonneeLaPlusRecente).
            </p>
        </div>

        <AuthorizeView Policy="Droit:GererLeReferentiel">
            <form method="post" action="/supervision/collecte" class="ligne-action">
                <AntiforgeryToken />
                <input type="hidden" name="environnementId" value="@cartographie.EnvironmentId" />
                <button type="submit" class="bouton-principal" style="margin-top: 0;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/><path d="M16 16h5v5"/></svg>
                    Rafraîchir maintenant
                </button>
            </form>
        </AuthorizeView>
    </div>

    @if (Message is not null)
    {
        <p class="alerte succes" role="status">@Message</p>
    }

    <!-- KPI Summary Cards -->
    <div class="grille-kpi">
        <div class="carte-kpi">
            <div class="carte-kpi-titre">Composants Cartographiés</div>
            <div class="carte-kpi-valeur">@cartographie.Lignes.Count</div>
        </div>
        <div class="carte-kpi">
            <div class="carte-kpi-titre">Disponibles</div>
            <div class="carte-kpi-valeur" style="color: var(--succes);">
                @cartographie.Lignes.Count(l => l.Etat.Etat == EtatDeSupervision.Disponible)
            </div>
        </div>
        <div class="carte-kpi">
            <div class="carte-kpi-titre">À confirmer / Degragé</div>
            <div class="carte-kpi-valeur" style="color: var(--alerte);">
                @cartographie.Lignes.Count(l => l.Etat.Etat is EtatDeSupervision.AConfirmer or EtatDeSupervision.Inconnu or EtatDeSupervision.Degrade)
            </div>
        </div>
        <div class="carte-kpi">
            <div class="carte-kpi-titre">Alertes Actives</div>
            <div class="carte-kpi-valeur" style="color: @(cartographie.Alertes.Count > 0 ? "var(--danger)" : "var(--succes)");">
                @cartographie.Alertes.Count
            </div>
        </div>
    </div>

    <h2>Alertes en cours (@cartographie.Alertes.Count)</h2>
    @if (cartographie.Alertes.Count == 0)
    {
        <p>Aucune alerte active sur cet environnement.</p>
    }
    else
    {
        <div class="defilement" style="margin-bottom: 32px;">
            <table class="tableau">
                <thead><tr><th>Motif</th><th>Message</th><th>Portée</th></tr></thead>
                <tbody>
                    @foreach (var alerte in cartographie.Alertes)
                    {
                        <tr>
                            <td><strong style="color: var(--alerte);">@LibelleDeMotif(alerte.Motif)</strong></td>
                            <td>@alerte.Message</td>
                            <td>
                                @if (alerte.Critique)
                                {
                                    <span class="signal-attention" style="border-color: var(--danger); color: var(--danger); background: rgba(244,63,94,0.1);">Composant critique</span>
                                }
                                else
                                {
                                    <span>Standard</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <h2>Cartographie des Composants (@cartographie.Lignes.Count)</h2>
    @if (cartographie.Lignes.Count == 0)
    {
        <p>Aucun composant enregistré sur cet environnement.</p>
    }
    else
    {
        <div class="defilement">
            <table class="tableau">
                <thead>
                    <tr>
                        <th>Composant</th>
                        <th>Type N4</th>
                        <th>État</th>
                        <th>Dernière donnée</th>
                        <th>Signaux</th>
                        <th>Justification</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ligne in cartographie.Lignes)
                    {
                        <tr>
                            <td><a href="/referentiel/composant/@ligne.ComposantId" class="identite-nom">@ligne.Nom</a></td>
                            <td><code class="cle" style="font-size: 12px; padding: 2px 8px;">@ligne.Kind</code></td>
                            <td>
                                @* FR-055 — le libellé porte l'information, la couleur l'appuie. *@
                                <span class="etat-consolide @ClasseDEtat(ligne.Etat.Etat)">
                                    @EvaluationDeSupervision.Libelle(ligne.Etat.Etat)
                                </span>
                            </td>
                            <td>@LibelleDeDate(ligne.Etat.DerniereDonnee)</td>
                            <td>@ResumerLesSignaux(ligne)</td>
                            <td>@ligne.Etat.Justification</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <p class="mention" style="margin-top: 20px;">
        Les composants non activés au référentiel sont supervisés mais n'autorisent aucune
        action, conformément à FR-050. Un composant sans contrôle de santé actif reste
        « Inconnu » : c'est un composant dont l'application ne peut rien dire.
    </p>
}

@code {
    private static readonly CultureInfo Culture = CultureInfo.InvariantCulture;

    private CartographieDeSupervision? cartographie;

    [SupplyParameterFromQuery(Name = "message")]
    private string? CodeMessage { get; set; }

    private string? Message => CodeMessage switch
    {
        "collecte" => "Collecte effectuée.",
        _ => null
    };

    private DateTimeOffset? DonneeLaPlusRecente =>
        cartographie?.Lignes
            .Select(l => l.Etat.DerniereDonnee)
            .Where(d => d is not null)
            .DefaultIfEmpty(null)
            .Max();

    protected override async Task OnInitializedAsync()
    {
        await using var contexte = await Fabrique.CreateDbContextAsync();

        var choisi = Guid.TryParse(Accesseur.HttpContext?.Request.Cookies["environnement"], out var id)
            ? id
            : Guid.Empty;

        var environnementId = await contexte.Environnements
            .Where(e => e.Id == choisi)
            .Select(e => e.Id)
            .FirstOrDefaultAsync();

        if (environnementId == Guid.Empty)
        {
            environnementId = await contexte.Environnements
                .OrderBy(e => e.Type)
                .Select(e => e.Id)
                .FirstOrDefaultAsync();
        }

        if (environnementId != Guid.Empty)
        {
            cartographie = await Supervision.LireAsync(environnementId);
        }
    }

    private static string ResumerLesSignaux(LigneDeSupervision ligne)
    {
        if (ligne.Signaux.Count == 0)
        {
            return "aucun";
        }

        var favorables = ligne.Signaux.Count(s => s.Verdict == VerdictDeSignal.Favorable);
        var manquants = ligne.Signaux.Count(s => s.Verdict is VerdictDeSignal.Indisponible or VerdictDeSignal.Perime);

        return $"{favorables}/{ligne.Signaux.Count} favorables"
            + (manquants > 0 ? $", {manquants} manquant(s)" : string.Empty);
    }

    private string LibelleDeDate(DateTimeOffset? date)
    {
        if (date is null)
        {
            return "aucun relevé";
        }

        var age = (cartographie?.GenereLe ?? DateTimeOffset.UtcNow) - date.Value;

        var anciennete = age.TotalSeconds < 90
            ? $"il y a {(int)age.TotalSeconds} s"
            : $"il y a {(int)age.TotalMinutes} min";

        return $"{date.Value.UtcDateTime.ToString("HH:mm:ss", Culture)} UTC ({anciennete})";
    }

    private static string ClasseDEtat(EtatDeSupervision etat) => etat switch
    {
        EtatDeSupervision.Disponible => "etat-favorable",
        EtatDeSupervision.Degrade => "etat-degrade",
        EtatDeSupervision.Indisponible => "etat-defavorable",
        EtatDeSupervision.Demarrage or EtatDeSupervision.Arret => "etat-transition",
        _ => "etat-indetermine"
    };

    private static string LibelleDeMotif(MotifDAlerte motif) => motif switch
    {
        MotifDAlerte.Timeout => "Délai dépassé",
        MotifDAlerte.Echec => "Échec",
        MotifDAlerte.IncoherenceDEtat => "Incohérence d'état",
        MotifDAlerte.FileQuiAugmente => "File en croissance",
        MotifDAlerte.HeartbeatAncien => "Heartbeat ancien",
        MotifDAlerte.RessourceCritique => "Ressource critique",
        MotifDAlerte.DonneeTropAncienne => "Donnée trop ancienne",
        _ => motif.ToString()
    };
}
