@page "/environments/{EnvironmentId:guid}/dependent-systems/new"
@attribute [Authorize(Roles = Roles.Administrateur)]
@inject IMediator Mediator
@inject NavigationManager NavigationManager

<PageTitle>Nouveau système dépendant - N4 Sentinel</PageTitle>

<h1>Nouveau système dépendant</h1>

<EditForm Model="model" OnValidSubmit="SubmitAsync" FormName="CreateDependentSystem">
    <DataAnnotationsValidator />
    <ValidationSummary class="text-danger" />

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <div class="mb-3">
        <label class="form-label" for="name">Nom</label>
        <InputText id="name" class="form-control" @bind-Value="model.Name" placeholder="ex. CAMCO/GOS, DGPS, RMS/Reefer Runner, IPAKI, Scangate, EDI..." />
    </div>

    <div class="mb-3">
        <label class="form-label" for="description">Description</label>
        <InputTextArea id="description" class="form-control" @bind-Value="model.Description" placeholder="Nature de l'intégration, ce qu'elle apporte à l'exploitation..." />
    </div>

    <div class="mb-3">
        <label class="form-label" for="governance">Caractère pilotable</label>
        <InputSelect id="governance" class="form-select" @bind-Value="model.Governance">
            @foreach (var g in Enum.GetValues<ComponentGovernance>())
            {
                <option value="@g">@g.ToLabel()</option>
            }
        </InputSelect>
    </div>

    <button type="submit" class="btn btn-primary">Créer</button>
    <a class="btn btn-secondary" href="environments/@EnvironmentId/dependent-systems">Annuler</a>
</EditForm>

@code {
    [Parameter]
    public Guid EnvironmentId { get; set; }

    private readonly CreateDependentSystemModel model = new();
    private string? errorMessage;

    private async Task SubmitAsync()
    {
        errorMessage = null;
        try
        {
            await Mediator.Send(new CreateDependentSystemCommand(
                EnvironmentId, model.Name, model.Description, model.Governance));
            NavigationManager.NavigateTo($"environments/{EnvironmentId}/dependent-systems");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private sealed class CreateDependentSystemModel
    {
        [Required(ErrorMessage = "Le nom est obligatoire.")]
        public string Name { get; set; } = string.Empty;

        public string? Description { get; set; }

        public ComponentGovernance Governance { get; set; } = ComponentGovernance.NotSupervised;
    }
}
