@page "/environments/{EnvironmentId:guid}/dependent-systems"
@attribute [Authorize]
@inject IMediator Mediator

<PageTitle>Systèmes dépendants - N4 Sentinel</PageTitle>

<h1>Systèmes dépendants</h1>
<p><a href="environments/@EnvironmentId">← Retour à l'environnement</a></p>
<p class="text-muted">
    Systèmes externes au TOS Navis N4 dont dépend l'exploitation de cet environnement (contrôle d'accès,
    positionnement, EDI...) — cartographiés pour leur caractère pilotable ou non depuis N4 Sentinel (E1.6).
</p>

<AuthorizeView Roles="@Roles.Administrateur">
    <Authorized>
        <a class="btn btn-primary mb-3" href="environments/@EnvironmentId/dependent-systems/new">Nouveau système dépendant</a>
    </Authorized>
</AuthorizeView>

@if (systems is null)
{
    <p><em>Chargement...</em></p>
}
else if (systems.Count == 0)
{
    <p>Aucun système dépendant cartographié pour cet environnement.</p>
}
else
{
    <div class="table-responsive">
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Description</th>
                <th>Caractère</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var system in systems)
            {
                <tr>
                    <td>@system.Name</td>
                    <td>@system.Description</td>
                    <td><span class="badge @GovernanceBadgeClass(system.Governance)">@system.Governance.ToLabel()</span></td>
                    <td>
                        <AuthorizeView Roles="@Roles.Administrateur">
                            <Authorized>
                                <a class="btn btn-sm btn-outline-secondary" href="environments/@EnvironmentId/dependent-systems/@system.Id/edit">Modifier</a>
                            </Authorized>
                        </AuthorizeView>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}

@code {
    [Parameter]
    public Guid EnvironmentId { get; set; }

    private IReadOnlyList<DependentSystemDto>? systems;

    protected override async Task OnParametersSetAsync()
    {
        systems = await Mediator.Send(new ListDependentSystemsByEnvironmentQuery(EnvironmentId));
    }

    private static string GovernanceBadgeClass(ComponentGovernance governance) => governance switch
    {
        ComponentGovernance.Controllable => "bg-success",
        ComponentGovernance.SupervisedOnly => "bg-info text-dark",
        ComponentGovernance.NotSupervised => "bg-secondary",
        _ => "bg-secondary",
    };
}
