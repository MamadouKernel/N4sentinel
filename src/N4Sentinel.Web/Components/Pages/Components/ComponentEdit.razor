@page "/environments/{EnvironmentId:guid}/components/{Id:guid}/edit"
@attribute [Authorize(Roles = Roles.Administrateur)]
@inject IMediator Mediator
@inject NavigationManager NavigationManager

<PageTitle>Modifier @(model?.Name) - N4 Sentinel</PageTitle>

@if (model is null || existingComponents is null)
{
    <p><em>Chargement...</em></p>
}
else
{
    <h1>Modifier le composant</h1>

    <EditForm Model="model" OnValidSubmit="SubmitAsync" FormName="EditComponent">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger" />

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <div class="mb-3">
            <label class="form-label" for="name">Nom logique</label>
            <InputText id="name" class="form-control" @bind-Value="model.Name" />
        </div>

        <div class="mb-3">
            <label class="form-label" for="role">Rôle</label>
            <InputText id="role" class="form-control" @bind-Value="model.Role" />
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label" for="hostName">Serveur / VM</label>
                <InputText id="hostName" class="form-control" @bind-Value="model.HostName" />
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label" for="ipAddress">Adresse IP</label>
                <InputText id="ipAddress" class="form-control" @bind-Value="model.IpAddress" />
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label" for="dnsName">Nom DNS</label>
                <InputText id="dnsName" class="form-control" @bind-Value="model.DnsName" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label" for="os">Système d'exploitation</label>
                <InputText id="os" class="form-control" @bind-Value="model.OperatingSystem" />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label" for="serviceName">Service / processus</label>
                <InputText id="serviceName" class="form-control" @bind-Value="model.ServiceOrProcessName" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label" for="criticality">Criticité</label>
                <InputSelect id="criticality" class="form-select" @bind-Value="model.Criticality">
                    @foreach (var c in Enum.GetValues<ComponentCriticality>())
                    {
                        <option value="@c">@c.ToLabel()</option>
                    }
                </InputSelect>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label" for="governance">Gouvernance</label>
                <InputSelect id="governance" class="form-select" @bind-Value="model.Governance">
                    @foreach (var g in Enum.GetValues<ComponentGovernance>())
                    {
                        <option value="@g">@g.ToLabel()</option>
                    }
                </InputSelect>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label" for="technicalOwner">Responsable technique</label>
                <InputText id="technicalOwner" class="form-control" @bind-Value="model.TechnicalOwner" />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label" for="functionalOwner">Responsable fonctionnel</label>
                <InputText id="functionalOwner" class="form-control" @bind-Value="model.FunctionalOwner" />
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label" for="healthCheck">Contrôle de santé</label>
            <InputText id="healthCheck" class="form-control" @bind-Value="model.HealthCheckDescription" />
        </div>

        @if (existingComponents.Count > 0)
        {
            <div class="mb-3">
                <label class="form-label">Dépendances (composants devant être opérationnels avant celui-ci)</label>
                @foreach (var candidate in existingComponents)
                {
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="@("dep-" + candidate.Id)"
                               checked="@selectedDependencyIds.Contains(candidate.Id)"
                               @onchange="e => ToggleDependency(candidate.Id, (bool)e.Value!)" />
                        <label class="form-check-label" for="@("dep-" + candidate.Id)">@candidate.Name (@candidate.Role)</label>
                    </div>
                }
            </div>
        }

        <button type="submit" class="btn btn-primary">Enregistrer</button>
        <a class="btn btn-secondary" href="environments/@EnvironmentId">Annuler</a>
    </EditForm>
}

@code {
    [Parameter]
    public Guid EnvironmentId { get; set; }

    [Parameter]
    public Guid Id { get; set; }

    private EditComponentModel? model;
    private readonly HashSet<Guid> selectedDependencyIds = [];
    private IReadOnlyList<ComponentDto>? existingComponents;
    private string? errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        var all = await Mediator.Send(new ListComponentsByEnvironmentQuery(EnvironmentId));
        existingComponents = all.Where(c => c.Id != Id).ToList();

        var current = all.FirstOrDefault(c => c.Id == Id);
        if (current is not null)
        {
            model = new EditComponentModel
            {
                Name = current.Name,
                Role = current.Role,
                HostName = current.HostName,
                IpAddress = current.IpAddress,
                DnsName = current.DnsName,
                OperatingSystem = current.OperatingSystem,
                ServiceOrProcessName = current.ServiceOrProcessName,
                HealthCheckDescription = current.HealthCheckDescription,
                Criticality = current.Criticality,
                Governance = current.Governance,
                TechnicalOwner = current.TechnicalOwner,
                FunctionalOwner = current.FunctionalOwner,
            };

            selectedDependencyIds.Clear();
            foreach (var depId in current.DependsOnComponentIds)
            {
                selectedDependencyIds.Add(depId);
            }
        }
    }

    private void ToggleDependency(Guid componentId, bool isSelected)
    {
        if (isSelected)
        {
            selectedDependencyIds.Add(componentId);
        }
        else
        {
            selectedDependencyIds.Remove(componentId);
        }
    }

    private async Task SubmitAsync()
    {
        if (model is null)
        {
            return;
        }

        errorMessage = null;
        try
        {
            await Mediator.Send(new UpdateComponentCommand(
                Id, model.Name, model.Role, model.HostName, model.IpAddress, model.DnsName,
                model.OperatingSystem, model.ServiceOrProcessName, model.HealthCheckDescription,
                model.Criticality, model.Governance, model.TechnicalOwner, model.FunctionalOwner,
                selectedDependencyIds));
            NavigationManager.NavigateTo($"environments/{EnvironmentId}");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private sealed class EditComponentModel
    {
        [Required(ErrorMessage = "Le nom est obligatoire.")]
        public string Name { get; set; } = string.Empty;

        [Required(ErrorMessage = "Le rôle est obligatoire.")]
        public string Role { get; set; } = string.Empty;

        public string? HostName { get; set; }
        public string? IpAddress { get; set; }
        public string? DnsName { get; set; }
        public string? OperatingSystem { get; set; }
        public string? ServiceOrProcessName { get; set; }
        public string? HealthCheckDescription { get; set; }
        public ComponentCriticality Criticality { get; set; }
        public ComponentGovernance Governance { get; set; }
        public string? TechnicalOwner { get; set; }
        public string? FunctionalOwner { get; set; }
    }
}
