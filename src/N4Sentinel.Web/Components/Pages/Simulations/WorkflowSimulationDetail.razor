@page "/environments/{EnvironmentId:guid}/workflows/{WorkflowId:guid}/simulations/{SimulationId:guid}"
@attribute [Authorize]
@inject IMediator Mediator

<PageTitle>Résultat de simulation - N4 Sentinel</PageTitle>

@if (simulation is null)
{
    <p><em>Chargement...</em></p>
}
else
{
    <h1>Résultat de simulation — v@(simulation.WorkflowVersionNumber)</h1>
    <p><a href="environments/@EnvironmentId/workflows/@WorkflowId/simulations">← Retour à l'historique</a></p>

    <p>
        <strong>Demandée par :</strong> @simulation.RequestedByUserId
        &nbsp;·&nbsp;
        <strong>Le :</strong> @simulation.RequestedAtUtc.ToLocalTime().ToString("f")
    </p>

    @if (simulation.HasBlockingIssues)
    {
        <div class="alert alert-danger">
            Au moins une étape ne pourrait pas s'exécuter en l'état (composant non pilotable ou introuvable).
            Ce mode simulation n'a exécuté aucune commande technique — cf. FR-005.
        </div>
    }
    else if (simulation.RequiresHumanValidation)
    {
        <div class="alert alert-warning">
            Aucun blocage détecté, mais au moins une étape nécessite une confirmation ou une approbation avant
            toute exécution réelle.
        </div>
    }
    else
    {
        <div class="alert alert-success">
            Aucun blocage ni validation humaine requise détecté pour cette simulation.
        </div>
    }

    <div class="table-responsive">
    <table class="table table-hover">
        <thead>
            <tr>
                <th>#</th>
                <th>Étape</th>
                <th>Action</th>
                <th>Composant</th>
                <th>État observé</th>
                <th>Peut s'exécuter</th>
                <th>Confirmation</th>
                <th>Approbation</th>
                <th>Critique</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var step in simulation.StepResults)
            {
                <tr class="@(step.CanExecute ? "" : "table-danger")">
                    <td>@(step.Position + 1)</td>
                    <td>@step.Name</td>
                    <td>@step.Action.ToLabel()</td>
                    <td>@(step.ComponentName ?? "—")</td>
                    <td>@(step.ObservedHealth?.ToLabel() ?? "—")</td>
                    <td>
                        @if (step.CanExecute)
                        {
                            <span class="badge bg-success">Oui</span>
                        }
                        else
                        {
                            <span class="badge bg-danger" title="@step.BlockingReason">Non</span>
                        }
                    </td>
                    <td>@(step.RequiresConfirmation ? "Oui" : "Non")</td>
                    <td>@(step.RequiresApproval ? "Oui" : "Non")</td>
                    <td>@(step.IsCriticalOrDestructive ? "Oui" : "Non")</td>
                </tr>
            }
        </tbody>
    </table>
    </div>

    @if (BlockedSteps.Count > 0)
    {
        <h2>Détail des blocages</h2>
        <ul>
            @foreach (var step in BlockedSteps)
            {
                <li><strong>@step.Name</strong> : @step.BlockingReason</li>
            }
        </ul>
    }
}

@code {
    [Parameter]
    public Guid EnvironmentId { get; set; }

    [Parameter]
    public Guid WorkflowId { get; set; }

    [Parameter]
    public Guid SimulationId { get; set; }

    private WorkflowSimulationDto? simulation;

    private List<WorkflowSimulationStepResultDto> BlockedSteps =>
        simulation?.StepResults.Where(s => !s.CanExecute).ToList() ?? [];

    protected override async Task OnParametersSetAsync()
    {
        simulation = await Mediator.Send(new GetWorkflowSimulationByIdQuery(SimulationId));
    }
}
