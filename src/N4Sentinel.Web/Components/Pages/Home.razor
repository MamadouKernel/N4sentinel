@page "/"
@using Microsoft.EntityFrameworkCore
@using N4Sentinel.Application.Habilitations
@using N4Sentinel.Data
@using N4Sentinel.Domain.Habilitations
@inject IServiceDHabilitations Habilitations
@inject IDbContextFactory<ApplicationDbContext> Fabrique
@inject IHttpContextAccessor Accesseur

<PageTitle>Accueil — N4 Sentinel</PageTitle>

<div style="background: var(--fond-carte); border: 1px solid var(--bordure); border-radius: 16px; padding: 32px; margin-bottom: 32px; box-shadow: var(--ombre-carte);">
    <h1 style="color: var(--primaire); margin-bottom: 12px;">Bienvenue sur N4 SENTINEL, @NomAffiche</h1>
    <p style="font-size: 16px; margin: 0; max-width: 800px;">
        Plateforme d'orchestration, de supervision et de diagnostic sécurisé pour l'écosystème Navis N4 de CIT.
    </p>
</div>

<!-- Quick Navigation Cards -->
<div class="grille-kpi" style="grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); margin-bottom: 36px;">
    <a href="/supervision" style="text-decoration: none; color: inherit;">
        <div class="carte-kpi" style="cursor: pointer; height: 100%;">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
                <span class="carte-kpi-titre">Supervision Temps Réel</span>
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--primaire)" stroke-width="2"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>
            </div>
            <p style="font-size: 13px; color: var(--texte-attenue); margin: 0;">Cartographie consolidée de l'état des composants et détection d'alertes.</p>
        </div>
    </a>

    <a href="/operations" style="text-decoration: none; color: inherit;">
        <div class="carte-kpi" style="cursor: pointer; height: 100%;">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
                <span class="carte-kpi-titre">Opérations & Orchestration</span>
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
            </div>
            <p style="font-size: 13px; color: var(--texte-attenue); margin: 0;">Préparation, simulation et suivi pas-à-pas des exécutions séquencées.</p>
        </div>
    </a>

    <a href="/referentiel/composants" style="text-decoration: none; color: inherit;">
        <div class="carte-kpi" style="cursor: pointer; height: 100%;">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
                <span class="carte-kpi-titre">Référentiel N4</span>
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--succes)" stroke-width="2"><rect width="20" height="8" x="2" y="2" rx="2"/><rect width="20" height="8" x="2" y="14" rx="2"/><line x1="6" x2="6.01" y1="6" y2="6"/><line x1="6" x2="6.01" y1="18" y2="18"/></svg>
            </div>
            <p style="font-size: 13px; color: var(--texte-attenue); margin: 0;">Inventaire des composants, environnements et graphe des dépendances.</p>
        </div>
    </a>
</div>

<h2>Vos Droits Effectifs sur l'Environnement : <span style="color: var(--primaire);">@NomDeLEnvironnement</span></h2>

@if (droits.Count == 0)
{
    <p>Aucun droit accordé sur cet environnement.</p>
}
else
{
    <div class="defilement">
        <table class="tableau">
            <thead>
                <tr><th>Droit Attribué</th><th>Type d'Habilitation</th></tr>
            </thead>
            <tbody>
                @foreach (var droit in droits.OrderBy(d => d.ToString(), StringComparer.Ordinal))
                {
                    var estAction = Droits.EstUneAction(droit);
                    <tr>
                        <td><strong>@droit</strong></td>
                        <td>
                            @if (estAction)
                            {
                                <span class="etat-consolide etat-transition" style="font-size: 11px; padding: 3px 10px;">Action Mutative</span>
                            }
                            else
                            {
                                <span class="etat-consolide etat-indetermine" style="font-size: 11px; padding: 3px 10px;">Consultation Seule</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<p class="mention">
    Garde-fou SEC-004 : En Production, un profil global n'accorde que la consultation. Toute permission d'action y exige une habilitation explicite nominative sur l'environnement.
</p>

@code {
    private IReadOnlyCollection<Droit> droits = [];
    private string NomDeLEnvironnement = "—";

    private string NomAffiche => Accesseur.HttpContext?.User.Identity?.Name ?? string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var contexteHttp = Accesseur.HttpContext;
        var identifiant = contexteHttp?.User.FindFirst(
            System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        if (identifiant is null)
        {
            return;
        }

        await using var contexte = await Fabrique.CreateDbContextAsync();

        var environnementId = Guid.TryParse(contexteHttp!.Request.Cookies["environnement"], out var id)
            ? id
            : await contexte.Environnements.Select(e => e.Id).FirstOrDefaultAsync();

        var environnement = await contexte.Environnements
            .AsNoTracking()
            .FirstOrDefaultAsync(e => e.Id == environnementId);

        if (environnement is null)
        {
            return;
        }

        NomDeLEnvironnement = environnement.Nom;
        droits = [.. await Habilitations.DroitsSurAsync(identifiant, environnement.Id)];
    }
}
