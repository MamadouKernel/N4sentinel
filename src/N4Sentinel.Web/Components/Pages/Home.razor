@page "/"

@inject IOptions<BrandingOptions> BrandingOptions

<PageTitle>Accueil — N4 Sentinel</PageTitle>

<div class="space-y-8">
    <section class="panel-brand">
        <div class="max-w-2xl">
            <span class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1 text-xs font-semibold text-gold-200 ring-1 ring-inset ring-gold-300/30">
                Supervision &amp; pilotage du TOS Navis N4
            </span>

            <h1 class="mt-5 text-3xl font-bold leading-tight tracking-tight sm:text-4xl">
                Standardiser et sécuriser les opérations N4
            </h1>

            <p class="mt-4 text-base leading-relaxed text-brand-100">
                Orchestration guidée des séquences Cluster Nodes, Center Node, Bridge et XPS, supervision des
                signaux d'exploitation et diagnostic outillé, pour @BrandingOptions.Value.OrganizationName.
            </p>

            <div class="mt-8 flex flex-wrap items-center gap-3">
                <AuthorizeView>
                    <Authorized>
                        <a class="btn btn-accent btn-lg" href="dashboard">Accéder au tableau de bord</a>
                        <a class="btn btn-lg border-white/25 bg-transparent text-white hover:bg-white/10" href="environments">
                            Environnements
                        </a>
                    </Authorized>
                    <NotAuthorized>
                        <a class="btn btn-accent btn-lg" href="Account/Login">Se connecter à la plateforme</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </section>

    <section>
        <h2 class="section-title">Ce que couvre la plateforme</h2>

        <div class="mt-4 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
            <article class="soft-card">
                <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-50 text-brand-700">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 13h4l3 7 4-16 3 9h4" />
                    </svg>
                </div>
                <h3 class="mt-4 text-sm font-semibold text-brand-900">Supervision</h3>
                <p class="mt-1.5 text-xs leading-relaxed text-slate-500">
                    Suivi des services, nœuds applicatifs, files ActiveMQ et dossiers partagés, avec alertes sur
                    seuils explicites.
                </p>
            </article>

            <article class="soft-card">
                <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-50 text-brand-700">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-6 4h6" />
                    </svg>
                </div>
                <h3 class="mt-4 text-sm font-semibold text-brand-900">Pilotage guidé</h3>
                <p class="mt-1.5 text-xs leading-relaxed text-slate-500">
                    Workflows versionnés d'arrêt, de démarrage et de redémarrage, exécutés pas à pas avec double
                    validation et reprise sur échec.
                </p>
            </article>

            <article class="soft-card">
                <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-50 text-brand-700">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16z" />
                    </svg>
                </div>
                <h3 class="mt-4 text-sm font-semibold text-brand-900">Diagnostic</h3>
                <p class="mt-1.5 text-xs leading-relaxed text-slate-500">
                    Corrélation des signaux collectés et des signatures de logs sur des règles administrées et
                    versionnées.
                </p>
            </article>

            <article class="soft-card">
                <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-50 text-brand-700">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.25C10.83 5.48 9.25 5 7.5 5S4.17 5.48 3 6.25v13C4.17 18.48 5.75 18 7.5 18s3.33.48 4.5 1.25m0-13C13.17 5.48 14.75 5 16.5 5S19.83 5.48 21 6.25v13C19.83 18.48 18.25 18 16.5 18s-3.33.48-4.5 1.25m0-13v13" />
                    </svg>
                </div>
                <h3 class="mt-4 text-sm font-semibold text-brand-900">Assistant &amp; SOP</h3>
                <p class="mt-1.5 text-xs leading-relaxed text-slate-500">
                    Recherche sourcée dans la base documentaire N4 et capitalisation des interventions en fiches
                    réflexes réutilisables.
                </p>
            </article>
        </div>
    </section>
</div>
