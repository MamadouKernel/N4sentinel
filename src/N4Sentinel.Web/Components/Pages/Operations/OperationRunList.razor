@page "/environments/{EnvironmentId:guid}/operations"
@attribute [Authorize]
@inject IMediator Mediator

<PageTitle>Opérations - N4 Sentinel</PageTitle>

<h1>Historique des opérations</h1>
<p><a href="environments/@EnvironmentId">← Retour à l'environnement</a></p>
<p><a href="environments/@EnvironmentId/operations/new">Nouvelle opération (sélection de scénario) →</a></p>

@if (runs is null)
{
    <p><em>Chargement...</em></p>
}
else if (runs.Count == 0)
{
    <p>Aucune opération n'a encore été lancée pour cet environnement.</p>
}
else
{
    <div class="table-responsive">
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Date</th>
                <th>Demandeur</th>
                <th>Statut</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var run in runs)
            {
                <tr>
                    <td>@run.RequestedAtUtc.ToLocalTime().ToString("g")</td>
                    <td>@run.RequestedByUserId</td>
                    <td><span class="badge @run.Status.ToBadgeClass()">@run.Status.ToLabel()</span></td>
                    <td><a class="btn btn-sm btn-outline-secondary" href="environments/@EnvironmentId/operations/@run.Id">Détail</a></td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}

@code {
    [Parameter]
    public Guid EnvironmentId { get; set; }

    private IReadOnlyList<OperationRunDto>? runs;

    protected override async Task OnParametersSetAsync()
    {
        runs = await Mediator.Send(new ListOperationRunsByEnvironmentQuery(EnvironmentId));
    }
}
