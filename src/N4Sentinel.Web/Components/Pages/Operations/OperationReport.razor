@page "/environments/{EnvironmentId:guid}/operations/{OperationRunId:guid}/report"
@attribute [Authorize]
@inject ISender Mediator

<PageTitle>Rapport d'opération - N4 Sentinel</PageTitle>

@if (report is null)
{
    <div class="card p-8 text-center text-slate-500">Chargement du rapport...</div>
}
else
{
    <div class="space-y-6">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
                <h1 class="text-2xl font-bold text-slate-900">Rapport d'opération</h1>
                <a href="@($"environments/{EnvironmentId}/operations/{OperationRunId}")" class="text-sm text-slate-500 hover:text-slate-700">← Retour à l'opération</a>
            </div>
            <div class="flex gap-2">
                <a href="@($"/reports/operations/{OperationRunId}/export")" class="btn btn-outline-primary">JSON</a>
                <a href="@($"/reports/operations/{OperationRunId}/export.pdf")" class="btn btn-primary">PDF</a>
            </div>
        </div>

        <div class="card p-6 space-y-3">
            <dl class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                <div><dt class="text-xs font-semibold uppercase text-slate-500">Statut</dt><dd class="text-sm text-slate-900">@report.Status.ToLabel()</dd></div>
                <div><dt class="text-xs font-semibold uppercase text-slate-500">Version de workflow</dt><dd class="text-sm text-slate-900">v@(report.WorkflowVersionNumber)</dd></div>
                <div><dt class="text-xs font-semibold uppercase text-slate-500">Demandée par</dt><dd class="text-sm text-slate-900">@report.RequestedByUserId — @report.RequestedAtUtc.ToLocalTime().ToString("g")</dd></div>
                @if (report.ApprovedByUserId is not null)
                {
                    <div><dt class="text-xs font-semibold uppercase text-slate-500">Approuvée par</dt><dd class="text-sm text-slate-900">@report.ApprovedByUserId — @report.ApprovedAtUtc?.ToLocalTime().ToString("g")</dd></div>
                }
                @if (report.CompletedAtUtc is not null)
                {
                    <div><dt class="text-xs font-semibold uppercase text-slate-500">Terminée le</dt><dd class="text-sm text-slate-900">@report.CompletedAtUtc?.ToLocalTime().ToString("g")</dd></div>
                }
                @if (report.Duration is not null)
                {
                    <div><dt class="text-xs font-semibold uppercase text-slate-500">Durée</dt><dd class="text-sm text-slate-900">@report.Duration?.ToString(@"hh\:mm\:ss")</dd></div>
                }
                @if (!string.IsNullOrEmpty(report.Motif))
                {
                    <div><dt class="text-xs font-semibold uppercase text-slate-500">Motif</dt><dd class="text-sm text-slate-900">@report.Motif</dd></div>
                }
                @if (!string.IsNullOrEmpty(report.IncidentOrChangeReference))
                {
                    <div><dt class="text-xs font-semibold uppercase text-slate-500">Référence incident/changement</dt><dd class="text-sm text-slate-900">@report.IncidentOrChangeReference</dd></div>
                }
                @if (!string.IsNullOrEmpty(report.Impact))
                {
                    <div><dt class="text-xs font-semibold uppercase text-slate-500">Impact</dt><dd class="text-sm text-slate-900">@report.Impact</dd></div>
                }
                @if (!string.IsNullOrEmpty(report.RejectionReason))
                {
                    <div><dt class="text-xs font-semibold uppercase text-slate-500">Motif de rejet</dt><dd class="text-sm text-slate-900">@report.RejectionReason</dd></div>
                }
            </dl>
        </div>

        <h2 class="text-lg font-bold text-slate-900">Chronologie des étapes</h2>
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th class="px-4 py-3">#</th>
                        <th class="px-4 py-3">Nom</th>
                        <th class="px-4 py-3">Composant</th>
                        <th class="px-4 py-3">Statut</th>
                        <th class="px-4 py-3">Démarrée</th>
                        <th class="px-4 py-3">Terminée</th>
                        <th class="px-4 py-3">Résultat</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200">
                    @foreach (var step in report.Steps)
                    {
                        <tr>
                            <td class="px-4 py-3">@step.Position</td>
                            <td class="px-4 py-3 font-semibold text-brand-900">@step.Name</td>
                            <td class="px-4 py-3">@(step.ComponentName ?? "—")</td>
                            <td class="px-4 py-3">@step.Status</td>
                            <td class="px-4 py-3">@(step.StartedAtUtc?.ToLocalTime().ToString("g") ?? "—")</td>
                            <td class="px-4 py-3">@(step.CompletedAtUtc?.ToLocalTime().ToString("g") ?? "—")</td>
                            <td class="px-4 py-3">
                                @(step.ResultMessage ?? "—")
                                @if (step.OverrideReason is not null)
                                {
                                    <div class="mt-1 rounded border border-amber-200 bg-amber-50 p-2 text-xs text-amber-900">
                                        <strong>Contournement (FR-027)</strong> par @step.OverriddenByUserId
                                        @if (step.OverrideApprovedByUserId is not null)
                                        {
                                            <text> — approuvé par @step.OverrideApprovedByUserId</text>
                                        }
                                        <br />Motif : @step.OverrideReason
                                        <br />Risque accepté : @step.OverrideAcceptedRisk
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <h2 class="text-lg font-bold text-slate-900">SOP associées (@report.AssociatedSops.Count)</h2>
        @if (report.AssociatedSops.Count == 0)
        {
            <div class="card p-6 text-center text-slate-500">Aucune SOP rattachée à cette opération.</div>
        }
        else
        {
            <div class="space-y-3">
                @foreach (var sop in report.AssociatedSops)
                {
                    <div class="card p-4">
                        <a href="/sops/@sop.SopId" class="font-semibold text-brand-700 hover:underline">@sop.SopTitle (v@sop.SopVersionNumber)</a>
                        @if (!string.IsNullOrEmpty(sop.Result))
                        {
                            <p class="mt-1 text-sm text-slate-700"><strong>Résultat :</strong> @sop.Result</p>
                        }
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    [Parameter] public Guid EnvironmentId { get; set; }
    [Parameter] public Guid OperationRunId { get; set; }

    private OperationReportDto? report;

    protected override async Task OnParametersSetAsync()
    {
        report = await Mediator.Send(new GetOperationReportQuery(OperationRunId));
    }
}
