@page "/environments/{EnvironmentId:guid}/workflows/{WorkflowId:guid}/operations/new"
@attribute [Authorize]
@inject IMediator Mediator
@inject NavigationManager NavigationManager
@inject IEnvironmentAccessChecker AccessChecker

<PageTitle>Nouvelle opération - N4 Sentinel</PageTitle>

@if (accessGranted is null)
{
    <p><em>Vérification des droits...</em></p>
}
else if (accessGranted == false)
{
    <div class="alert alert-danger">Accès refusé : le rôle Opérateur ou Administrateur est requis sur cet environnement (E11.1b).</div>
}
else if (workflow is null || environment is null)
{
    <p><em>Chargement...</em></p>
}
else
{
    <h1>Nouvelle opération — @workflow.Name</h1>
    <p>
        <span class="badge bg-info text-dark">@workflow.Type.ToLabel()</span>
        <span class="badge bg-secondary">@workflow.Scope.ToLabel()</span>
        @if (environment.Kind == EnvironmentKind.Production)
        {
            <span class="badge bg-danger">PRODUCTION</span>
        }
    </p>

    @if (environment.Kind == EnvironmentKind.Production)
    {
        <div class="alert alert-warning">
            Environnement de Production : le motif, la fenêtre d'intervention, l'impact attendu et la
            référence de l'incident ou du changement sont obligatoires (FR-011), et l'opération nécessitera
            une approbation par un autre utilisateur avant exécution.
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    @if (workflow.Scope is WorkflowScope.Unit or WorkflowScope.Partial)
    {
        <div class="card p-3 mb-3">
            <h2 class="h5">Analyse d'impact (FR-041)</h2>
            @if (impactAnalysis is null)
            {
                <p class="text-muted mb-0"><em>Analyse en cours...</em></p>
            }
            else if (!impactAnalysis.HasDependents)
            {
                <p class="text-muted mb-0">Aucun autre composant du référentiel ne déclare les composants ciblés comme dépendance.</p>
            }
            else
            {
                <ul class="list-unstyled mb-0">
                    @foreach (var impact in impactAnalysis.Impacts.Where(i => i.DependentComponentNames.Count > 0))
                    {
                        <li class="mb-1">
                            <strong>@impact.ComponentName</strong> (criticité @impact.Criticality) — composants dépendants
                            susceptibles d'être affectés : @string.Join(", ", impact.DependentComponentNames)
                        </li>
                    }
                </ul>
            }
        </div>
    }

    <div class="card p-3 mb-3">
        <h2 class="h5">Pré-check automatique (FR-012)</h2>
        @if (prerequisites is null)
        {
            <p class="text-muted mb-0"><em>Vérification des prérequis...</em></p>
        }
        else
        {
            <ul class="list-unstyled mb-2">
                @foreach (var check in prerequisites.Checks)
                {
                    <li class="mb-1">
                        <span class="badge @PrerequisiteBadgeClass(check.Status)">@PrerequisiteStatusLabel(check.Status)</span>
                        <strong>@check.Name</strong> — @check.Detail
                    </li>
                }
            </ul>
            @if (prerequisites.HasBlockingCheck)
            {
                <p class="text-danger mb-0">
                    Au moins un contrôle bloquant empêche le lancement de cette opération tant qu'il n'est pas résolu.
                </p>
            }
        }
    </div>

    <EditForm Model="model" OnValidSubmit="SubmitAsync" FormName="CreateOperationRun">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger" />

        <div class="mb-3">
            <label class="form-label" for="motif">Motif</label>
            <InputTextArea id="motif" class="form-control" @bind-Value="model.Motif" />
        </div>
        <div class="mb-3">
            <label class="form-label" for="window">Fenêtre d'intervention</label>
            <InputText id="window" class="form-control" @bind-Value="model.InterventionWindowDescription" placeholder="ex. 2026-08-10 22:00 - 23:00" />
        </div>
        <div class="mb-3">
            <label class="form-label" for="impact">Impact attendu</label>
            <InputTextArea id="impact" class="form-control" @bind-Value="model.Impact" />
        </div>
        <div class="mb-3">
            <label class="form-label" for="reference">Référence incident/changement</label>
            <InputText id="reference" class="form-control" @bind-Value="model.IncidentOrChangeReference" />
        </div>

        <button type="submit" class="btn btn-primary" disabled="@(prerequisites?.HasBlockingCheck == true)">Créer l'opération</button>
        <a class="btn btn-secondary" href="environments/@EnvironmentId/operations/new">Annuler</a>
    </EditForm>
}

@code {
    [Parameter]
    public Guid EnvironmentId { get; set; }

    [Parameter]
    public Guid WorkflowId { get; set; }

    [CascadingParameter]
    private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthStateTask { get; set; }

    private readonly CreateOperationRunModel model = new();
    private WorkflowDetailDto? workflow;
    private EnvironmentDetailDto? environment;
    private string? errorMessage;
    private bool? accessGranted;
    private PrerequisiteCheckReportDto? prerequisites;
    private OperationImpactAnalysisDto? impactAnalysis;

    protected override async Task OnParametersSetAsync()
    {
        var principal = AuthStateTask is not null ? (await AuthStateTask).User : new System.Security.Claims.ClaimsPrincipal();
        accessGranted = await AccessChecker.HasAnyRoleAsync(principal, EnvironmentId, Roles.Operateur, Roles.Administrateur);
        if (accessGranted == false)
        {
            return;
        }

        workflow = await Mediator.Send(new GetWorkflowByIdQuery(WorkflowId));
        environment = await Mediator.Send(new GetEnvironmentByIdQuery(EnvironmentId));

        if (workflow?.Versions.FirstOrDefault(v => v.Status == WorkflowVersionStatus.Active) is { } activeVersion)
        {
            prerequisites = await Mediator.Send(new CheckOperationPrerequisitesQuery(EnvironmentId, WorkflowId, activeVersion.Id));
            if (workflow.Scope is WorkflowScope.Unit or WorkflowScope.Partial)
            {
                impactAnalysis = await Mediator.Send(new GetOperationImpactAnalysisQuery(EnvironmentId, WorkflowId, activeVersion.Id));
            }
        }
    }

    private static string PrerequisiteBadgeClass(PrerequisiteCheckStatus status) => status switch
    {
        PrerequisiteCheckStatus.Satisfied => "bg-success",
        PrerequisiteCheckStatus.Warning => "bg-warning text-dark",
        PrerequisiteCheckStatus.Blocking => "bg-danger",
        PrerequisiteCheckStatus.NotApplicable => "bg-secondary",
        PrerequisiteCheckStatus.UnableToVerify => "bg-secondary",
        _ => "bg-secondary",
    };

    private static string PrerequisiteStatusLabel(PrerequisiteCheckStatus status) => status switch
    {
        PrerequisiteCheckStatus.Satisfied => "Satisfait",
        PrerequisiteCheckStatus.Warning => "Avertissement",
        PrerequisiteCheckStatus.Blocking => "Bloquant",
        PrerequisiteCheckStatus.NotApplicable => "Non applicable",
        PrerequisiteCheckStatus.UnableToVerify => "Impossible à vérifier",
        _ => status.ToString(),
    };

    private async Task SubmitAsync()
    {
        if (workflow?.Versions.FirstOrDefault(v => v.Status == WorkflowVersionStatus.Active) is not { } activeVersion)
        {
            errorMessage = "Ce workflow n'a pas de version Active.";
            return;
        }

        errorMessage = null;
        try
        {
            var userId = AuthStateTask is not null
                ? (await AuthStateTask).User.Identity?.Name ?? "inconnu"
                : "inconnu";

            var id = await Mediator.Send(new CreateOperationRunCommand(
                EnvironmentId, WorkflowId, activeVersion.Id, model.Motif, model.InterventionWindowDescription,
                model.Impact, model.IncidentOrChangeReference, userId));

            NavigationManager.NavigateTo($"environments/{EnvironmentId}/operations/{id}");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private sealed class CreateOperationRunModel
    {
        public string? Motif { get; set; }
        public string? InterventionWindowDescription { get; set; }
        public string? Impact { get; set; }
        public string? IncidentOrChangeReference { get; set; }
    }
}
