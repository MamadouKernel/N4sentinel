@page "/environments/{EnvironmentId:guid}/operations/{OperationRunId:guid}"
@attribute [Authorize]
@inject IMediator Mediator

<PageTitle>Opération - N4 Sentinel</PageTitle>

@if (run is null)
{
    <p><em>Chargement...</em></p>
}
else
{
    <h1>
        Opération
        <span class="badge @run.Status.ToBadgeClass()">@run.Status.ToLabel()</span>
    </h1>
    <p>
        <a href="environments/@EnvironmentId/operations">← Retour à l'historique</a>
        · <a href="environments/@EnvironmentId/operations/@OperationRunId/report">Rapport d'opération →</a>
    </p>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <dl class="row">
        <dt class="col-sm-3">Demandée par</dt>
        <dd class="col-sm-9">@run.RequestedByUserId — @run.RequestedAtUtc.ToLocalTime().ToString("f")</dd>

        @if (!string.IsNullOrEmpty(run.Motif))
        {
            <dt class="col-sm-3">Motif</dt>
            <dd class="col-sm-9">@run.Motif</dd>
        }
        @if (!string.IsNullOrEmpty(run.InterventionWindowDescription))
        {
            <dt class="col-sm-3">Fenêtre d'intervention</dt>
            <dd class="col-sm-9">@run.InterventionWindowDescription</dd>
        }
        @if (!string.IsNullOrEmpty(run.Impact))
        {
            <dt class="col-sm-3">Impact attendu</dt>
            <dd class="col-sm-9">@run.Impact</dd>
        }
        @if (!string.IsNullOrEmpty(run.IncidentOrChangeReference))
        {
            <dt class="col-sm-3">Référence</dt>
            <dd class="col-sm-9">@run.IncidentOrChangeReference</dd>
        }
        @if (run.ApprovedByUserId is not null)
        {
            <dt class="col-sm-3">Approuvée par</dt>
            <dd class="col-sm-9">@run.ApprovedByUserId — @run.ApprovedAtUtc?.ToLocalTime().ToString("f")</dd>
        }
        @if (run.RejectionReason is not null)
        {
            <dt class="col-sm-3">Rejetée — motif</dt>
            <dd class="col-sm-9">@run.RejectionReason</dd>
        }
    </dl>

    <AuthorizeView Roles="@($"{Roles.Administrateur},{Roles.Approbateur}")" Context="approvalContext">
        <Authorized>
            @if (run.Status == OperationRunStatus.PendingApproval && !string.Equals(run.RequestedByUserId, currentUserId, StringComparison.OrdinalIgnoreCase))
            {
                <div class="d-flex gap-2 mb-3">
                    <button class="btn btn-success btn-sm" @onclick="ApproveAsync">Approuver</button>
                    <button class="btn btn-outline-danger btn-sm" @onclick="() => showRejectForm = true">Rejeter</button>
                </div>
                @if (showRejectForm)
                {
                    <div class="mb-3">
                        <textarea class="form-control mb-2" @bind="rejectionReason" placeholder="Motif du rejet"></textarea>
                        <button class="btn btn-danger btn-sm" @onclick="RejectAsync">Confirmer le rejet</button>
                    </div>
                }
            }
            @if (run.Status == OperationRunStatus.PendingApproval && string.Equals(run.RequestedByUserId, currentUserId, StringComparison.OrdinalIgnoreCase))
            {
                <p class="text-muted">Vous êtes le demandeur de cette opération : un autre utilisateur habilité doit l'approuver (E3.6).</p>
            }
        </Authorized>
    </AuthorizeView>

    @if (run.Status == OperationRunStatus.ReconciliationRequired)
    {
        <div class="alert alert-warning">
            <strong>Réconciliation requise (FR-024).</strong> L'état réel constaté avant la reprise diverge de
            l'état mémorisé par le workflow : la reprise est suspendue tant qu'un opérateur habilité n'a pas
            examiné l'écart, pour éviter de rejouer aveuglément une action déjà réalisée.
            <AuthorizeView Roles="@($"{Roles.Administrateur},{Roles.Operateur}")" Context="reconciliationContext">
                <Authorized>
                    <div class="mt-2">
                        <button class="btn btn-warning btn-sm" @onclick="AcknowledgeReconciliationAsync" disabled="@isExecuting">
                            Écart examiné — refermer la réconciliation
                        </button>
                    </div>
                </Authorized>
            </AuthorizeView>
        </div>
    }

    <AuthorizeView Roles="@($"{Roles.Administrateur},{Roles.Operateur}")" Context="executionContext">
        <Authorized>
            @if (run.Status is OperationRunStatus.PendingApproval or OperationRunStatus.Approved or OperationRunStatus.Running)
            {
                <div class="mb-3">
                    <button class="btn btn-outline-danger btn-sm" @onclick="() => showCancelForm = !showCancelForm">
                        Annuler l'opération (FR-025)
                    </button>
                    @if (showCancelForm)
                    {
                        <div class="card p-3 mt-2">
                            <p class="text-muted text-sm">
                                N'interrompt jamais une commande technique déjà engagée : seules les étapes
                                encore en attente ou en attente de confirmation sont écartées. Le motif reste
                                visible dans le journal d'audit.
                            </p>
                            <div class="mb-2">
                                <label class="form-label">Motif de l'annulation</label>
                                <textarea class="form-control" @bind="cancelReason"></textarea>
                            </div>
                            <button class="btn btn-danger btn-sm" @onclick="CancelAsync" disabled="@isExecuting">
                                Confirmer l'annulation
                            </button>
                        </div>
                    }
                </div>
            }
            @if (AwaitingConfirmationStep is { } gatedStep)
            {
                <div class="alert alert-warning">
                    L'étape <strong>@gatedStep.Name</strong> est sensible (confirmation ou approbation
                    requise) : elle ne s'exécutera qu'après un geste explicite.
                </div>
                <button class="btn btn-warning mb-3" @onclick="ConfirmStepAsync" disabled="@isExecuting">
                    @(isExecuting ? "Exécution en cours..." : $"Confirmer et exécuter : {gatedStep.Name}")
                </button>
            }
            else if (run.Status is OperationRunStatus.Approved or OperationRunStatus.Running)
            {
                <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
                    <button class="btn btn-primary" @onclick="ExecuteNextStepAsync" disabled="@isExecuting">
                        @(isExecuting ? "Exécution en cours..." : "Exécuter l'étape suivante")
                    </button>
                    <button class="btn btn-outline-primary" @onclick="ExecuteReadyStepsAsync" disabled="@isExecuting" title="Exécute en une fois toutes les étapes actuellement prêtes et explicitement indépendantes (FR-023).">
                        Exécuter les étapes prêtes (parallèle)
                    </button>
                </div>
                @if (!string.IsNullOrEmpty(parallelExecutionMessage))
                {
                    <p class="text-muted text-sm">@parallelExecutionMessage</p>
                }
            }
            @if (run.Status == OperationRunStatus.Failed)
            {
                <button class="btn btn-outline-primary mb-3" @onclick="ResumeAsync" disabled="@isExecuting">
                    Reprendre depuis le dernier point de contrôle valide
                </button>
                <button class="btn btn-outline-warning mb-3 ms-2" @onclick="() => showOverrideForm = !showOverrideForm">
                    Contourner ce contrôle (FR-027)
                </button>
                @if (showOverrideForm)
                {
                    <div class="card p-3 mb-3">
                        <p class="text-muted text-sm">
                            Le contournement n'est possible que pour un contrôle déclaré contournable (politique
                            "Nécessite une décision manuelle"). Le motif et le risque accepté sont obligatoires et
                            resteront visibles dans le rapport et le journal d'audit.
                        </p>
                        <div class="mb-2">
                            <label class="form-label">Motif du contournement</label>
                            <textarea class="form-control" @bind="overrideReason"></textarea>
                        </div>
                        <div class="mb-2">
                            <label class="form-label">Risque accepté</label>
                            <textarea class="form-control" @bind="overrideAcceptedRisk"></textarea>
                        </div>
                        @if (run.IsProductionEnvironment)
                        {
                            <div class="mb-2">
                                <label class="form-label">Approbateur (Production — doit être distinct de vous)</label>
                                <input class="form-control" @bind="overrideApprovedByUserId" />
                            </div>
                        }
                        <button class="btn btn-warning btn-sm" @onclick="OverrideFailedStepAsync" disabled="@isExecuting">
                            Confirmer le contournement
                        </button>
                    </div>
                }
            }
        </Authorized>
    </AuthorizeView>

    <h2>Étapes</h2>
    <div class="table-responsive">
    <table class="table table-hover">
        <thead>
            <tr>
                <th>#</th>
                <th>Étape</th>
                <th>Action</th>
                <th>Composant</th>
                <th>Statut</th>
                <th>Résultat</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var step in run.StepExecutions)
            {
                <tr class="@StepRowClass(step.Status)">
                    <td>@(step.Position + 1)</td>
                    <td>@step.Name</td>
                    <td>@step.Action.ToLabel()</td>
                    <td>@(step.ComponentName ?? "—")</td>
                    <td>@StepStatusLabel(step.Status)</td>
                    <td>
                        @step.ResultMessage
                        @if (step.Status == OperationStepExecutionStatus.Overridden)
                        {
                            <div class="mt-1 text-sm text-amber-700">
                                <strong>Contourné</strong> par @step.OverriddenByUserId
                                @if (step.OverrideApprovedByUserId is not null)
                                {
                                    <text> — approuvé par @step.OverrideApprovedByUserId</text>
                                }
                                <br />Motif : @step.OverrideReason
                                <br />Risque accepté : @step.OverrideAcceptedRisk
                            </div>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}

@code {
    [Parameter]
    public Guid EnvironmentId { get; set; }

    [Parameter]
    public Guid OperationRunId { get; set; }

    [CascadingParameter]
    private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthStateTask { get; set; }

    private OperationRunDto? run;
    private string? errorMessage;
    private string? currentUserId;
    private bool isExecuting;
    private bool showRejectForm;
    private string rejectionReason = string.Empty;
    private bool showOverrideForm;
    private string overrideReason = string.Empty;
    private string overrideAcceptedRisk = string.Empty;
    private string overrideApprovedByUserId = string.Empty;
    private bool showCancelForm;
    private string cancelReason = string.Empty;
    private string? parallelExecutionMessage;

    protected override async Task OnParametersSetAsync()
    {
        if (AuthStateTask is not null)
        {
            currentUserId = (await AuthStateTask).User.Identity?.Name;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        run = await Mediator.Send(new GetOperationRunByIdQuery(OperationRunId));
    }

    private async Task ApproveAsync()
    {
        errorMessage = null;
        try
        {
            await Mediator.Send(new ApproveOperationRunCommand(OperationRunId, currentUserId ?? "inconnu"));
            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task RejectAsync()
    {
        errorMessage = null;
        try
        {
            await Mediator.Send(new RejectOperationRunCommand(OperationRunId, currentUserId ?? "inconnu", rejectionReason));
            showRejectForm = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private OperationStepExecutionDto? AwaitingConfirmationStep =>
        run?.StepExecutions.FirstOrDefault(s => s.Status == OperationStepExecutionStatus.AwaitingConfirmation);

    private async Task ExecuteNextStepAsync()
    {
        errorMessage = null;
        isExecuting = true;
        try
        {
            await Mediator.Send(new ExecuteNextOperationStepCommand(OperationRunId));
            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isExecuting = false;
        }
    }

    private async Task ExecuteReadyStepsAsync()
    {
        errorMessage = null;
        parallelExecutionMessage = null;
        isExecuting = true;
        try
        {
            var result = await Mediator.Send(new ExecuteReadyOperationStepsCommand(OperationRunId));
            parallelExecutionMessage = result.ExecutedCount switch
            {
                0 when result.AwaitingConfirmationCount > 0 => "Étape(s) sensible(s) en attente de confirmation — aucune exécutée automatiquement.",
                0 => "Aucune étape n'était prête à être exécutée (dépendances non satisfaites ou opération terminée).",
                1 => "1 étape exécutée.",
                _ => $"{result.ExecutedCount} étapes exécutées en parallèle (FR-023).",
            };
            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isExecuting = false;
        }
    }

    private async Task ConfirmStepAsync()
    {
        if (AwaitingConfirmationStep is not { } step)
        {
            return;
        }

        errorMessage = null;
        isExecuting = true;
        try
        {
            await Mediator.Send(new ConfirmOperationStepCommand(OperationRunId, step.StepId, currentUserId ?? "inconnu"));
            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isExecuting = false;
        }
    }

    private async Task ResumeAsync()
    {
        errorMessage = null;
        isExecuting = true;
        try
        {
            await Mediator.Send(new ResumeOperationRunCommand(OperationRunId));
            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isExecuting = false;
        }
    }

    private async Task OverrideFailedStepAsync()
    {
        errorMessage = null;
        isExecuting = true;
        try
        {
            await Mediator.Send(new OverrideFailedOperationStepCommand(
                OperationRunId, overrideReason, overrideAcceptedRisk, currentUserId ?? "inconnu",
                string.IsNullOrWhiteSpace(overrideApprovedByUserId) ? null : overrideApprovedByUserId));

            showOverrideForm = false;
            overrideReason = string.Empty;
            overrideAcceptedRisk = string.Empty;
            overrideApprovedByUserId = string.Empty;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isExecuting = false;
        }
    }

    private async Task CancelAsync()
    {
        errorMessage = null;
        isExecuting = true;
        try
        {
            await Mediator.Send(new CancelOperationRunCommand(OperationRunId, currentUserId ?? "inconnu", cancelReason));
            showCancelForm = false;
            cancelReason = string.Empty;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isExecuting = false;
        }
    }

    private async Task AcknowledgeReconciliationAsync()
    {
        errorMessage = null;
        isExecuting = true;
        try
        {
            await Mediator.Send(new AcknowledgeReconciliationCommand(OperationRunId, currentUserId ?? "inconnu"));
            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isExecuting = false;
        }
    }

    private static string StepRowClass(OperationStepExecutionStatus status) => status switch
    {
        OperationStepExecutionStatus.Succeeded => "table-success",
        OperationStepExecutionStatus.Failed => "table-danger",
        OperationStepExecutionStatus.Running => "table-info",
        OperationStepExecutionStatus.Skipped => "table-warning",
        OperationStepExecutionStatus.AwaitingConfirmation => "table-warning",
        OperationStepExecutionStatus.Overridden => "table-warning",
        OperationStepExecutionStatus.Cancelled => "table-secondary",
        _ => "",
    };

    private static string StepStatusLabel(OperationStepExecutionStatus status) => status switch
    {
        OperationStepExecutionStatus.Pending => "En attente",
        OperationStepExecutionStatus.AwaitingConfirmation => "Confirmation requise",
        OperationStepExecutionStatus.Running => "En cours",
        OperationStepExecutionStatus.Succeeded => "Réussie",
        OperationStepExecutionStatus.Failed => "Échouée",
        OperationStepExecutionStatus.Skipped => "Ignorée",
        OperationStepExecutionStatus.Overridden => "Contournée",
        OperationStepExecutionStatus.Cancelled => "Annulée",
        _ => "",
    };
}
