@page "/operations"
@attribute [Authorize]
@inject IMediator Mediator

<PageTitle>Historique des opérations - N4 Sentinel</PageTitle>

<h1>Historique des opérations</h1>
<p><a href="dashboard">← Retour au tableau de bord</a></p>
<p class="text-muted">Toutes les opérations, tous environnements confondus (E4.2).</p>

@if (indicators is not null && indicators.TotalOperations > 0)
{
    <div class="card p-3 mb-3">
        <h2 class="h5">Indicateurs (FR-094)</h2>
        <div class="row g-3">
            <div class="col-md-3">
                <div class="text-muted text-sm">Taux de réussite</div>
                <div class="h4 mb-0">@(indicators.SuccessRatePercent is { } rate ? $"{rate:0.#} %" : "—")</div>
            </div>
            <div class="col-md-3">
                <div class="text-muted text-sm">Durée moyenne</div>
                <div class="h4 mb-0">@(indicators.AverageDurationSeconds is { } avg ? FormatDuration(avg) : "—")</div>
            </div>
            <div class="col-md-3">
                <div class="text-muted text-sm">Terminées / Échouées / Annulées</div>
                <div class="h4 mb-0">@indicators.CompletedCount / @indicators.FailedCount / @indicators.CancelledCount</div>
            </div>
            <div class="col-md-3">
                <div class="text-muted text-sm">Total</div>
                <div class="h4 mb-0">@indicators.TotalOperations</div>
            </div>
        </div>

        @if (indicators.SlowestSteps.Count > 0)
        {
            <h3 class="h6 mt-3">Étapes les plus lentes</h3>
            <ul class="mb-0">
                @foreach (var step in indicators.SlowestSteps)
                {
                    <li>@step.StepName (@(step.ComponentName ?? "—")) — @FormatDuration(step.DurationSeconds)</li>
                }
            </ul>
        }

        @if (indicators.RecurringErrors.Count > 0)
        {
            <h3 class="h6 mt-3">Erreurs récurrentes</h3>
            <ul class="mb-0">
                @foreach (var error in indicators.RecurringErrors)
                {
                    <li>@error.StepName — "@error.Message" (@error.Occurrences occurrence(s))</li>
                }
            </ul>
        }
    </div>
}

@if (runs is null)
{
    <p><em>Chargement...</em></p>
}
else if (runs.Count == 0)
{
    <p>Aucune opération n'a encore été lancée.</p>
}
else
{
    <div class="table-responsive">
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Environnement</th>
                <th>Demandeur</th>
                <th>Demandée le</th>
                <th>Statut</th>
                <th>Terminée le</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var run in runs)
            {
                <tr>
                    <td>@run.EnvironmentName</td>
                    <td>@run.RequestedByUserId</td>
                    <td>@run.RequestedAtUtc.ToLocalTime().ToString("g")</td>
                    <td><span class="badge @run.Status.ToBadgeClass()">@run.Status.ToLabel()</span></td>
                    <td>@(run.CompletedAtUtc?.ToLocalTime().ToString("g"))</td>
                    <td><a class="btn btn-sm btn-outline-secondary" href="environments/@run.EnvironmentId/operations/@run.Id">Détail</a></td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}

@code {
    private IReadOnlyList<OperationRunSummaryDto>? runs;
    private OperationIndicatorsDto? indicators;

    protected override async Task OnInitializedAsync()
    {
        runs = await Mediator.Send(new ListAllOperationRunsQuery());
        indicators = await Mediator.Send(new GetOperationIndicatorsQuery(null));
    }

    private static string FormatDuration(double seconds) =>
        seconds < 60 ? $"{seconds:0} s" : $"{TimeSpan.FromSeconds(seconds):mm\\:ss}";
}
