@page "/admin/users"
@attribute [Authorize(Roles = Roles.Administrateur)]
@using System.Security.Claims
@inject IMediator Mediator

<PageTitle>Comptes - N4 Sentinel</PageTitle>

<h1>Gestion des comptes</h1>
<p class="text-muted">
    Attribution des rôles et verrouillage de compte (E11.1). Un Administrateur ne peut ni retirer son propre
    rôle Administrateur, ni verrouiller son propre compte, pour éviter un auto-blocage. Toute
    attribution/révocation de rôle est journalisée dans le journal d'audit (E11.3).
</p>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (users is null)
{
    <p><em>Chargement...</em></p>
}
else
{
    <div class="table-responsive">
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Compte</th>
                <th>Rôles</th>
                <th>Statut</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in users)
            {
                var isSelf = string.Equals(row.UserId, currentUserId, StringComparison.Ordinal);
                <tr>
                    <td>
                        @row.Email
                        @if (isSelf)
                        {
                            <span class="badge bg-secondary ms-2">Vous</span>
                        }
                    </td>
                    <td class="d-flex gap-2 flex-wrap">
                        @foreach (var role in Roles.All)
                        {
                            var isInRole = row.Roles.Contains(role);
                            var disableToggle = isSelf && role == Roles.Administrateur && isInRole;
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="@(row.UserId + "-" + role)"
                                       checked="@isInRole" disabled="@disableToggle"
                                       @onchange="e => ToggleRoleAsync(row.UserId, role, (bool)e.Value!)" />
                                <label class="form-check-label" for="@(row.UserId + "-" + role)">@role</label>
                            </div>
                        }
                    </td>
                    <td>
                        @if (row.IsLockedOut)
                        {
                            <span class="badge bg-danger">Verrouillé</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Actif</span>
                        }
                    </td>
                    <td>
                        @if (row.IsLockedOut)
                        {
                            <button class="btn btn-sm btn-outline-success" @onclick="() => UnlockAsync(row.UserId)">Déverrouiller</button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-danger" disabled="@isSelf" @onclick="() => LockAsync(row.UserId)">Verrouiller</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private IReadOnlyList<UserRoleInfoDto>? users;
    private string? currentUserId;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            currentUserId = (await AuthStateTask).User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        users = await Mediator.Send(new ListUsersQuery());
    }

    private async Task ToggleRoleAsync(string userId, string role, bool enabled)
    {
        errorMessage = null;
        try
        {
            if (enabled)
            {
                await Mediator.Send(new GrantRoleCommand(userId, role, currentUserId ?? "inconnu"));
            }
            else
            {
                await Mediator.Send(new RevokeRoleCommand(userId, role, currentUserId ?? "inconnu"));
            }

            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task LockAsync(string userId)
    {
        errorMessage = null;
        try
        {
            await Mediator.Send(new LockUserAccountCommand(userId, currentUserId ?? "inconnu"));
            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task UnlockAsync(string userId)
    {
        errorMessage = null;
        try
        {
            await Mediator.Send(new UnlockUserAccountCommand(userId, currentUserId ?? "inconnu"));
            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }
}
