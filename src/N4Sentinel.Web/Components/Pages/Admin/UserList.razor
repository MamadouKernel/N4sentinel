@page "/admin/users"
@attribute [Authorize(Roles = Roles.Administrateur)]
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager

<PageTitle>Comptes - N4 Sentinel</PageTitle>

<h1>Gestion des comptes</h1>
<p class="text-muted">
    Attribution des rôles et verrouillage de compte (E11.1). Un Administrateur ne peut ni retirer son propre
    rôle Administrateur, ni verrouiller son propre compte, pour éviter un auto-blocage.
</p>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (users is null)
{
    <p><em>Chargement...</em></p>
}
else
{
    <div class="table-responsive">
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Compte</th>
                <th>Rôles</th>
                <th>Statut</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in users)
            {
                var isSelf = string.Equals(row.User.Id, currentUserId, StringComparison.Ordinal);
                <tr>
                    <td>
                        @row.User.Email
                        @if (isSelf)
                        {
                            <span class="badge bg-secondary ms-2">Vous</span>
                        }
                    </td>
                    <td class="d-flex gap-2 flex-wrap">
                        @foreach (var role in Roles.All)
                        {
                            var isInRole = row.Roles.Contains(role);
                            var disableToggle = isSelf && role == Roles.Administrateur && isInRole;
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="@(row.User.Id + "-" + role)"
                                       checked="@isInRole" disabled="@disableToggle"
                                       @onchange="e => ToggleRoleAsync(row.User, role, (bool)e.Value!)" />
                                <label class="form-check-label" for="@(row.User.Id + "-" + role)">@role</label>
                            </div>
                        }
                    </td>
                    <td>
                        @if (row.IsLockedOut)
                        {
                            <span class="badge bg-danger">Verrouillé</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Actif</span>
                        }
                    </td>
                    <td>
                        @if (row.IsLockedOut)
                        {
                            <button class="btn btn-sm btn-outline-success" @onclick="() => UnlockAsync(row.User)">Déverrouiller</button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-danger" disabled="@isSelf" @onclick="() => LockAsync(row.User)">Verrouiller</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private List<UserRow>? users;
    private string? currentUserId;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            currentUserId = UserManager.GetUserId((await AuthStateTask).User);
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var all = UserManager.Users.OrderBy(u => u.Email).ToList();
        var rows = new List<UserRow>();
        foreach (var user in all)
        {
            var roles = await UserManager.GetRolesAsync(user);
            var isLockedOut = await UserManager.IsLockedOutAsync(user);
            rows.Add(new UserRow(user, roles.ToHashSet(), isLockedOut));
        }

        users = rows;
    }

    private async Task ToggleRoleAsync(ApplicationUser user, string role, bool enabled)
    {
        errorMessage = null;
        try
        {
            var isSelf = string.Equals(user.Id, currentUserId, StringComparison.Ordinal);
            if (isSelf && role == Roles.Administrateur && !enabled)
            {
                errorMessage = "Vous ne pouvez pas retirer votre propre rôle Administrateur.";
                return;
            }

            var result = enabled
                ? await UserManager.AddToRoleAsync(user, role)
                : await UserManager.RemoveFromRoleAsync(user, role);

            if (!result.Succeeded)
            {
                errorMessage = string.Join(", ", result.Errors.Select(e => e.Description));
                return;
            }

            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task LockAsync(ApplicationUser user)
    {
        errorMessage = null;
        try
        {
            if (string.Equals(user.Id, currentUserId, StringComparison.Ordinal))
            {
                errorMessage = "Vous ne pouvez pas verrouiller votre propre compte.";
                return;
            }

            await UserManager.SetLockoutEnabledAsync(user, true);
            var result = await UserManager.SetLockoutEndDateAsync(user, DateTimeOffset.MaxValue);
            if (!result.Succeeded)
            {
                errorMessage = string.Join(", ", result.Errors.Select(e => e.Description));
                return;
            }

            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task UnlockAsync(ApplicationUser user)
    {
        errorMessage = null;
        try
        {
            var result = await UserManager.SetLockoutEndDateAsync(user, null);
            if (!result.Succeeded)
            {
                errorMessage = string.Join(", ", result.Errors.Select(e => e.Description));
                return;
            }

            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private sealed record UserRow(ApplicationUser User, HashSet<string> Roles, bool IsLockedOut);
}
