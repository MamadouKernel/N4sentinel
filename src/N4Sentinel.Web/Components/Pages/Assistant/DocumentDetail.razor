@page "/admin/documents/{DocumentId:guid}"
@attribute [Authorize(Roles = Roles.Administrateur)]
@inject ISender Mediator
@inject NavigationManager NavigationManager

<PageTitle>Document - N4 Sentinel</PageTitle>

@if (document is null)
{
    <div class="card p-8 text-center text-slate-500">Chargement...</div>
}
else
{
    <div class="space-y-6">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">
                @document.DocumentKey
                <span class="badge bg-slate-100 text-slate-800">v@(document.VersionNumber)</span>
                <span class="badge @StatusBadgeClass(document.Status)">@document.Status.ToLabel()</span>
            </h1>
            <a href="/admin/documents" class="text-sm text-slate-500 hover:text-slate-700">← Retour aux documents</a>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="rounded-md bg-rose-50 p-4 text-sm font-medium text-rose-800 border border-rose-200">@errorMessage</div>
        }

        @if (document.Status == DocumentStatus.Draft)
        {
            <EditForm Model="editModel" OnValidSubmit="SaveAsync" FormName="EditDocument" class="card space-y-4 p-6">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" />

                <div>
                    <label class="block text-sm font-medium text-slate-700">Titre</label>
                    <InputText @bind-Value="editModel.Title" class="form-input mt-1 w-full" />
                </div>
                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                    <div>
                        <label class="block text-sm font-medium text-slate-700">Catégorie</label>
                        <InputSelect @bind-Value="editModel.Category" class="form-select mt-1 w-full">
                            @foreach (var c in Enum.GetValues<DocumentSourceCategory>())
                            {
                                <option value="@c">@c.ToLabel()</option>
                            }
                        </InputSelect>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-slate-700">Version N4</label>
                        <InputText @bind-Value="editModel.N4Version" class="form-input mt-1 w-full" />
                    </div>
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700">Contenu</label>
                    <InputTextArea @bind-Value="editModel.Content" rows="10" class="form-input mt-1 w-full font-mono text-xs" />
                </div>

                <div class="flex gap-2 pt-2 border-t border-slate-200">
                    <button type="submit" class="btn btn-primary btn-sm">Enregistrer</button>
                    <button type="button" class="btn btn-success btn-sm" @onclick="SubmitForValidationAsync">Soumettre pour validation</button>
                </div>
            </EditForm>
        }
        else
        {
            <div class="card p-6 space-y-3">
                <dl class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                    <div><dt class="text-xs font-semibold uppercase text-slate-500">Titre</dt><dd class="text-sm text-slate-900">@document.Title</dd></div>
                    <div><dt class="text-xs font-semibold uppercase text-slate-500">Catégorie</dt><dd class="text-sm text-slate-900">@document.Category.ToLabel()</dd></div>
                    <div><dt class="text-xs font-semibold uppercase text-slate-500">Version N4</dt><dd class="text-sm text-slate-900">@(document.N4Version ?? "—")</dd></div>
                    <div><dt class="text-xs font-semibold uppercase text-slate-500">Indexé</dt><dd class="text-sm text-slate-900">@(document.IsIndexed ? "Oui" : "Non")</dd></div>
                </dl>
                <div>
                    <dt class="text-xs font-semibold uppercase text-slate-500">Contenu</dt>
                    <pre class="mt-1 text-xs bg-slate-50 p-3 rounded border border-slate-200 whitespace-pre-wrap">@document.Content</pre>
                </div>

                <div class="flex gap-2 pt-2 border-t border-slate-200">
                    @if (document.Status == DocumentStatus.PendingValidation)
                    {
                        <button class="btn btn-success btn-sm" @onclick="ValidateAsync">Valider</button>
                    }
                    @if (document.Status == DocumentStatus.Validated)
                    {
                        <button class="btn btn-success btn-sm" @onclick="ActivateAsync">Publier (Actif)</button>
                    }
                    @if (document.Status is DocumentStatus.Active or DocumentStatus.Validated)
                    {
                        <button class="btn btn-outline-danger btn-sm" @onclick="DisableAsync">Désactiver</button>
                    }
                    <button class="btn btn-outline-secondary btn-sm" @onclick="CreateNewVersionAsync">Nouvelle version</button>
                </div>
            </div>
        }

        <h2 class="text-lg font-bold text-slate-900">Historique des versions</h2>
        @if (versions is null)
        {
            <div class="card p-6 text-center text-slate-500">Chargement...</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th class="px-4 py-3">Version</th>
                            <th class="px-4 py-3">Statut</th>
                            <th class="px-4 py-3">Créée le</th>
                            <th class="px-4 py-3 text-right">Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-200">
                        @foreach (var v in versions)
                        {
                            <tr class="@(v.Id == document.Id ? "bg-brand-50/60" : "")">
                                <td class="px-4 py-3">v@(v.VersionNumber)</td>
                                <td class="px-4 py-3">@v.Status.ToLabel()</td>
                                <td class="px-4 py-3">@v.CreatedAtUtc.ToLocalTime().ToString("g")</td>
                                <td class="px-4 py-3 text-right"><a href="/admin/documents/@v.Id" class="btn btn-outline-secondary btn-sm">Détail</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

@code {
    [Parameter] public Guid DocumentId { get; set; }

    private DocumentDto? document;
    private IReadOnlyList<DocumentDto>? versions;
    private EditModel editModel = new();
    private string? errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        document = await Mediator.Send(new GetDocumentByIdQuery(DocumentId));
        if (document is null)
        {
            return;
        }

        versions = await Mediator.Send(new ListDocumentVersionsQuery(document.DocumentKey));
        editModel = new EditModel
        {
            Title = document.Title,
            Category = document.Category,
            N4Version = document.N4Version,
            Content = document.Content,
        };
    }

    private async Task SaveAsync()
    {
        errorMessage = null;
        try
        {
            await Mediator.Send(new UpdateDocumentCommand(DocumentId, editModel.Title, editModel.Category, editModel.N4Version, editModel.Content));
            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private Task SubmitForValidationAsync() => RunAsync(() => Mediator.Send(new SubmitDocumentForValidationCommand(DocumentId)));

    private Task ValidateAsync() => RunAsync(() => Mediator.Send(new ValidateDocumentCommand(DocumentId)));

    private Task ActivateAsync() => RunAsync(() => Mediator.Send(new ActivateDocumentCommand(DocumentId)));

    private Task DisableAsync() => RunAsync(() => Mediator.Send(new DisableDocumentCommand(DocumentId)));

    private async Task CreateNewVersionAsync()
    {
        errorMessage = null;
        try
        {
            var newId = await Mediator.Send(new CreateNewDocumentVersionCommand(DocumentId));
            NavigationManager.NavigateTo($"/admin/documents/{newId}");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task RunAsync(Func<Task> action)
    {
        errorMessage = null;
        try
        {
            await action();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private static string StatusBadgeClass(DocumentStatus status) => status switch
    {
        DocumentStatus.Draft => "bg-slate-100 text-slate-800",
        DocumentStatus.PendingValidation => "bg-amber-100 text-amber-800",
        DocumentStatus.Validated => "bg-blue-100 text-blue-800",
        DocumentStatus.Active => "bg-emerald-100 text-emerald-800",
        DocumentStatus.Disabled => "bg-slate-800 text-white",
        _ => "bg-slate-100 text-slate-800",
    };

    private sealed class EditModel
    {
        [Required] public string Title { get; set; } = string.Empty;
        public DocumentSourceCategory Category { get; set; }
        public string? N4Version { get; set; }
        [Required] public string Content { get; set; } = string.Empty;
    }
}
