@page "/environments/{EnvironmentId:guid}/edi/new"
@attribute [Authorize(Roles = Roles.Administrateur)]
@inject IMediator Mediator
@inject NavigationManager NavigationManager

<PageTitle>Nouveau fichier EDI - N4 Sentinel</PageTitle>

<h1>Enregistrer un fichier EDI reçu</h1>

<EditForm Model="model" OnValidSubmit="SubmitAsync" FormName="CreateEdiFile">
    <DataAnnotationsValidator />
    <ValidationSummary class="text-danger" />

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <div class="mb-3">
        <label class="form-label" for="messageType">Type de message</label>
        <InputText id="messageType" class="form-control" @bind-Value="model.MessageType" placeholder="ex. BAPLIE, COPRAR..." />
    </div>

    <div class="mb-3">
        <label class="form-label" for="partnerName">Partenaire</label>
        <InputText id="partnerName" class="form-control" @bind-Value="model.PartnerName" placeholder="ex. Armateur X" />
    </div>

    <button type="submit" class="btn btn-primary">Enregistrer</button>
    <a class="btn btn-secondary" href="environments/@EnvironmentId/edi">Annuler</a>
</EditForm>

@code {
    [Parameter]
    public Guid EnvironmentId { get; set; }

    private readonly CreateEdiFileModel model = new();
    private string? errorMessage;

    private async Task SubmitAsync()
    {
        errorMessage = null;
        try
        {
            await Mediator.Send(new RecordEdiFileReceivedCommand(EnvironmentId, model.MessageType, model.PartnerName));
            NavigationManager.NavigateTo($"environments/{EnvironmentId}/edi");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private sealed class CreateEdiFileModel
    {
        [Required(ErrorMessage = "Le type de message est obligatoire.")]
        public string MessageType { get; set; } = string.Empty;

        [Required(ErrorMessage = "Le partenaire est obligatoire.")]
        public string PartnerName { get; set; } = string.Empty;
    }
}
