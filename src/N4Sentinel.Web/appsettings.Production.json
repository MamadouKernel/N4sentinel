{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5000"
      }
    }
  },
  "Serilog": {
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "MSSqlServer",
        "Args": {
          "connectionString": "DefaultConnection",
          "tableName": "ApplicationLogs",
          "autoCreateSqlTable": true,
          "restrictedToMinimumLevel": "Information"
        }
      },
      {
        "Name": "EventLog",
        "Args": {
          "source": "N4Sentinel",
          "logName": "Application",
          "manageEventSource": true,
          "restrictedToMinimumLevel": "Warning"
        }
      }
    ]
  }
}
