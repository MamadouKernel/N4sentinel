{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // SEC-001 — écart assumé, développement uniquement : l'application refuse de démarrer
  // avec ce réglage à true dans tout autre environnement. Les connexions ainsi obtenues
  // sont tracées comme « Second facteur contourné » dans le journal d'audit.
  "Authentification": {
    "SecondFacteurDesactive": true
  },

  // Port HTTPS du profil de lancement local : sans lui, la redirection viserait le port 443.
  "Securite": {
    "PortHttps": 7294
  },

  "ChainesDeConnexion": {
    // Instance SQL Server locale par défaut, authentification Windows. La base « n4sentinel »
    // est propre au produit v2 : la base « N4Sentinel » de la version précédente reste sur ce
    // poste et ne doit être ni écrite ni remplacée.
    //
    // Le développement tournait sur LocalDB jusqu'ici ; l'instance complète est plus proche de
    // la cible — même moteur, mêmes droits Windows, même comportement sur les migrations.
    // Les migrations sont appliquées au démarrage par l'amorçage : une base vide suffit.
    "BaseApplicative": "Server=.;Database=n4sentinel;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },

  // Le compte d'amorçage n'est jamais renseigné ici : ce fichier est versionné.
  // En développement, poser les deux valeurs par secrets utilisateur ou variables
  // d'environnement avant le premier démarrage :
  //   dotnet user-secrets set "Amorcage:EmailAdministrateur" "prenom.nom@citcotedivoire.com"
  //   dotnet user-secrets set "Amorcage:MotDePasseAdministrateur" "<mot de passe fort>"
  "Amorcage": {
    "EmailAdministrateur": "",
    "MotDePasseAdministrateur": ""
  }
}
