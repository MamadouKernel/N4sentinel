<Project>

  <!--
    Réglages communs à tous les projets. Les avertissements sont traités comme des erreurs :
    sur un socle destiné à vivre vingt-cinq sprints, un avertissement toléré une fois ne
    disparaît jamais.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <NeutralLanguage>fr-FR</NeutralLanguage>
  </PropertyGroup>

  <!--
    Audit des dépendances à la génération. Combiné à TreatWarningsAsErrors, un avis de sécurité
    publié sur une dépendance — directe ou transitive, quelle que soit sa gravité — casse la
    build au lieu d'ajouter un avertissement de plus que personne ne lit.
  -->
  <PropertyGroup>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
  </PropertyGroup>

</Project>
